{% extends 'security/base_auth.html.twig' %}

{% block title %}Login - Hirely{% endblock %}

{% block body %}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2>Hirely</h2>
            <p>Welcome back. Sign in with your password, Google, or Face ID.</p>
        </div>

        <div class="flash-list">
            {% for message in app.flashes('success') %}
                <div class="flash flash-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash flash-error">{{ message }}</div>
            {% endfor %}
        </div>

        <form method="post" novalidate>
            {% if error %}
                <div class="error">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="logged-in">
                    Logged in as {{ app.user.userIdentifier }}
                    <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}

            <div class="form-group">
                <label>Email</label>
                <input type="email"
                       name="email"
                       value="{{ last_username }}"
                       required
                       autofocus
                       class="form-input"
                       placeholder="Enter your email">
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password"
                       name="password"
                       required
                       class="form-input"
                       placeholder="Enter your password">
            </div>

            <input type="hidden"
                   name="_csrf_token"
                   value="{{ csrf_token('authenticate') }}">

            <div class="login-options">
                <label>
                    <input type="checkbox" name="_remember_me"> Remember me
                </label>
            </div>

            <button class="btn btn-primary login-btn">
                Sign in
            </button>

            <div class="divider">or continue with</div>

            <a href="{{ path('app_google_connect') }}" class="btn btn-google login-btn">
                <span>Google</span>
            </a>

            <div class="auth-panel" data-face-login data-login-url="{{ path('app_face_auth_login') }}" data-csrf="{{ csrf_token('face_login') }}">
                <h3>Face ID Sign-In</h3>
                <p>Enter your email, open the camera, then verify your face to continue.</p>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email"
                           class="form-input"
                           data-face-email
                           placeholder="Enter your email for Face ID">
                </div>

                <div class="camera-frame">
                    <video playsinline muted></video>
                </div>

                <div class="row-actions">
                    <button type="button" class="btn btn-secondary" data-face-start>Open Camera</button>
                    <button type="button" class="btn btn-primary" data-face-verify>Verify Face</button>
                </div>

                <div class="status-text" data-face-status></div>
            </div>

            <div class="signup-section">
                <p>Don't have an account?</p>

                <a href="{{ path('app_register') }}" class="btn btn-secondary signup-btn">
                    Create Account
                </a>
            </div>
        </form>
    </div>
</div>

<script src="{{ asset('js/face-auth.js') }}"></script>

{% endblock %}
