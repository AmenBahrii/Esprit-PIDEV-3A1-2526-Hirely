                <div>
                    <h2 style="margin: 0; font-size: 22px; font-weight: 800; color: #fff;">Hirely</h2>
                    <div style="font-size: 12px; color: rgba(255, 255, 255, 0.62);">Workspace</div>
                </div>
            </div>

            <div class="admin-panel" style="margin-bottom: 24px;">
                <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: rgba(255,255,255,0.56); margin-bottom: 6px;">Signed in as</div>
                <div style="font-size: 15px; font-weight: 800; color: #fff;">{{ app.user.firstName }} {{ app.user.lastName }}</div>
