{% set currentRoute = app.request.attributes.get('_route') ?? '' %}
{% set forumStyledRoute = currentRoute starts with 'forum_' or currentRoute starts with 'notification_' or currentRoute starts with 'profile_' or currentRoute starts with 'admin_forum_' %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Hirely{% endblock %}</title>

    <style>
:root {
    /* New design system from css/hirely.css */
    --hirely-orange: #ff5c28;
    --hirely-orange-soft: #f17945;
    --hirely-purple: #231e53;
    --hirely-plum: #3f1244;
    --hirely-bg: #f7f5fb;
    --hirely-surface: #ffffff;
    --hirely-text: #1f2430;
    --hirely-title: #231e53;
    --hirely-muted: #7b8496;
    --hirely-border: #ece7f6;
    --hirely-dark-gradient: linear-gradient(135deg, #3f1244 0%, #231e53 100%);
    --hirely-light-gradient: linear-gradient(135deg, #f17945 0%, #ff5c28 100%);
    --hirely-shadow: 0 10px 30px rgba(35, 30, 83, 0.08);
    --hirely-shadow-strong: 0 14px 28px rgba(255, 92, 40, 0.24);

    /* Map old variables to new ones for compatibility */
    --ink: var(--hirely-title);
    --muted: var(--hirely-muted);
    --line: var(--hirely-border);
    --surface: var(--hirely-surface);
    --soft: rgba(255, 255, 255, 0.62);
    --soft-strong: #eeecff;
    --accent: var(--hirely-orange);
    --accent-dark: var(--hirely-orange-soft);
    --green: #2a9352;
    --green-dark: var(--hirely-purple);
    --green-soft: #dff5e6;
    --red: #d64545;
    --red-soft: #ffe7e7;
    --amber: #b7791f;
    --amber-soft: #fff1d8;
    --shadow: var(--hirely-shadow);
    --shadow-soft: var(--hirely-shadow);
}

* {
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
    margin: 0;
}

body {
    font-family: Poppins, "Segoe UI", Arial, sans-serif;
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.08), transparent 32%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.1), transparent 36%),
        linear-gradient(135deg, #f7f5fb 0%, #f3f0fa 50%, #f7f5fb 100%);
    color: var(--ink);
    transition: background 0.25s ease, color 0.25s ease;
}

a {
    color: inherit;
}

.container {
    display: flex;
    min-height: 100vh;
    align-items: stretch;
    gap: 28px;
    padding: 24px;
}

.sidebar {
    width: 292px;
    flex: 0 0 292px;
    color: #fff;
    padding: 26px 18px;
    min-height: calc(100vh - 48px);
    position: sticky;
    top: 24px;
    display: flex;
    flex-direction: column;
    border-radius: 34px;
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.22), transparent 26%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.16), transparent 34%),
        linear-gradient(180deg, rgba(41, 25, 89, 0.98), rgba(27, 20, 67, 0.98));
    box-shadow: 18px 0 40px rgba(35, 30, 83, 0.16);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    animation: slideIn 0.45s ease both;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    padding: 10px 8px;
    font-size: 24px;
    letter-spacing: 0;
}

.logo-img {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    object-fit: cover;
    background: #fff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
}

.sidebar a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 11px 12px;
    margin-bottom: 8px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.sidebar a:hover,
.sidebar a.active {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    transform: translateX(4px);
}

.sidebar a.active {
    box-shadow: inset 3px 0 0 var(--accent);
}

.main {
    flex: 1;
    min-width: 0;
    padding: 0 0 28px;
    animation: fadeUp 0.45s ease both;
}

.workspace-shell {
    width: 100%;
    max-width: 1420px;
    margin: 0 auto;
}

.workspace-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding: 22px 24px;
    margin-bottom: 22px;
    border: 1px solid rgba(124, 58, 237, 0.12);
    border-radius: 30px;
    background:
        linear-gradient(135deg, rgba(255,255,255,0.96), rgba(243,240,250,0.92));
    backdrop-filter: blur(18px);
    box-shadow: 0 16px 36px rgba(35, 30, 83, 0.08);
}

.workspace-topbar-copy {
    max-width: 620px;
}

.workspace-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.workspace-eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ff7f5c;
    box-shadow: 0 0 0 5px rgba(255, 127, 92, 0.12);
}

.workspace-title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
}

.workspace-subtitle {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 16px;
}

.workspace-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    flex-wrap: wrap;
}

.workspace-select,
.workspace-profile,
.workspace-logout,
.workspace-nav-link {
    border: 1px solid rgba(236, 231, 246, 0.92);
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-soft);
}

.workspace-select {
    min-width: 160px;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 18px;
    color: var(--green-dark);
    font: inherit;
    font-weight: 600;
}

.workspace-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-radius: 20px;
    text-decoration: none;
}

.workspace-profile-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.workspace-role-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 107, 53, 0.12);
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.workspace-profile-name {
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
}

.workspace-logout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 18px;
    color: var(--green-dark);
    font-weight: 700;
    text-decoration: none;
}

.workspace-nav {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.workspace-nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    color: var(--green-dark);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.workspace-nav-link:hover {
    transform: translateY(-2px);
}

.workspace-nav-link.active {
    border-color: rgba(255, 92, 40, 0.22);
    background: linear-gradient(135deg, rgba(255, 92, 40, 0.14), rgba(241, 121, 69, 0.08));
    color: var(--green-dark);
}

.workspace-nav-link.disabled {
    opacity: 0.55;
    cursor: default;
}

.workspace-page {
    display: grid;
    gap: 26px;
}

.workspace-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.workspace-hero {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    padding: 34px;
    border: 1px solid rgba(236, 231, 246, 0.92);
    border-radius: 32px;
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.14), transparent 26%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.08), transparent 30%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(249, 247, 255, 0.98));
    box-shadow: var(--shadow);
}

.workspace-hero-copy {
    max-width: 780px;
}

.workspace-kicker {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.workspace-section-title {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
}

.workspace-section-copy {
    margin: 12px 0 0;
    color: #6e6b8f;
    font-size: 16px;
}

.workspace-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 18px 20px;
    border: 1px solid rgba(236, 231, 246, 0.92);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.84);
    box-shadow: var(--shadow-soft);
}

.workspace-toolbar-copy {
    display: grid;
    gap: 4px;
}

.workspace-toolbar-label {
    color: var(--accent);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.workspace-toolbar-subtitle {
    color: #787596;
    font-size: 15px;
}

.workspace-toolbar-controls {
    display: flex;
    gap: 12px;
    width: 100%;
    justify-content: flex-end;
}

.workspace-metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.workspace-card {
    padding: 26px;
    border: 1px solid rgba(124, 58, 237, 0.1);
    border-radius: 26px;
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.08), transparent 36%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.05), transparent 40%),
        linear-gradient(180deg, #ffffff 0%, #faf8ff 100%);
    box-shadow: 0 10px 30px rgba(35, 30, 83, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.workspace-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(35, 30, 83, 0.13);
}

.workspace-card-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 18px;
}

.workspace-card-summary {
    margin: 12px 0 0;
    color: #7d7a99;
}

.workspace-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.workspace-meta {
    padding: 16px 18px;
    border: 1px solid rgba(236, 231, 246, 0.92);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 246, 255, 0.94));
}

.workspace-meta-label {
    display: block;
    margin-bottom: 8px;
    color: #9b99b6;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.workspace-meta-value {
    color: var(--green-dark);
    font-size: 15px;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.workspace-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.admin-shell {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
}

.admin-sidebar {
    width: 292px;
    flex: 0 0 292px;
    min-height: calc(100vh - 48px);
    padding: 26px 18px;
    border-radius: 34px;
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.22), transparent 26%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.16), transparent 34%),
        linear-gradient(180deg, rgba(41, 25, 89, 0.98), rgba(27, 20, 67, 0.98));
    color: #fff;
    box-shadow: 18px 0 40px rgba(35, 30, 83, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.admin-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
    padding: 6px 4px 2px;
}

.admin-panel {
    margin-bottom: 24px;
    padding: 18px 18px 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.08));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 18px 30px rgba(10, 8, 28, 0.16);
}

.admin-nav-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 18px;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    border: 1px solid transparent;
}

.admin-nav-link:hover {
    transform: translateX(3px);
    background: rgba(255, 255, 255, 0.08);
}

.admin-nav-link.active {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.16), rgba(121, 103, 255, 0.16));
    border-color: rgba(255, 255, 255, 0.08);
    position: relative;
    padding-left: 20px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

.admin-nav-link.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 4px;
    border-radius: 999px;
    background: var(--hirely-light-gradient);
}

.admin-nav-link.disabled {
    opacity: 0.58;
    cursor: default;
    pointer-events: none;
}

.admin-topbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 20px;
    padding: 20px 22px;
    margin-bottom: 22px;
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.72);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.64);
    box-shadow: 0 16px 36px rgba(35, 30, 83, 0.08);
}

.admin-topbar-title {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1.1;
    font-weight: 800;
    color: var(--hirely-title);
}

.admin-metric-card {
    min-height: 120px;
    padding: 22px;
    border: 1px solid var(--hirely-border);
    border-radius: 22px;
    background: var(--hirely-surface);
    box-shadow: var(--hirely-shadow);
    position: relative;
    overflow: hidden;
}

.admin-metric-card::after {
    content: "";
    position: absolute;
    right: -20px;
    top: -20px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255, 92, 40, 0.14), rgba(241, 121, 69, 0.04));
}

.top-nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
}

.profile-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
}

.profile-box {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 52px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.profile-box:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 107, 53, 0.35);
    box-shadow: var(--shadow);
}

.profile-img,
.profile-placeholder,
.user-avatar,
.user-avatar-placeholder,
.avatar-small {
    width: 42px;
    height: 42px;
    border-radius: 50%;
}

.profile-img,
.user-avatar,
.avatar-small {
    object-fit: cover;
}

.profile-placeholder,
.user-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    font-weight: 800;
}

.profile-name,
.user-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--ink);
}

.profile-role,
.user-email {
    color: var(--muted);
    font-size: 12px;
}

.logout-btn {
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--red);
    background: var(--red-soft);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease;
}

.logout-btn:hover {
    transform: translateY(-2px);
    background: #ffd6d6;
}

.header {
    font-size: 28px;
    font-weight: 850;
    letter-spacing: 0;
}

.sub-header {
    color: var(--muted);
    margin: 6px 0 20px;
}

.card,
.settings-card,
.login-card {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(221, 230, 225, 0.9);
    border-radius: 8px;
    box-shadow: var(--shadow);
}

.card {
    padding: 24px;
    margin-top: 20px;
    animation: fadeUp 0.45s ease both;
}

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
}

.top-bar h3 {
    margin: 0;
    font-size: 20px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 9px 14px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 10px 22px rgba(255, 107, 53, 0.24);
}

.btn-primary:hover {
    background: var(--accent-dark);
}

.btn-secondary {
    background: var(--soft-strong);
    color: var(--green-dark);
}

.btn-edit,
.btn-view {
    background: #edf3ff;
    color: #3658a8;
}

.btn-delete,
.btn-danger {
    background: var(--red-soft);
    color: var(--red);
}

.btn-success,
.btn-tasks {
    background: var(--green-soft);
    color: var(--green);
}

.big-btn {
    min-height: 46px;
    padding: 12px 18px;
    font-size: 15px;
}

.filters,
.filter-form {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
}

.search-input,
.sort-select,
.form-input {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-input {
    flex: 1;
}

.sort-select {
    width: auto;
}

.search-input:focus,
.sort-select:focus,
.form-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.16);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
}

.form-group.full {
    grid-column: span 2;
}

.form-error,
.form-error ul,
.form-group ul {
    color: var(--red);
    font-size: 12px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
}

.status,
.status-pill,
.role-badge,
.dashboard-pill {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
}

.status-accepted,
.status-open,
.status-pill {
    background: var(--green-soft);
    color: var(--green);
}

.status-pending {
    background: var(--amber-soft);
    color: var(--amber);
}

.status-rejected,
.status-closed {
    background: var(--red-soft);
    color: var(--red);
}

.role-badge,
.dashboard-pill {
    background: var(--soft-strong);
    color: var(--green-dark);
}

.role-admin {
    background: var(--red-soft);
    color: var(--red);
}

.role-recruiter {
    background: #edf3ff;
    color: #3658a8;
}

.role-candidate {
    background: var(--green-soft);
    color: var(--green);
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 18px;
}

.data-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 8px 20px rgba(32, 33, 36, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    animation: fadeUp 0.45s ease both;
}

.data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(29, 107, 86, 0.3);
    box-shadow: var(--shadow-soft);
}

.data-card-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
}

.data-card-title {
    margin: 0;
    font-size: 18px;
    color: var(--ink);
}

.data-card-subtitle,
.data-card-label {
    color: var(--muted);
    font-size: 12px;
}

.data-card-subtitle {
    margin-top: 4px;
}

.data-card-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.data-card-field {
    min-width: 0;
}

.data-card-label {
    display: block;
    margin-bottom: 3px;
    font-weight: 700;
}

.data-card-value {
    color: var(--ink);
    font-size: 14px;
    overflow-wrap: anywhere;
}

.data-card-actions,
.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
}

.empty-state {
    background: var(--soft);
    border: 1px dashed var(--line);
    border-radius: 8px;
    padding: 22px;
    color: var(--muted);
    text-align: center;
}

table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px;
}

th {
    text-align: left;
    color: var(--muted);
    font-size: 13px;
}

td {
    background: #fff;
    padding: 16px;
    font-size: 14px;
}

tbody tr:hover td {
    background: var(--soft);
}

tr td:first-child {
    border-radius: 8px 0 0 8px;
}

tr td:last-child {
    border-radius: 0 8px 8px 0;
}

.profile-section {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 24px;
}

.profile-big,
.profile-placeholder-big {
    width: 80px;
    height: 80px;
    border-radius: 50%;
}

.profile-big {
    object-fit: cover;
}

.profile-placeholder-big {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--soft-strong);
    color: var(--green-dark);
    font-weight: 800;
    font-size: 20px;
}

.profile-info h2 {
    margin: 0;
}

.form-section {
    margin-bottom: 24px;
}

.form-section h4 {
    margin-bottom: 10px;
    color: var(--muted);
}

.form-actions {
    margin-top: 20px;
}

.settings-wrapper {
    width: 100%;
    min-height: 100vh;
    padding: 40px 20px;
}

.settings-card {
    width: 100%;
    padding: 28px;
}

.login-container {
    min-height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        linear-gradient(135deg, rgba(29, 107, 86, 0.2), transparent 40%),
        #f6f8f7;
}

.login-card {
    width: 360px;
    padding: 34px;
}

.login-header {
    text-align: center;
    margin-bottom: 24px;
}

.login-header h2 {
    margin: 0;
    color: var(--green-dark);
}

.login-header p {
    color: var(--muted);
    font-size: 14px;
}

.login-btn {
    width: 100%;
    margin-top: 10px;
}

.login-options {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 10px;
}

.error {
    background: var(--red-soft);
    color: var(--red);
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 15px;
}

.logged-in {
    font-size: 13px;
    margin-bottom: 10px;
}

.page-flashes {
    display: grid;
    gap: 12px;
    margin-bottom: 18px;
}

.page-flash {
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: var(--shadow-soft);
}

.page-flash-success {
    background: var(--green-soft);
    color: var(--green);
}

.page-flash-error {
    background: var(--red-soft);
    color: var(--red);
}

.theme-toggle,
.notification-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.76);
    color: var(--green-dark);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--shadow-soft);
}

.theme-toggle {
    min-width: 108px;
}

.theme-toggle-label-dark {
    opacity: 0.45;
}

.top-nav-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.notification-wrap {
    position: relative;
}

.notification-toggle {
    position: relative;
}

.notification-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    min-height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
}

.notification-menu {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: min(360px, 92vw);
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 24px 52px rgba(64, 51, 116, 0.16);
    backdrop-filter: blur(16px);
    z-index: 30;
}

.notification-menu-head,
.notification-menu-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.notification-menu-head {
    margin-bottom: 12px;
}

.notification-menu-head h3 {
    margin: 0;
    font-size: 16px;
}

.notification-list {
    display: grid;
    gap: 10px;
    max-height: 320px;
    overflow-y: auto;
    margin-bottom: 12px;
}

.notification-item,
.notification-empty {
    display: flex;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 18px;
    text-decoration: none;
    background: rgba(238, 236, 255, 0.42);
}

.notification-item.is-unread {
    background: rgba(255, 107, 53, 0.08);
}

.notification-item-dot {
    width: 8px;
    height: 8px;
    margin-top: 7px;
    border-radius: 999px;
    flex: 0 0 auto;
    background: var(--accent);
}

.notification-content {
    display: grid;
    gap: 4px;
}

.notification-message {
    font-size: 14px;
    font-weight: 600;
}

.notification-time {
    color: var(--muted);
    font-size: 12px;
}

.notification-text-link {
    border: none;
    background: transparent;
    padding: 0;
    color: var(--accent);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
}

body[data-theme='dark'] {
    --hirely-bg: #12102e;
    --hirely-surface: #1b1642;
    --hirely-text: #f0f2ff;
    --hirely-title: #ffffff;
    --hirely-muted: #a4adca;
    --hirely-border: rgba(255, 255, 255, 0.08);
    --hirely-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);

    --ink: var(--hirely-title);
    --muted: var(--hirely-muted);
    --line: var(--hirely-border);
    --surface: var(--hirely-surface);
    --soft: rgba(27, 22, 66, 0.72);
    --soft-strong: #251e58;
    --green-dark: #ffffff;
    --shadow: var(--hirely-shadow);
    --shadow-soft: 0 12px 30px rgba(0, 0, 0, 0.32);

    background:
        radial-gradient(circle at top left, rgba(255, 92, 40, 0.12), transparent 32%),
        radial-gradient(circle at top right, rgba(124, 58, 237, 0.14), transparent 34%),
        linear-gradient(135deg, #1b1642 0%, #12102e 52%, #1b1642 100%);
    color: var(--ink);
}

body[data-theme='dark'] .sidebar-shell,
body[data-theme='dark'] .sidebar,
body[data-theme='dark'] .admin-sidebar {
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.22), transparent 26%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.16), transparent 34%),
        linear-gradient(180deg, rgba(41, 25, 89, 0.98), rgba(27, 20, 67, 0.98));
    border-color: rgba(255, 255, 255, 0.12);
}

body[data-theme='light'] .sidebar,
body[data-theme='light'] .sidebar-shell,
body[data-theme='light'] .admin-sidebar {
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.22), transparent 26%),
        radial-gradient(circle at bottom left, rgba(124, 58, 237, 0.16), transparent 34%),
        linear-gradient(180deg, rgba(41, 25, 89, 0.98), rgba(27, 20, 67, 0.98));
    border-color: rgba(255, 255, 255, 0.12);
}

body[data-theme='dark'] .workspace-topbar,
body[data-theme='dark'] .workspace-hero,
body[data-theme='dark'] .workspace-toolbar,
body[data-theme='dark'] .workspace-card,
body[data-theme='dark'] .admin-topbar,
body[data-theme='dark'] .admin-panel,
body[data-theme='dark'] .forum-toolbar-card,
body[data-theme='dark'] .forum-post-card,
body[data-theme='dark'] .forum-comment-card,
body[data-theme='dark'] .workspace-meta,
body[data-theme='dark'] td {
    border-color: var(--line);
    background:
        radial-gradient(circle at top right, rgba(255, 92, 40, 0.1), transparent 24%),
        linear-gradient(180deg, rgba(27, 22, 66, 0.96), rgba(15, 14, 40, 0.98)) !important;
    color: var(--ink);
    box-shadow: var(--shadow-soft);
}

body[data-theme='light'] .workspace-topbar,
body[data-theme='light'] .workspace-hero,
body[data-theme='light'] .workspace-toolbar,
body[data-theme='light'] .workspace-card,
body[data-theme='light'] .admin-topbar,
body[data-theme='light'] .admin-panel,
body[data-theme='light'] .forum-toolbar-card,
body[data-theme='light'] .forum-post-card,
body[data-theme='light'] .forum-comment-card,
body[data-theme='light'] .forum-panel,
body[data-theme='light'] .forum-form-card,
body[data-theme='light'] .forum-empty-card,
body[data-theme='light'] .forum-pagination,
body[data-theme='light'] td {
    border-color: rgba(236, 231, 246, 0.92);
    background: rgba(255, 255, 255, 0.9) !important;
    color: var(--ink);
    box-shadow: var(--shadow-soft);
}

body[data-theme='dark'] .forum-input-shell input,
body[data-theme='dark'] .forum-input-shell textarea,
body[data-theme='dark'] .forum-input-shell select,
body[data-theme='dark'] .search-input,
body[data-theme='dark'] .sort-select,
body[data-theme='dark'] .form-input,
body[data-theme='dark'] .workspace-select,
body[data-theme='dark'] .workspace-profile,
body[data-theme='dark'] .workspace-logout,
body[data-theme='dark'] .workspace-nav-link,
body[data-theme='dark'] .profile-box {
    background: rgba(19, 16, 46, 0.94);
    border-color: var(--line);
    color: #f1f5f9;
}

body[data-theme='dark'] .theme-toggle-label-light {
    opacity: 0.45;
}

body[data-theme='dark'] .theme-toggle-label-dark {
    opacity: 1;
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-18px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}

@media (max-width: 900px) {
    .container {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .logo {
        grid-column: 1 / -1;
        margin-bottom: 8px;
    }

    .sidebar a {
        margin: 0;
    }

    .main {
        padding: 18px;
    }

    .workspace-topbar,
    .workspace-hero,
    .workspace-toolbar {
        grid-template-columns: 1fr;
        flex-direction: column;
        align-items: stretch;
    }

    .workspace-controls,
    .workspace-toolbar-controls {
        justify-content: stretch;
    }

    .workspace-select,
    .workspace-logout,
    .workspace-profile {
        width: 100%;
    }

    .workspace-card-grid,
    .admin-metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    .top-nav,
    .top-bar,
    .filters,
    .filter-form,
    .profile-wrapper {
        align-items: stretch;
        flex-direction: column;
    }

    .top-nav {
        justify-content: flex-start;
    }

    .form-grid,
    .data-card-body,
    .workspace-meta-grid,
    .workspace-metric-grid,
    .workspace-card-grid,
    .admin-metrics {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .sort-select {
        width: 100%;
    }
}
