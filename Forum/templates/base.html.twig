<body data-theme="light">
{% set currentRole = app.user and app.user.role ? app.user.role.name|lower : '' %}
{% set notification_menu = app.user ? forum_notification_menu_data(10) : {'unread_count': 0, 'notifications': []} %}
{% set legacyTopbarKicker = block('topbar_kicker')|trim %}
{% set legacyTopbarTitle = block('topbar_title')|trim %}
{% set legacyTopbarSubtitle = block('topbar_subtitle')|trim %}
{% set workspaceEyebrowBlock = block('workspace_eyebrow')|trim %}
{% set workspaceTitleBlock = block('workspace_title')|trim %}
{% set workspaceSubtitleBlock = block('workspace_subtitle')|trim %}
{% set resolvedWorkspaceEyebrow = legacyTopbarKicker != '' ? legacyTopbarKicker : (workspaceEyebrowBlock != '' ? workspaceEyebrowBlock : 'Connected View') %}
{% set resolvedWorkspaceTitle = legacyTopbarTitle != '' ? legacyTopbarTitle : (workspaceTitleBlock != '' ? workspaceTitleBlock : 'Hirely Workspace') %}
{% set resolvedWorkspaceSubtitle = legacyTopbarSubtitle != '' ? legacyTopbarSubtitle : (workspaceSubtitleBlock != '' ? workspaceSubtitleBlock : 'Track your hiring flow with a cleaner navigation experience.') %}
<div class="container">
    {% if app.user and currentRole not in ['candidate', 'recruiter', 'admin'] %}
        <aside class="sidebar">
            <div class="admin-brand" style="margin-bottom: 24px;">
