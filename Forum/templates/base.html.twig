                    <div class="admin-panel" style="margin-bottom: 24px;">
                        <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: rgba(255,255,255,0.56); margin-bottom: 6px;">Signed in as</div>
                        <div style="font-size: 15px; font-weight: 800; color: #fff;">{{ app.user.firstName }} {{ app.user.lastName }}</div>
                        <div style="font-size: 12px; color: rgba(255,255,255,0.62); margin-top: 4px; font-weight: 600; text-transform: capitalize;">{{ currentRole }}</div>
                    </div>

                    <nav class="admin-nav" aria-label="Main navigation">
                        <a href="{{ path('app_home') }}" class="admin-nav-link {{ currentRoute == 'app_home' ? 'active' : '' }}">Home</a>
                        <a href="{{ path('forum_index') }}" class="admin-nav-link {{ currentRoute starts with 'forum_' or currentRoute starts with 'notification_' or currentRoute starts with 'profile_' ? 'active' : '' }}">Forum</a>
                        <a href="{{ path('app_joboffer_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_joboffer' ? 'active' : '' }}">Job Offers</a>
                        <a href="{{ path('app_application_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_application' ? 'active' : '' }}">Applications</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin_forum_dashboard') }}" class="admin-nav-link {{ currentRoute starts with 'admin_forum_' ? 'active' : '' }}">Moderation</a>
                        {% endif %}
                    </nav>

                    <div style="margin-top: auto; padding-top: 24px;">
                        {% include 'forum/partials/_header_tools.html.twig' %}
                        <a href="{{ path('app_logout') }}" style="display: flex; align-items: center; min-height: 48px; padding: 0 18px; border-radius: 18px; color: rgba(255,92,40,0.9); font-size: 14px; font-weight: 700; text-decoration: none; border: 1px solid rgba(255,92,40,0.24); margin-top: 10px; transition: background 0.2s ease;" onmouseover="this.style.background='rgba(255,92,40,0.12)'" onmouseout="this.style.background='transparent'">Sign Out</a>
                    </div>
                </aside>

                <div class="main">
                    <header class="workspace-topbar" style="margin-bottom: 22px;">
                        <div>
                            <div class="workspace-eyebrow">{{ resolvedWorkspaceEyebrow }}</div>
                            <h1 class="workspace-title">{{ resolvedWorkspaceTitle }}</h1>
                        </div>
                        <div class="workspace-controls">
                            <a href="{{ path('app_users_edit', {'id': app.user.id}) }}" class="workspace-profile">
                                {% if app.user.profilePic %}
                                    <img src="{{ asset(app.user.profilePic) }}" class="profile-img" alt="{{ app.user.firstName }} {{ app.user.lastName }}">
                                {% else %}
                                    <div class="profile-placeholder">{{ app.user.firstName|first }}{{ app.user.lastName|first }}</div>
                                {% endif %}
                                <div class="workspace-profile-copy">
                                    <span class="workspace-role-badge">{{ currentRole }}</span>
                                    <span class="workspace-profile-name">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                                </div>
                            </a>
                        </div>
                    </header>

                    <div class="page-flashes">
                        {% for message in app.flashes('success') %}
                            <div class="page-flash page-flash-success">{{ message }}</div>
                        {% endfor %}
                        {% for message in app.flashes('error') %}
                            <div class="page-flash page-flash-error">{{ message }}</div>
                        {% endfor %}
                    </div>

                    {{ block('body') }}
                </div>
            </div>
        {% else %}
        {% if app.user and (show_topbar is not defined or show_topbar != false) %}
            <div class="top-nav">
                <div class="top-nav-actions">
                    <button type="button" class="theme-toggle" data-theme-toggle="true" aria-label="Toggle light and dark mode">
                        <span class="theme-toggle-label-light">Light</span>
                        <span class="theme-toggle-label-dark">Dark</span>
                    </button>
                </div>

                <div class="profile-wrapper">
                    <a href="{{ path('app_users_edit', {'id': app.user.id}) }}" class="profile-box">
                        {% if app.user.profilePic %}
                            <img src="{{ asset(app.user.profilePic) }}" class="profile-img" alt="{{ app.user.firstName }} {{ app.user.lastName }}">
                        {% else %}
                            <div class="profile-placeholder">
                                {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                            </div>
                        {% endif %}

                        <div>
                            <div class="profile-name">
                                {{ app.user.firstName }} {{ app.user.lastName }}
                            </div>
                            <small class="profile-role">
                                {{ app.user.role ? app.user.role.name : 'User' }}
                            </small>
                        </div>
                    </a>

                    <a href="{{ path('app_logout') }}" class="logout-btn">
                        Logout
                    </a>
                </div>
            </div>
        {% endif %}

        <div class="page-flashes">
            {% for message in app.flashes('success') %}
                <div class="page-flash page-flash-success">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="page-flash page-flash-error">{{ message }}</div>
            {% endfor %}
        </div>

        {{ block('body') }}
        {% endif %}
    </main>
</div>
{% block topbar_kicker %}{% endblock %}
{% block topbar_title %}{% endblock %}
{% block topbar_subtitle %}{% endblock %}
{% block workspace_eyebrow %}Connected View{% endblock %}
{% block workspace_title %}Hirely Workspace{% endblock %}
{% block workspace_subtitle %}Track your hiring flow with a cleaner navigation experience.{% endblock %}
{% block javascripts %}
    <script>
        (() => {
            const storageKey = 'hirely-theme';
            const body = document.body;
            const parser = new DOMParser();
            const applyTheme = (theme) => {
                body.dataset.theme = theme === 'dark' ? 'dark' : 'light';
            };

            const findRegionSelector = (node) => {
                if (!(node instanceof Element)) {
                    return null;
                }

                const region = node.closest('[data-dynamic-region]');
                if (!region) {
                    return null;
                }

                return `[data-dynamic-region="${region.dataset.dynamicRegion}"]`;
            };

            const setRegionLoading = (selector, loading) => {
                if (!selector) {
                    return;
                }

                const region = document.querySelector(selector);
                if (region) {
                    region.classList.toggle('is-loading', loading);
                }
            };

            const setFormBusy = (form, busy) => {
                form.querySelectorAll('button, input, select, textarea').forEach((field) => {
                    if (!(field instanceof HTMLElement)) {
                        return;
                    }

                    if (busy) {
                        field.dataset.wasDisabled = field.hasAttribute('disabled') ? 'true' : 'false';
                        field.setAttribute('disabled', 'disabled');
                    } else if (field.dataset.wasDisabled === 'false') {
                        field.removeAttribute('disabled');
                        delete field.dataset.wasDisabled;
                    }
                });
            };

            const toggleGeminiStatus = (form, busy) => {
                const selector = form.dataset.geminiStatusTarget;
                if (!selector) {
                    return;
                }

                const status = document.querySelector(selector);
                if (!status) {
                    return;
                }

                const textarea = form.querySelector('textarea');
                const shouldShow = busy && textarea instanceof HTMLTextAreaElement && /@gemini/i.test(textarea.value);
                status.hidden = !shouldShow;
            };

            const swapDynamicRegion = (selector, html) => {
                const current = document.querySelector(selector);
                if (!current) {
                    return false;
                }

                const nextDocument = parser.parseFromString(html, 'text/html');
                const next = nextDocument.querySelector(selector);
                if (!next) {
                    return false;
                }

                const currentFlashes = document.querySelector('.page-flashes');
                const nextFlashes = nextDocument.querySelector('.page-flashes');
                if (currentFlashes && nextFlashes) {
                    currentFlashes.replaceWith(nextFlashes);
                }

                current.replaceWith(next);
                initUi(document);

                return true;
            };

            const fetchHtml = async (url, options = {}) => {
                const response = await fetch(url, {
                    ...options,
                    headers: {
                        Accept: 'text/html',
                        'X-Requested-With': 'XMLHttpRequest',
                        ...(options.headers || {}),
                    },
                });

                return {
                    response,
                    html: await response.text(),
                };
            };

            const navigateDynamic = async (url, selector, pushUrl = true) => {
                if (!selector) {
                    window.location.assign(url);
                    return;
                }

                setRegionLoading(selector, true);

                try {
                    const { response, html } = await fetchHtml(url, { method: 'GET' });
                    const swapped = swapDynamicRegion(selector, html);
                    if (!swapped) {
                        window.location.assign(response.url || url);
                        return;
                    }

                    if (pushUrl) {
                        window.history.pushState({}, '', response.url || url);
                    }
                } catch (error) {
                    window.location.assign(url);
                } finally {
                    setRegionLoading(selector, false);
                }
            };

            const submitDynamicForm = async (form, pushUrl = false) => {
                const selector = form.dataset.dynamicTarget || findRegionSelector(form);
                const method = (form.getAttribute('method') || 'GET').toUpperCase();
                const action = form.getAttribute('action') || window.location.href;
                const url = new URL(action, window.location.origin);
                const formData = new FormData(form);

                setRegionLoading(selector, true);
                setFormBusy(form, true);
                toggleGeminiStatus(form, true);

                try {
                    let requestUrl = url.toString();
                    let options = { method };

                    if (method === 'GET') {
                        const search = new URLSearchParams();
                        for (const [key, value] of formData.entries()) {
                            search.append(key, String(value));
                        }
                        requestUrl = `${url.origin}${url.pathname}${search.toString() !== '' ? '?' + search.toString() : ''}`;
                    } else {
                        options = {
                            method,
                            body: formData,
                        };
                    }

                    const { response, html } = await fetchHtml(requestUrl, options);
                    const swapped = selector ? swapDynamicRegion(selector, html) : false;
                    if (!swapped) {
                        window.location.assign(response.url || requestUrl);
                        return;
                    }

                    if (method === 'GET' && pushUrl) {
                        window.history.pushState({}, '', response.url || requestUrl);
                    } else if (method !== 'GET' && response.url) {
                        window.history.replaceState({}, '', response.url);
                    }
                } catch (error) {
                    setFormBusy(form, false);
                    toggleGeminiStatus(form, false);
                    setRegionLoading(selector, false);
                    form.submit();
                    return;
                } finally {
                    setFormBusy(form, false);
                    toggleGeminiStatus(form, false);
                    setRegionLoading(selector, false);
                }
            };

            const bindThemeToggles = (scope = document) => {
                scope.querySelectorAll('[data-theme-toggle="true"]').forEach((button) => {
                    if (button.dataset.themeBound === 'true') {
                        return;
                    }

                    button.dataset.themeBound = 'true';
                    button.addEventListener('click', () => {
                        const nextTheme = body.dataset.theme === 'dark' ? 'light' : 'dark';
                        applyTheme(nextTheme);
                        try {
                            localStorage.setItem(storageKey, nextTheme);
                        } catch (error) {
                        }
                    });
                });
            };

            const bindAutoSubmitForms = (scope = document) => {
                scope.querySelectorAll('form[data-auto-submit="true"], form[data-dynamic-form="true"]').forEach((form) => {
                    if (form.dataset.uiBound === 'true') {
                        return;
                    }

                    form.dataset.uiBound = 'true';
                    const isDynamic = form.dataset.dynamicForm === 'true';
                    const pushUrl = form.dataset.dynamicPushUrl === 'true';

                    form.addEventListener('submit', (event) => {
                        if (!isDynamic) {
                            return;
                        }

                        event.preventDefault();
                        submitDynamicForm(form, pushUrl);
                    });

                    if (form.dataset.autoSubmit !== 'true') {
                        return;
                    }

                    form.querySelectorAll('select').forEach((select) => {
                        select.addEventListener('change', () => {
                            if (isDynamic) {
                                submitDynamicForm(form, pushUrl);
                                return;
                            }

                            if (form.requestSubmit) {
                                form.requestSubmit();
                            } else {
                                form.submit();
                            }
                        });
                    });

                    form.querySelectorAll('[data-auto-submit-input="true"]').forEach((input) => {
                        let debounceTimer;
                        input.addEventListener('input', () => {
                            clearTimeout(debounceTimer);
                            debounceTimer = setTimeout(() => {
                                if (isDynamic) {
                                    submitDynamicForm(form, pushUrl);
                                    return;
                                }

                                if (form.requestSubmit) {
                                    form.requestSubmit();
                                } else {
                                    form.submit();
                                }
                            }, 350);
                        });
                    });
                });
            };

            const bindNotificationMenus = (scope = document) => {
                scope.querySelectorAll('[data-notification-wrap="true"]').forEach((wrap) => {
                    if (wrap.dataset.notificationBound === 'true') {
                        return;
                    }

                    wrap.dataset.notificationBound = 'true';
                    const toggle = wrap.querySelector('[data-notification-toggle="true"]');
                    const menu = wrap.querySelector('[data-notification-menu="true"]');
                    if (!toggle || !menu) {
                        return;
                    }

                    toggle.addEventListener('click', () => {
                        const shouldOpen = menu.hidden;
                        document.querySelectorAll('[data-notification-menu="true"]').forEach((otherMenu) => {
                            otherMenu.hidden = true;
                        });
                        menu.hidden = !shouldOpen;
                    });
                });
            };

            const bindGoBackLinks = (scope = document) => {
                scope.querySelectorAll('[data-go-back="true"]').forEach((link) => {
                    if (link.dataset.goBackBound === 'true') {
                        return;
                    }

                    link.dataset.goBackBound = 'true';
                    link.addEventListener('click', (event) => {
                        const fallback = link.dataset.fallback;
                        if (window.history.length > 1) {
                            event.preventDefault();
                            window.history.back();
                        } else if (fallback) {
                            link.setAttribute('href', fallback);
                        }
                    });
                });
            };

            const bindDynamicLinks = () => {
                if (document.body.dataset.dynamicLinksBound === 'true') {
                    return;
                }

                document.body.dataset.dynamicLinksBound = 'true';
                document.addEventListener('click', (event) => {
                    const link = event.target.closest('a[data-dynamic-link="true"]');
                    if (!(link instanceof HTMLAnchorElement)) {
                        return;
                    }

                    const selector = findRegionSelector(link);
                    if (!selector) {
                        return;
                    }

                    event.preventDefault();
                    navigateDynamic(link.href, selector, true);
                });

                document.addEventListener('click', (event) => {
                    document.querySelectorAll('[data-notification-wrap="true"]').forEach((wrap) => {
                        if (!wrap.contains(event.target)) {
                            const menu = wrap.querySelector('[data-notification-menu="true"]');
                            if (menu) {
                                menu.hidden = true;
                            }
                        }
                    });
                });
            };

            const initUi = (scope = document) => {
                bindThemeToggles(scope);
                bindGoBackLinks(scope);
                bindAutoSubmitForms(scope);
                bindNotificationMenus(scope);
                bindDynamicLinks();
            };

            try {
                applyTheme(localStorage.getItem(storageKey) || 'light');
            } catch (error) {
                applyTheme('light');
            }

            initUi(document);

            window.addEventListener('popstate', () => {
                window.location.reload();
            });
        })();
    </script>
{% endblock %}
</body>
</html>
