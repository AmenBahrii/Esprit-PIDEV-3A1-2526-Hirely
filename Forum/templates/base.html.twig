                <a href="{{ path('app_joboffer_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_joboffer' ? 'active' : '' }}">Job Offers</a>
                <a href="{{ path('app_application_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_application' ? 'active' : '' }}">Applications</a>
                <a href="{{ path('forum_index') }}" class="admin-nav-link {{ currentRoute starts with 'forum_' or currentRoute starts with 'notification_' or currentRoute starts with 'profile_' ? 'active' : '' }}">Forum</a>
                {% if is_granted('ROLE_ADMIN') %}
