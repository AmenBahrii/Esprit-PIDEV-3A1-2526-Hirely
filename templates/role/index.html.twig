{% extends 'base.html.twig' %}

{% block title %}Roles{% endblock %}

{% block body %}

<div class="header">Hirely Dashboard</div>
<div class="sub-header">Roles Management</div>

<div class="card">

    <div class="top-bar">
        <h3>Roles List</h3>

        <a href="{{ path('app_role_new') }}" class="btn btn-primary">
            + Add Role
        </a>
    </div>

    <div class="table-container">

        <table class="modern-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Role</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Dashboard</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
            {% for role in roles %}
                <tr>

                    <td>#{{ role.role_id }}</td>

                    <td>
                        <span class="role-badge role-{{ role.name|lower }}">
                            {{ role.name }}
                        </span>
                    </td>

                    <td class="desc">
                        {{ role.description }}
                    </td>

                    <td>
                        <span class="status-pill">
                            {{ role.status }}
                        </span>
                    </td>

                    <td>
                        <span class="dashboard-pill">
                            {{ role.defaultDashboard }}
                        </span>
                    </td>

                    <td class="actions">

                        <a href="{{ path('app_role_edit', {'role_id': role.role_id}) }}"
                           class="btn btn-edit">
                            Edit
                        </a>

                        <a href="{{ path('app_role_show', {'role_id': role.role_id}) }}"
                           class="btn btn-view">
                            View
                        </a>

                        {% if role.name != 'Admin' %}
                        <form method="post"
                              action="{{ path('app_role_delete', {'role_id': role.role_id}) }}"
                              style="display:inline;">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ role.role_id) }}">
                            <button class="btn btn-delete">Delete</button>
                        </form>
                        {% endif %}

                    </td>

                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No roles found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

    </div>

</div>

{% endblock %}