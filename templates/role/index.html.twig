{% extends 'base.html.twig' %}

{% block title %}Roles{% endblock %}

{% block body %}

<div class="header">Hirely Dashboard</div>
<div class="sub-header">Roles Management</div>

<div class="card">

    <div class="filters">
        <input type="text"
               id="roleSearch"
               placeholder="Search roles..."
               class="search-input">

        <select id="roleSort" class="sort-select">
            <option value="name_asc">Name A-Z</option>
            <option value="name_desc">Name Z-A</option>
            <option value="status_asc">Status A-Z</option>
            <option value="status_desc">Status Z-A</option>
        </select>
    </div>

    <div class="top-bar">
        <h3>Roles List</h3>

        <a href="{{ path('app_role_new') }}" class="btn btn-primary">
            + Add Role
        </a>
    </div>

    <div class="card-grid" id="roleCards">
        {% for role in roles %}
            <article class="data-card"
                     data-role-card
                     data-search="{{ role.name ~ ' ' ~ role.description ~ ' ' ~ role.status ~ ' ' ~ role.defaultDashboard }}"
                     data-name="{{ role.name|lower }}"
                     data-status="{{ role.status|lower }}">
                <div class="data-card-header">
                    <div>
                        <h4 class="data-card-title">
                            <span class="role-badge role-{{ role.name|lower }}">
                                {{ role.name }}
                            </span>
                        </h4>
                        <div class="data-card-subtitle">#{{ role.id }}</div>
                    </div>

                    <span class="status-pill">{{ role.status }}</span>
                </div>

                <div class="data-card-body">
                    <div class="data-card-field">
                        <span class="data-card-label">Description</span>
                        <span class="data-card-value">{{ role.description }}</span>
                    </div>
                    <div class="data-card-field">
                        <span class="data-card-label">Dashboard</span>
                        <span class="data-card-value">{{ role.defaultDashboard }}</span>
                    </div>
                </div>

                <div class="data-card-actions">
                    <a href="{{ path('app_role_edit', {'id': role.id}) }}"
                       class="btn btn-edit">
                        Edit
                    </a>

                  

                    {% if role.name != 'Admin' %}
                        <form method="post"
                              action="{{ path('app_role_delete', {'id': role.id}) }}">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ role.id) }}">
                            <button class="btn btn-delete">Delete</button>
                        </form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="empty-state">No roles found</div>
        {% endfor %}
    </div>

</div>

<script>
const roleSearch = document.getElementById('roleSearch');
const roleSort = document.getElementById('roleSort');
const roleCardsContainer = document.getElementById('roleCards');
const roleCards = Array.from(roleCardsContainer.querySelectorAll('[data-role-card]'));

function sortRoleCards(cards, sortValue) {
    const sorted = [...cards];

    sorted.sort((a, b) => {
        if (sortValue === 'name_desc') {
            return b.dataset.name.localeCompare(a.dataset.name);
        }
        if (sortValue === 'status_asc') {
            return a.dataset.status.localeCompare(b.dataset.status);
        }
        if (sortValue === 'status_desc') {
            return b.dataset.status.localeCompare(a.dataset.status);
        }

        return a.dataset.name.localeCompare(b.dataset.name);
    });

    sorted.forEach(card => roleCardsContainer.appendChild(card));
}

function filterAndSortRoles() {
    const search = roleSearch.value.toLowerCase();

    roleCards.forEach(card => {
        const matches = card.dataset.search.toLowerCase().includes(search);
        card.style.display = matches ? '' : 'none';
    });

    sortRoleCards(roleCards, roleSort.value);
}

roleSearch.addEventListener('input', filterAndSortRoles);
roleSort.addEventListener('change', filterAndSortRoles);
</script>

{% endblock %}
