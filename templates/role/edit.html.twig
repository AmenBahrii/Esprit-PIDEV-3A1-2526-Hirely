{% extends 'admin/base_admin.html.twig' %}

{% set force_sidebar = true %}
{% set topbar_title = 'Edit Role' %}
{% set topbar_subtitle = 'Adjust access behavior and defaults' %}

{% block title %}Edit Role{% endblock %}

{% block admin_content %}
    <section class="module-page">
        <div class="module-hero">
            <div class="module-hero-copy">
                <span class="module-eyebrow">Role Module</span>
                <h1 class="module-title">{{ role.name|title }}</h1>
                <p class="module-subtitle">Update how this role behaves across the platform.</p>
            </div>
            <div class="module-actions">
                <a href="{{ path('app_admin_role_show', {'id': role.id}) }}" class="btn-secondary topbar-logout-link">View role</a>
                <a href="{{ path('app_admin_role_index') }}" class="btn-secondary topbar-logout-link">Back to roles</a>
            </div>
        </div>
        <div class="module-panel">
            {{ include('role/_form.html.twig', {button_label: 'Save changes'}) }}
        </div>
    </section>
{% endblock %}
