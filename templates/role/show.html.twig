{% extends 'base.html.twig' %}

{% block title %}Role{% endblock %}

{% block body %}
    <h1>Role</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Role_id</th>
                <td>{{ role.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ role.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ role.description }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ role.status }}</td>
            </tr>
            <tr>
                <th>Default_dashboard</th>
                <td>{{ role.defaultDashboard }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_role_index') }}">back to list</a>

    <a href="{{ path('app_role_edit', {'role_id': role.role_id}) }}">edit</a>

    {{ include('role/_delete_form.html.twig') }}
{% endblock %}
