{% set admin_area = app.request.attributes.get('_route') starts with 'app_admin' %}
{% set edit_plan_route = admin_area ? 'app_admin_plans_edit' : 'app_workspace_plans_edit' %}
{% set tasks_route = admin_area ? 'app_admin_plan_tasks' : 'app_workspace_plan_tasks' %}
{% set delete_plan_route = admin_area ? 'app_admin_plans_delete' : 'app_workspace_plans_delete' %}
{% set qr_route = admin_area ? 'app_admin_plans_qr' : 'app_workspace_plans_qr' %}
{% set plans_results_ui = onboarding_language.translateMap({
    chart_title: 'Plan Status Snapshot',
    chart_text: 'Visual breakdown of the currently visible onboarding plans.',
    focus_title: 'Plan Focus',
    focus_text: 'A quick read on what deserves attention in the current view.',
    current_pulse: 'Current pulse',
    priority_plan: 'Priority plan',
    next_deadline: 'Next deadline',
    coverage: 'Coverage',
    assigned_candidate: 'Assigned candidate',
    overdue: 'Overdue',
    on_track: 'On Track',
    deadline: 'Deadline',
    tasks: 'Tasks',
    qr_access: 'QR access',
    no_deadline: 'No deadline',
    ready: 'Ready',
    generate_on_open: 'Generate on open',
    edit: 'Edit',
    tasks_button: 'Tasks',
    qr_code: 'QR Code',
    delete: 'Delete',
    no_matching_plans: 'No matching plans',
    no_plans_found: 'No plans found for',
    no_plans_search_text: 'Try another keyword, change the filters, or clear the search to see all plans again.',
    no_plans_yet: 'No plans yet',
    start_flow_title: 'Start your onboarding coordination flow',
    start_flow_text: 'Create the first onboarding plan to assign a user, set a status, and organize plan-specific tasks.'
}) %}
{% set plan_status_labels = onboarding_language.translateMap({
    pending: 'Pending',
    in_progress: 'In Progress',
    completed: 'Completed',
    on_hold: 'On Hold'
}) %}
{% set flow_panel_ui = onboarding_language.translateMap({
    focus_title: 'Flow Signal',
    focus_text: 'A compact read on progress and risk across the visible onboarding plans.',
    average_progress: 'Average progress',
    risk_level: 'Risk level',
    risk_signals: 'Risk signals',
    active_signals: 'active signals',
    priority_plan: 'Priority plan',
    current_phase: 'Current phase',
    next_action: 'Next action',
    high: 'High',
    medium: 'Medium',
    low: 'Low'
}) %}
{% set plan_flow_risk_labels = {
    high: flow_panel_ui.high,
    medium: flow_panel_ui.medium,
    low: flow_panel_ui.low
} %}

<div class="analytics-grid analytics-grid-double analytics-grid-plan" style="margin-bottom: 22px;">
    <article class="analytics-card">
        <div class="analytics-card-head">
            <div>
                <h3 class="analytics-title">{{ plans_results_ui.chart_title }}</h3>
                <p class="analytics-text">{{ plans_results_ui.chart_text }}</p>
            </div>
        </div>
        <div class="chart-frame">
            {{ render_chart(plan_status_chart) }}
        </div>
    </article>

    <article class="analytics-card plan-focus-card">
        <div class="analytics-card-head">
            <div>
                <h3 class="analytics-title">{{ flow_panel_ui.focus_title }}</h3>
                <p class="analytics-text">{{ flow_panel_ui.focus_text }}</p>
            </div>
        </div>

        <div class="plan-focus-hero">
            <span class="plan-focus-kicker">{{ flow_panel_ui.average_progress }}</span>
            <h4 class="plan-focus-title">{{ plan_flow_panel.average_progress }}%</h4>
            <p class="plan-focus-text">{{ plan_flow_panel.summary }}</p>
        </div>

        <div class="plan-focus-list">
            <div class="plan-focus-item">
                <span class="plan-focus-label">{{ flow_panel_ui.risk_level }}</span>
                <strong class="plan-focus-value risk-{{ plan_flow_panel.highest_risk }}">{{ plan_flow_risk_labels[plan_flow_panel.highest_risk] ?? plan_flow_panel.highest_risk|title }}</strong>
                <span class="plan-focus-note">{{ plan_flow_panel.total_risk_signals }} {{ flow_panel_ui.active_signals }}</span>
            </div>
            <div class="plan-focus-item">
                <span class="plan-focus-label">{{ flow_panel_ui.priority_plan }}</span>
                <strong class="plan-focus-value">{{ plan_flow_panel.priority_plan_label }}</strong>
                <span class="plan-focus-note">{{ flow_panel_ui.current_phase }}: {{ plan_flow_panel.priority_phase }}</span>
            </div>
            <div class="plan-focus-item">
                <span class="plan-focus-label">{{ flow_panel_ui.next_action }}</span>
                <strong class="plan-focus-value">{{ plan_flow_panel.top_action }}</strong>
            </div>
        </div>
    </article>
</div>

{% if plans is not empty %}
    <div class="record-grid">
        {% for plan in plans %}
            <article class="record-card plan-card">
                <div class="record-card-top">
                    <div class="record-heading">
                        <p class="record-eyebrow">Plan #{{ plan.planId }}</p>
                        <h3 class="record-title">{{ plan.user.firstName }} {{ plan.user.lastName }}</h3>
                        <p class="record-subtitle">{{ plan.user.email ?: plans_results_ui.assigned_candidate }}</p>
                    </div>
                    <div class="record-chip-stack">
                        <span class="status-pill status-{{ plan.status|replace({'_': '-'}) }}">{{ plan_status_labels[plan.status] ?? (plan.status|replace({'_': ' '})|title) }}</span>
                        <span class="status-chip {{ plan.isOverdue ? 'overdue' : 'on-track' }}">
                            {{ plan.isOverdue ? plans_results_ui.overdue : plans_results_ui.on_track }}
                        </span>
                    </div>
                </div>

                <div class="record-stats record-stats-plan">
                    <div class="record-stat">
                        <span class="record-stat-label">{{ plans_results_ui.deadline }}</span>
                        <span class="record-stat-value">{{ plan.deadline ? plan.deadline|date('Y-m-d') : plans_results_ui.no_deadline }}</span>
                    </div>
                    <div class="record-stat">
                        <span class="record-stat-label">{{ plans_results_ui.tasks }}</span>
                        <span class="record-stat-value">{{ plan.onboardingtasks|length }} task(s)</span>
                    </div>
                    <div class="record-stat record-stat-wide">
                        <span class="record-stat-label">{{ plans_results_ui.qr_access }}</span>
                        <span class="record-stat-value">{{ plan.qrToken ? plans_results_ui.ready : plans_results_ui.generate_on_open }}</span>
                    </div>
                </div>

                <div class="actions-cell record-actions">
                    {% if viewer_context.canEditPlan(plan) %}
                        <a href="{{ path(edit_plan_route, {id: plan.planId}) }}" class="btn-secondary">{{ plans_results_ui.edit }}</a>
                    {% endif %}
                    <a href="{{ path(tasks_route, {id: plan.planId}) }}" class="btn-primary">{{ plans_results_ui.tasks_button }}</a>
                    <a href="{{ path(qr_route, {id: plan.planId}) }}" class="btn-secondary">{{ plans_results_ui.qr_code }}</a>
                    {% if viewer_context.canDeletePlan(plan) %}
                        <form method="post" action="{{ path(delete_plan_route, {id: plan.planId}) }}" class="inline-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_plan_' ~ plan.planId) }}">
                            <button
                                type="submit"
                                class="btn-danger delete-action"
                                data-delete-label="{{ plans_results_ui.delete }}"
                                aria-label="{{ plans_results_ui.delete }}"
                                title="{{ plans_results_ui.delete }}"
                            >
                                <svg class="delete-action-icon" viewBox="0 0 448 512" aria-hidden="true" focusable="false">
                                    <path d="M135.2 17.7C140.6 7.1 151.5 0 163.4 0H284.6c11.9 0 22.8 7.1 28.2 17.7L328 48H432c8.8 0 16 7.2 16 16s-7.2 16-16 16H416l-21.2 339.2c-2 31.4-28.1 56.8-59.6 56.8H112.8c-31.5 0-57.6-25.4-59.6-56.8L32 80H16C7.2 80 0 72.8 0 64S7.2 48 16 48H120l15.2-30.3zM168 176c8.8 0 16 7.2 16 16V400c0 8.8-7.2 16-16 16s-16-7.2-16-16V192c0-8.8 7.2-16 16-16zm112 0c8.8 0 16 7.2 16 16V400c0 8.8-7.2 16-16 16s-16-7.2-16-16V192c0-8.8 7.2-16 16-16z"></path>
                                </svg>
                                <span class="delete-action-text">{{ plans_results_ui.delete }}</span>
                            </button>
                        </form>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
{% else %}
    <div class="empty-state-card">
        {% if search_term is defined and search_term is not empty %}
            <p class="record-eyebrow">{{ plans_results_ui.no_matching_plans }}</p>
            <h3 class="record-title">{{ plans_results_ui.no_plans_found }} "{{ search_term }}"</h3>
            <p class="muted-text">{{ plans_results_ui.no_plans_search_text }}</p>
        {% else %}
            <p class="record-eyebrow">{{ plans_results_ui.no_plans_yet }}</p>
            <h3 class="record-title">{{ plans_results_ui.start_flow_title }}</h3>
            <p class="muted-text">{{ plans_results_ui.start_flow_text }}</p>
        {% endif %}
    </div>
{% endif %}
