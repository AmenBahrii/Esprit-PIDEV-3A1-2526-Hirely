{% extends 'base.html.twig' %}

{% block title %}All Interviews - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">All Interviews</h1>

            {% if interviews is empty %}
                <div class="alert alert-info">
                    <p>No interviews found.</p>
                </div>
            {% else %}
                <section class="workspace-toolbar mb-3">
                    <div class="workspace-toolbar-copy">
                        <span class="workspace-toolbar-label">Search and Sort</span>
                        <span class="workspace-toolbar-subtitle">Search by recruiter, candidate, job title, interview type, or status and reorder the visible interviews instantly.</span>
                    </div>

                    <div class="workspace-toolbar-controls">
                        <input type="search" id="admin-interview-search" class="search-input" placeholder="Search recruiter, candidate, or status">

                        <select id="admin-interview-sort" class="sort-select">
                            <option value="date_desc">Newest first</option>
                            <option value="date_asc">Oldest first</option>
                            <option value="recruiter_asc">Recruiter A to Z</option>
                            <option value="candidate_asc">Candidate A to Z</option>
                            <option value="job_asc">Job title A to Z</option>
                            <option value="status_asc">Status A to Z</option>
                        </select>
                    </div>
                </section>

                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="admin-interview-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Recruiter</th>
                                <th>Candidate</th>
                                <th>Job Offer</th>
                                <th>Interview Type</th>
                                <th>Scheduled Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="admin-interview-table-body">
                            {% for interview in interviews %}
                                <tr data-search="{{
                                    ((interview.recruiter_first_name ~ ' ' ~ interview.recruiter_last_name) ~ ' ' ~
                                    (interview.candidate_first_name ~ ' ' ~ interview.candidate_last_name) ~ ' ' ~
                                    (interview.job_title ?? 'N/A') ~ ' ' ~
                                    (interview.interview_type_name ?? 'N/A') ~ ' ' ~
                                    interview.status ~ ' ' ~
                                    interview.interview_round)
                                |lower }}">
                                    <td>
                                        {% if interview.recruiter_first_name or interview.recruiter_last_name %}
                                            {{ interview.recruiter_first_name }} {{ interview.recruiter_last_name }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if interview.candidate_first_name or interview.candidate_last_name %}
                                            {{ interview.candidate_first_name }} {{ interview.candidate_last_name }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ interview.job_title ?? 'N/A' }}
                                    </td>
                                    <td>
                                        {{ interview.interview_type_name ?? 'N/A' }}
                                    </td>
                                    <td>{{ interview.scheduled_date ? interview.scheduled_date|date('M d, Y') : 'N/A' }}</td>
                                    <td>
                                        <span class="badge 
                                            {% if interview.status == 'scheduled' %}bg-warning
                                            {% elseif interview.status == 'completed' %}bg-success
                                            {% elseif interview.status == 'cancelled' %}bg-danger
                                            {% endif %}">
                                            {{ interview.status|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_interview_show', {'interviewId': interview.interview_id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p id="admin-interview-empty-state" class="text-muted mt-2 d-none">No interviews match your search.</p>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('admin-interview-search');
    const sortSelect = document.getElementById('admin-interview-sort');
    const tbody = document.getElementById('admin-interview-table-body');
    const emptyState = document.getElementById('admin-interview-empty-state');

    if (!searchInput || !sortSelect || !tbody || !emptyState) {
        return;
    }

    const rows = Array.from(tbody.querySelectorAll('tr'));

    function cellText(row, index) {
        return (row.cells[index]?.textContent || '').trim();
    }

    function parseDate(text) {
        const timestamp = Date.parse(text);
        return Number.isNaN(timestamp) ? 0 : timestamp;
    }

    function compareRows(a, b, sortKey) {
        switch (sortKey) {
            case 'date_asc':
                return parseDate(cellText(a, 4)) - parseDate(cellText(b, 4));
            case 'date_desc':
                return parseDate(cellText(b, 4)) - parseDate(cellText(a, 4));
            case 'recruiter_asc':
                return cellText(a, 0).localeCompare(cellText(b, 0));
            case 'candidate_asc':
                return cellText(a, 1).localeCompare(cellText(b, 1));
            case 'job_asc':
                return cellText(a, 2).localeCompare(cellText(b, 2));
            case 'status_asc':
                return cellText(a, 5).localeCompare(cellText(b, 5));
            default:
                return 0;
        }
    }

    function refreshRows() {
        const query = searchInput.value.trim().toLowerCase();
        const sortKey = sortSelect.value;

        const filteredRows = rows.filter(function (row) {
            const searchable = (row.dataset.search || '').toLowerCase();
            const match = query === '' || searchable.includes(query);
            row.classList.toggle('d-none', !match);
            return match;
        });

        filteredRows.sort(function (a, b) {
            return compareRows(a, b, sortKey);
        });

        filteredRows.forEach(function (row) {
            tbody.appendChild(row);
        });

        emptyState.classList.toggle('d-none', filteredRows.length > 0);
    }

    searchInput.addEventListener('input', refreshRows);
    sortSelect.addEventListener('change', refreshRows);
    refreshRows();
});
</script>
{% endblock %}
