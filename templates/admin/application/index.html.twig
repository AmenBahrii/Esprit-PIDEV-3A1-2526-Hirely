{% extends 'base.html.twig' %}

{% block title %}Applications{% endblock %}

{% block body %}

<div class="header">Hirely Dashboard</div>
<div class="sub-header">Applications Management</div>

<div class="card">

    <div class="top-bar">
        <h3>Applications List</h3>

        <a href="{{ path('app_application_new') }}" class="btn btn-primary">
            Add Application
        </a>
    </div>

    <table>
    <thead>
        <tr>
            
            <th>Date</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Status</th>
            <th>Salary</th>
            <th>Experience</th>
            <th>Job Offer</th>
            <th>Score</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    {% for application in applications %}
        <tr>
            

            <td>
                {{ application.applicationDate ? application.applicationDate|date('Y-m-d') : '' }}
            </td>

            <td>{{ application.email }}</td>

            <td>{{ application.phone }}</td>

            <td>
                {% if application.currentStatus == 'Accepted' %}
                    <span class="status status-accepted">Accepted</span>
                {% elseif application.currentStatus == 'pending' %}
                    <span class="status status-pending">Pending</span>
                {% else %}
                    <span class="status status-rejected">
                        {{ application.currentStatus }}
                    </span>
                {% endif %}
            </td>

            <td>{{ application.expectedSalary }}</td>

            <td>{{ application.experienceYears }} yrs</td>

            <td>
                {{ application.jobOffer ? application.jobOffer.title : 'N/A' }}
            </td>

            <td>
                {{ application.score is not null ? application.score : '—' }}
            </td>

            <td>
                <a class="btn btn-edit"
                   href="{{ path('app_application_edit', {'applicationId': application.applicationId}) }}">
                    Edit
                </a>

                <form method="post"
                      action="{{ path('app_application_delete', {'applicationId': application.applicationId}) }}"
                      style="display:inline;">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('delete' ~ application.applicationId) }}">
                    <button class="btn btn-delete">Delete</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="10">No applications found</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

</div>

{% endblock %}