{% extends 'base.html.twig' %}

{% block title %}Job Offers{% endblock %}

{% block body %}

<div class="header">Hirely Dashboard</div>
<div class="sub-header">Job Offers Management</div>

<div class="card">

    <div class="top-bar">
        <h3>Job Offers List</h3>

        <a href="{{ path('app_joboffer_new') }}" class="btn btn-primary">
            Add Job Offer
        </a>
    </div>

    <table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Contract</th>
            <th>Location</th>
            <th>Salary</th>
            <th>Experience</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    {% for joboffer in joboffers %}
        <tr>
            <td>#{{ joboffer.id }}</td>

            <td>{{ joboffer.title }}</td>

            <td>{{ joboffer.contractType }}</td>

            <td>{{ joboffer.location }}</td>

            <td>{{ joboffer.salary }}</td>

            <td>{{ joboffer.experienceRequired }} yrs</td>

            <td>
                {{ joboffer.publicationDate ? joboffer.publicationDate|date('Y-m-d') : '' }}
            </td>

            <td>
                {% if joboffer.status == 'Open' %}
                    <span class="status status-open">Open</span>
                {% else %}
                    <span class="status status-closed">{{ joboffer.status }}</span>
                {% endif %}
            </td>

            <td>
                <a class="btn btn-edit"
                   href="{{ path('app_joboffer_edit', {'id': joboffer.id}) }}">
                    Edit
                </a>

                <form method="post"
                      action="{{ path('app_joboffer_delete', {'id': joboffer.id}) }}"
                      style="display:inline;">
                    <input type="hidden" name="_token"
                           value="{{ csrf_token('delete' ~ joboffer.id) }}">
                    <button class="btn btn-delete">Delete</button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="9">No job offers found</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

</div>

{% endblock %}