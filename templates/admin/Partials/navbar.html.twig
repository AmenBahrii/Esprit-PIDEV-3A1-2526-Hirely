{% set admin_area = app.request.attributes.get('_route') starts with 'app_admin' %}
{% set dashboard_route = admin_area ? 'app_admin' : 'app_workspace' %}
{% set plans_route = admin_area ? 'app_admin_plans' : 'app_workspace_plans' %}
{% set plans_active = app.request.attributes.get('_route') starts with (admin_area ? 'app_admin_plans' : 'app_workspace_plans') or app.request.attributes.get('_route') starts with (admin_area ? 'app_admin_plan_tasks' : 'app_workspace_plan_tasks') %}
{% set shell_ui = onboarding_language.translateMap({
    topbar_title: admin_area ? 'Admin Dashboard' : viewer_context.workspaceTitle,
    topbar_subtitle: 'Onboarding coordination',
    dashboard: 'Dashboard',
    my_onboarding: 'My Onboarding',
    onboarding_plans: 'Onboarding Plans',
    live_workspace: 'Live workspace',
    command_surface: 'Command surface',
    connected_view: 'Connected view'
}) %}

<header class="topbar">
    <div class="topbar-layout">
        <div class="topbar-copy">
            <div class="topbar-kicker-row">
                <span class="topbar-kicker">{{ admin_area ? shell_ui.command_surface : shell_ui.connected_view }}</span>
                <span class="topbar-kicker-dot"></span>
                <span class="topbar-kicker">{{ shell_ui.live_workspace }}</span>
            </div>
            <div class="topbar-title">{{ shell_ui.topbar_title }}</div>
            <div class="topbar-subtitle">{{ shell_ui.topbar_subtitle }}</div>
        </div>

        <div class="viewer-panel">
            {% if onboarding_language.isEnabled %}
                <form method="get" action="{{ app.request.pathInfo }}" class="inline-translation-form topbar-translation-form">
                    {% for key, value in app.request.query.all %}
                        {% if key != 'lang' and value is not iterable %}
                            <input type="hidden" name="{{ key }}" value="{{ value }}">
                        {% endif %}
                    {% endfor %}
                    <select name="lang" class="search-select translation-select" onchange="this.form.requestSubmit()">
                        {% for label, value in onboarding_language.languageChoices %}
                            <option value="{{ value }}" {{ onboarding_language.currentLanguage == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </form>
            {% endif %}
            <div class="viewer-summary">
                <span class="{{ viewer_context.roleBadgeClass }}">{{ viewer_context.roleName }}</span>
                <div class="viewer-name">{{ viewer_context.currentUserDisplayName }}</div>
            </div>
        </div>
    </div>

    {% if not admin_area %}
        <nav class="workspace-nav">
            <a href="{{ path(dashboard_route) }}" class="workspace-nav-link {{ app.request.attributes.get('_route') == dashboard_route ? 'active' : '' }}">{{ shell_ui.dashboard }}</a>
            <a href="{{ path(plans_route) }}" class="workspace-nav-link {{ plans_active ? 'active' : '' }}">
                {{ viewer_context.candidate ? shell_ui.my_onboarding : shell_ui.onboarding_plans }}
            </a>
        </nav>
    {% endif %}
</header>
