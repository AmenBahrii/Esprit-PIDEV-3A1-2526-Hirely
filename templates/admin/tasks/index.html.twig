{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ onboarding_language.translateMap({page_title: 'Plan Tasks'}).page_title }}{% endblock %}

{% set admin_area = app.request.attributes.get('_route') starts with 'app_admin' %}
{% set plans_route = admin_area ? 'app_admin_plans' : 'app_workspace_plans' %}
{% set tasks_new_route = admin_area ? 'app_admin_plan_tasks_new' : 'app_workspace_plan_tasks_new' %}
{% set tasks_edit_route = admin_area ? 'app_admin_plan_tasks_edit' : 'app_workspace_plan_tasks_edit' %}
{% set tasks_delete_route = admin_area ? 'app_admin_plan_tasks_delete' : 'app_workspace_plan_tasks_delete' %}
{% set task_index_ui = onboarding_language.translateMap({
    back_to_plans: 'Back to Plans',
    add_task: 'Add Task',
    search_placeholder: 'Search by task number, title, status, or attachment',
    case_on: 'Case Sensitive: On',
    case_off: 'Case Sensitive: Off',
    all_statuses: 'All statuses',
    newest: 'Newest',
    title: 'Title',
    status: 'Status',
    deadline: 'Deadline',
    has_attachment_only: 'Has attachment only',
    clear: 'Clear',
    search: 'Search'
}) %}

{% block admin_content %}
<div class="page-header">
    <h1 class="page-title">{{ selected_language != 'en' ? task_translation.ui.page_title : (viewer_context.candidate ? 'My Plan Tasks' : 'Plan Tasks') }}</h1>
    <p class="muted-text">
        {{ plan.user.firstName }} {{ plan.user.lastName }} - Plan #{{ plan.planId }}
    </p>
</div>

<div class="card card-immersive">
    <div class="section-header">
        <div>
            <h2 class="section-title">{{ selected_language != 'en' ? task_translation.ui.flow_title : 'Task Flow' }}</h2>
            <p class="section-kicker">{{ selected_language != 'en' ? task_translation.ui.flow_kicker : 'Stay focused on progress, deadlines, attachment status, and the next useful action.' }}</p>
        </div>
        <div class="section-actions">
            <a href="{{ path(plans_route) }}" class="btn-secondary">{{ task_index_ui.back_to_plans }}</a>
            {% if viewer_context.canCreateTasks %}
                <a href="{{ path(tasks_new_route, {id: plan.planId}) }}" class="btn-primary">{{ task_index_ui.add_task }}</a>
            {% endif %}
        </div>
    </div>

    <form method="get" action="{{ path(admin_area ? 'app_admin_plan_tasks' : 'app_workspace_plan_tasks', {id: plan.planId}) }}" class="search-form search-form-panel" data-live-search-form>
        <label for="tasks-search" class="search-label">{{ selected_language != 'en' ? task_translation.ui.find_task : 'Find a task' }}</label>
        <div class="search-controls">
            <input
                id="tasks-search"
                type="search"
                name="q"
                value="{{ search_term|default('') }}"
                class="search-input"
                autocomplete="off"
                placeholder="{{ task_index_ui.search_placeholder }}"
                data-live-search-input
            >
            <input type="hidden" name="lang" value="{{ selected_language }}">
            <input type="hidden" name="case_sensitive" value="{{ case_sensitive ? '1' : '0' }}" data-live-search-case-sensitive>
            <button
                type="button"
                class="search-toggle{{ case_sensitive ? ' active' : '' }}"
                data-live-search-toggle
                aria-pressed="{{ case_sensitive ? 'true' : 'false' }}"
            >
                {{ case_sensitive ? task_index_ui.case_on : task_index_ui.case_off }}
            </button>
            <select name="status" class="search-select">
                <option value="">{{ task_index_ui.all_statuses }}</option>
                {% for label, value in task_status_choices %}
                    <option value="{{ value }}" {{ selected_status == value ? 'selected' : '' }}>{{ task_translation.statuses[value] ?? label }}</option>
                {% endfor %}
            </select>
            <select name="sort" class="search-select">
                <option value="newest" {{ selected_sort == 'newest' ? 'selected' : '' }}>{{ task_index_ui.newest }}</option>
                <option value="title" {{ selected_sort == 'title' ? 'selected' : '' }}>{{ task_index_ui.title }}</option>
                <option value="status" {{ selected_sort == 'status' ? 'selected' : '' }}>{{ task_index_ui.status }}</option>
                <option value="deadline" {{ selected_sort == 'deadline' ? 'selected' : '' }}>{{ task_index_ui.deadline }}</option>
            </select>
            <label class="search-check">
                <input type="checkbox" name="attachment_only" value="1" {{ attachment_only ? 'checked' : '' }}>
                {{ task_index_ui.has_attachment_only }}
            </label>
            <button type="button" class="btn-secondary" data-live-search-clear>{{ task_index_ui.clear }}</button>
            <noscript>
                <button type="submit" class="btn-primary">{{ task_index_ui.search }}</button>
            </noscript>
        </div>
        <p class="search-hint">{{ selected_language != 'en' ? task_translation.ui.search_hint : 'Use search and filters to narrow the task flow instantly.' }}</p>
    </form>

    <div data-live-search-results>
        {% include 'admin/tasks/_results.html.twig' %}
    </div>
</div>
{% endblock %}
