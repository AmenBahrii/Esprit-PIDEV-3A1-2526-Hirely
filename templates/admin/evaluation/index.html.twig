{% extends 'base.html.twig' %}

{% block title %}All Evaluations - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">All Evaluations</h1>

            {% if evaluations is empty %}
                <div class="alert alert-info">
                    <p>No evaluations found.</p>
                </div>
            {% else %}
                <section class="workspace-toolbar mb-3">
                    <div class="workspace-toolbar-copy">
                        <span class="workspace-toolbar-label">Search and Sort</span>
                        <span class="workspace-toolbar-subtitle">Search by recruiter, candidate, job title, decision, or status and reorder the visible evaluations instantly.</span>
                    </div>

                    <div class="workspace-toolbar-controls">
                        <input type="search" id="admin-evaluation-search" class="search-input" placeholder="Search recruiter, candidate, or status">

                        <select id="admin-evaluation-sort" class="sort-select">
                            <option value="rating_desc">Highest rating first</option>
                            <option value="rating_asc">Lowest rating first</option>
                            <option value="recruiter_asc">Recruiter A to Z</option>
                            <option value="candidate_asc">Candidate A to Z</option>
                            <option value="job_asc">Job title A to Z</option>
                            <option value="status_asc">Status A to Z</option>
                        </select>
                    </div>
                </section>

                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="admin-evaluation-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Recruiter</th>
                                <th>Candidate</th>
                                <th>Job Offer</th>
                                <th>Overall Rating</th>
                                <th>Hire Decision</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="admin-evaluation-table-body">
                            {% for evaluation in evaluations %}
                                <tr data-search="{{
                                    ((evaluation.recruiter_first_name ~ ' ' ~ evaluation.recruiter_last_name) ~ ' ' ~
                                    (evaluation.candidate_first_name ~ ' ' ~ evaluation.candidate_last_name) ~ ' ' ~
                                    (evaluation.job_title ?? 'N/A') ~ ' ' ~
                                    evaluation.hire_decision ~ ' ' ~
                                    (evaluation.is_draft ? 'draft' : 'submitted'))
                                |lower }}">
                                    <td>
                                        {% if evaluation.recruiter_first_name or evaluation.recruiter_last_name %}
                                            {{ evaluation.recruiter_first_name }} {{ evaluation.recruiter_last_name }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if evaluation.candidate_first_name or evaluation.candidate_last_name %}
                                            {{ evaluation.candidate_first_name }} {{ evaluation.candidate_last_name }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ evaluation.job_title ?? 'N/A' }}
                                    </td>
                                    <td>
                                        <strong>{{ evaluation.overall_rating }}/10</strong>
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if evaluation.hire_decision == 'hire' %}bg-success
                                            {% elseif evaluation.hire_decision == 'no_hire' %}bg-danger
                                            {% elseif evaluation.hire_decision == 'maybe' %}bg-warning
                                            {% else %}bg-secondary
                                            {% endif %}">
                                            {{ evaluation.hire_decision|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if evaluation.is_draft %}bg-secondary
                                            {% else %}bg-success
                                            {% endif %}">
                                            {% if evaluation.is_draft %}Draft{% else %}Submitted{% endif %}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_evaluation_show', {'evaluationId': evaluation.evaluation_id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p id="admin-evaluation-empty-state" class="text-muted mt-2 d-none">No evaluations match your search.</p>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('admin-evaluation-search');
    const sortSelect = document.getElementById('admin-evaluation-sort');
    const tbody = document.getElementById('admin-evaluation-table-body');
    const emptyState = document.getElementById('admin-evaluation-empty-state');

    if (!searchInput || !sortSelect || !tbody || !emptyState) {
        return;
    }

    const rows = Array.from(tbody.querySelectorAll('tr'));

    function cellText(row, index) {
        return (row.cells[index]?.textContent || '').trim();
    }

    function parseRating(text) {
        const match = text.match(/([0-9]+(?:\.[0-9]+)?)/);
        return match ? parseFloat(match[1]) : 0;
    }

    function compareRows(a, b, sortKey) {
        switch (sortKey) {
            case 'rating_asc':
                return parseRating(cellText(a, 3)) - parseRating(cellText(b, 3));
            case 'rating_desc':
                return parseRating(cellText(b, 3)) - parseRating(cellText(a, 3));
            case 'recruiter_asc':
                return cellText(a, 0).localeCompare(cellText(b, 0));
            case 'candidate_asc':
                return cellText(a, 1).localeCompare(cellText(b, 1));
            case 'job_asc':
                return cellText(a, 2).localeCompare(cellText(b, 2));
            case 'status_asc':
                return cellText(a, 5).localeCompare(cellText(b, 5));
            default:
                return 0;
        }
    }

    function refreshRows() {
        const query = searchInput.value.trim().toLowerCase();
        const sortKey = sortSelect.value;

        const filteredRows = rows.filter(function (row) {
            const searchable = (row.dataset.search || '').toLowerCase();
            const match = query === '' || searchable.includes(query);
            row.classList.toggle('d-none', !match);
            return match;
        });

        filteredRows.sort(function (a, b) {
            return compareRows(a, b, sortKey);
        });

        filteredRows.forEach(function (row) {
            tbody.appendChild(row);
        });

        emptyState.classList.toggle('d-none', filteredRows.length > 0);
    }

    searchInput.addEventListener('input', refreshRows);
    sortSelect.addEventListener('change', refreshRows);
    refreshRows();
});
</script>
{% endblock %}
