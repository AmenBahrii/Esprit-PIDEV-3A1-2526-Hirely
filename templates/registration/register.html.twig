{% extends 'security/base_auth.html.twig' %}

{% block title %}Register - Hirely{% endblock %}

{% block body %}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <h2>Hirely</h2>
            <p>Create your account and choose how you want to sign in.</p>
        </div>

        <div class="flash-list">
            {% for message in app.flashes('success') %}
                <div class="flash flash-success">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash flash-error">{{ message }}</div>
            {% endfor %}
        </div>

        <a href="{{ path('app_google_connect') }}" class="btn btn-google login-btn">
            <span>Continue with Google</span>
        </a>

        <div class="divider">or create with email</div>

        {{ form_start(registrationForm) }}
        {{ form_errors(registrationForm) }}

        <div class="form-group">
            <label>First Name</label>
            {{ form_widget(registrationForm.firstName, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(registrationForm.firstName) }}
        </div>

        <div class="form-group">
            <label>Last Name</label>
            {{ form_widget(registrationForm.lastName, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(registrationForm.lastName) }}
        </div>

        <div class="form-group">
            <label>Email</label>
            {{ form_widget(registrationForm.email, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div class="form-group">
            <label>Password</label>
            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div class="form-group">
            <label>Account Type</label>
            {{ form_widget(registrationForm.role, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(registrationForm.role) }}
        </div>

        <div class="form-group">
            {{ form_row(registrationForm.agreeTerms) }}
        </div>

        <button class="btn btn-primary login-btn">
            Create Account
        </button>

        {{ form_end(registrationForm) }}

        <p class="signup-link">
            Already have an account?
            <a href="{{ path('app_login') }}">Login</a>
        </p>
    </div>
</div>

{% endblock %}
