<!DOCTYPE html>
<html>
<head>
    <title>{% block title %}Login{% endblock %}</title>
    <style>
        html, body {
            margin: 0;
            height: 100%;
        }
        .login-container {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #3b0a57, #6a1b9a);
}

.login-card {
    background: white;
    padding: 40px;
    border-radius: 20px;
    width: 360px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
}

.login-header {
    text-align: center;
    margin-bottom: 25px;
}

.login-header h2 {
    margin: 0;
    color: #3b0a57;
}

.login-header p {
    color: gray;
    font-size: 14px;
}
.btn {
            padding: 8px 14px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }

        .btn-primary {
    background: #ff6b35;
    color: white;
    padding: 19px 18px;
    border-radius: 12px;
    font-weight: 600;
}
.form-group {
    margin-bottom: 15px;
}

.form-input {
    width: 100%;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid #ddd;
    outline: none;
}

.form-input:focus {
    border-color: #6a1b9a;
}

.login-btn {
    width: 100%;
    margin-top: 10px;
}

.login-options {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 10px;
}

.error {
    background: #ffe6e6;
    color: red;
    padding: 10px;
    border-radius: 10px;
    margin-bottom: 15px;
}

.logged-in {
    font-size: 13px;
    margin-bottom: 10px;
}
    </style>
</head>
<body>

{% block body %}{% endblock %}

</body>
</html>