{% extends "base.html.twig" %}

{% block title %}Login - Hirely{% endblock %}

{% block content %}
    <div style="max-width: 400px; margin: 5rem auto;">
        <div class="card">
            <h2 style="margin-bottom: 2rem; text-align: center;">Login to Hirely</h2>

            {% if error %}
                <div class="alert alert-error">{{ error.messageKey }}</div>
            {% endif %}

            <form method="post">
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" value="{{ last_email }}" required autofocus>
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required>
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" name="_remember_me"> Remember me
                    </label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn" style="width: 100%; text-align: center;">Sign In</button>
            </form>

            <hr style="margin: 2rem 0; border: none; border-top: 1px solid #ddd;">
            <p style="text-align: center; font-size: 0.9rem;">
                Demo accounts:
                <br><strong>Recruiter:</strong> recruiter@example.com / password
                <br><strong>Candidate:</strong> candidate@example.com / password
            </p>
        </div>
    </div>
{% endblock %}
