{% extends 'base.html.twig' %}

{% block title %}My Interviews - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">My Interviews</h1>

            {% if interviews is empty %}
                <div class="alert alert-info">
                    <p>You don't have any scheduled interviews yet.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Recruiter</th>
                                <th>Job Offer</th>
                                <th>Interview Type</th>
                                <th>Scheduled Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for interview in interviews %}
                                <tr>
                                    <td>
                                        {% if interview.recruiter_id %}
                                            {{ interview.recruiter_id.firstName }} {{ interview.recruiter_id.lastName }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if interview.application_id.jobOffer %}
                                            {{ interview.application_id.jobOffer.title }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if interview.interview_type_id %}
                                            {{ interview.interview_type_id.type_name }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>{{ interview.scheduled_date.format('M d, Y') }}</td>
                                    <td>
                                        {% if interview.scheduled_time %}
                                            {{ interview.scheduled_time }}
                                        {% else %}
                                            Not set
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if interview.status == 'scheduled' %}bg-warning
                                            {% elseif interview.status == 'completed' %}bg-success
                                            {% elseif interview.status == 'cancelled' %}bg-danger
                                            {% endif %}">
                                            {{ interview.status|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_interview_show', {'interviewId': interview.interview_id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
