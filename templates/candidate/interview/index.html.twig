{% extends 'base.html.twig' %}

{% block title %}My Interviews - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">My Interviews</h1>

            {% if interviews is empty %}
                <div class="alert alert-info">
                    <p>You don't have any scheduled interviews yet.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Recruiter</th>
                                <th>Job Offer</th>
                                <th>Interview Type</th>
                                <th>Scheduled Date</th>
                                <th>Time</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for interview in interviews %}
                                <tr>
                                    <td>
                                        {% if interview.getRecruiter_id() %}
                                            {{ interview.getRecruiter_id().getFirstName() }} {{ interview.getRecruiter_id().getLastName() }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if interview.getApplication_id().getJobOffer() %}
                                            {{ interview.getApplication_id().getJobOffer().title }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if interview.getInterview_type_id() %}
                                            {{ interview.getInterview_type_id().getType_name() }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>{{ interview.getScheduled_date().format('M d, Y') }}</td>
                                    <td>
                                        {% if interview.getScheduled_time() %}
                                            {{ interview.getScheduled_time().format('H:i') }}
                                        {% else %}
                                            Not set
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if interview.getStatus() == 'scheduled' %}bg-warning
                                            {% elseif interview.getStatus() == 'completed' %}bg-success
                                            {% elseif interview.getStatus() == 'cancelled' %}bg-danger
                                            {% endif %}">
                                            {{ interview.getStatus()|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        <a href="{{ path('app_interview_show', {'interviewId': interview.getInterview_id()}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
