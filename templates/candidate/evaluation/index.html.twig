{% extends 'base.html.twig' %}

{% block title %}My Evaluations - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">My Interview Evaluations</h1>

            {% if evaluations is empty %}
                <div class="alert alert-info">
                    <p>You don't have any interview evaluations yet.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Recruiter</th>
                                <th>Job Offer</th>
                                <th>Overall Rating</th>
                                <th>Recommendation</th>
                                <th>Hire Decision</th>
                                <th>Evaluation Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for evaluation in evaluations %}
                                <tr>
                                    <td>
                                        {% if evaluation.recruiter_id %}
                                            {{ evaluation.recruiter_id.firstName }} {{ evaluation.recruiter_id.lastName }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if evaluation.interview_id.application_id.jobOffer %}
                                            {{ evaluation.interview_id.application_id.jobOffer.title }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        <strong>{{ evaluation.overall_rating }}/5</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ evaluation.recommendation|capitalize }}</span>
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if evaluation.hire_decision == 'hire' %}bg-success
                                            {% elseif evaluation.hire_decision == 'no_hire' %}bg-danger
                                            {% elseif evaluation.hire_decision == 'maybe' %}bg-warning
                                            {% else %}bg-secondary
                                            {% endif %}">
                                            {{ evaluation.hire_decision|capitalize }}
                                        </span>
                                    </td>
                                    <td>{{ evaluation.evaluated_at.format('M d, Y') }}</td>
                                    <td>
                                        <a href="{{ path('app_evaluation_show', {'evaluationId': evaluation.evaluation_id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
