{% extends "base.html.twig" %}

{% block title %}{{ action_title }} Interview - Hirely{% endblock %}

{% block content %}
    <h1>{{ action_title }} Interview</h1>

    <div class="card" style="max-width: 600px;">
        <form method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
            
            <div class="form-group">
                <label for="application_id">Select Candidate Application</label>
                <select id="application_id" name="application_id" required style="padding: 0.5rem; border: 1px solid #bdc3c7; border-radius: 4px; width: 100%;">
                    <option value="">-- Select Application --</option>
                    {% for app in applications %}
                        <option value="{{ app.id }}" {% if interview.application_id == app.id %}selected{% endif %}>
                            {{ app.candidate_name }} ({{ app.job_id }})
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label for="interview_type_id">Interview Type</label>
                <select id="interview_type_id" name="interview_type_id" required style="padding: 0.5rem; border: 1px solid #bdc3c7; border-radius: 4px; width: 100%;">
                    <option value="">-- Select Type --</option>
                    {% for type in interview_types %}
                        <option value="{{ type.id }}" {% if interview.interview_type_id == type.id %}selected{% endif %}>
                            {{ type.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group">
                <label for="schedule_date">Date & Time</label>
                <input type="datetime-local" id="schedule_date" name="schedule_date" 
                       value="{% if interview.schedule_date %}{{ interview.schedule_date | date('Y-m-d\\TH:i') }}{% endif %}" 
                       required style="padding: 0.5rem; border: 1px solid #bdc3c7; border-radius: 4px; width: 100%;">
            </div>

            <div class="form-group">
                <label for="format">Format</label>
                <select id="format" name="format" required style="padding: 0.5rem; border: 1px solid #bdc3c7; border-radius: 4px; width: 100%;">
                    <option value="in-person" {% if interview.format == 'in-person' %}selected{% endif %}>In-Person</option>
                    <option value="video" {% if interview.format == 'video' %}selected{% endif %}>Video Call</option>
                    <option value="phone" {% if interview.format == 'phone' %}selected{% endif %}>Phone Call</option>
                </select>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" id="location" name="location" placeholder="e.g., Building A, Room 101 or Zoom Link"
                       value="{{ interview.location | default('') }}" style="padding: 0.5rem; border: 1px solid #bdc3c7; border-radius: 4px; width: 100%;">
            </div>

            <div class="form-group">
                <label for="meeting_link">Meeting Link (if video/phone)</label>
                <input type="url" id="meeting_link" name="meeting_link" placeholder="https://zoom.us/..."
                       value="{{ interview.meeting_link | default('') }}" style="padding: 0.5rem; border: 1px solid #bdc3c7; border-radius: 4px; width: 100%;">
            </div>

            <div class="form-group">
                <label for="status">Status</label>
                <select id="status" name="status" style="padding: 0.5rem; border: 1px solid #bdc3c7; border-radius: 4px; width: 100%;">
                    <option value="scheduled" {% if interview.status == 'scheduled' %}selected{% endif %}>Scheduled</option>
                    <option value="completed" {% if interview.status == 'completed' %}selected{% endif %}>Completed</option>
                    <option value="cancelled" {% if interview.status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                </select>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                <button type="submit" class="btn" style="flex: 1;">{{ button_text }}</button>
                <a href="{{ path('app_interviews') }}" class="btn btn-secondary" style="flex: 1; text-align: center; padding: 0.75rem;">Cancel</a>
            </div>
        </form>
    </div>

    <div style="margin-top: 2rem;">
        <a href="{{ path('app_interviews') }}" class="btn btn-secondary">Back to Interviews</a>
    </div>

    <style>
        .form-group {
            display: flex;
            flex-direction: column;
        }
        .form-group label {
            font-weight: 600;
            margin-bottom: 0.5rem;
            color: #2c3e50;
        }
    </style>
{% endblock %}
