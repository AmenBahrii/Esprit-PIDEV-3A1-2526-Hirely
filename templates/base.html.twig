<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Hirely{% endblock %}</title>

    <style>
:root {
    --ink: #202124;
    --muted: #68706d;
    --line: #dde6e1;
    --surface: #ffffff;
    --soft: #f4f8f6;
    --soft-strong: #e8f2ee;
    --accent: #ff6b35;
    --accent-dark: #df5725;
    --green: #921c7a;
    --green-dark: #340b2f;
    --green-soft: #dff5ec;
    --red: #d64545;
    --red-soft: #ffe7e7;
    --amber: #b7791f;
    --amber-soft: #fff1d8;
    --shadow: 0 18px 45px rgba(32, 33, 36, 0.08);
    --shadow-soft: 0 10px 25px rgba(32, 33, 36, 0.06);
}

* {
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
    margin: 0;
}

body {
    font-family: Inter, Arial, sans-serif;
    background:
        linear-gradient(135deg, rgba(29, 107, 86, 0.08), transparent 38%),
        linear-gradient(225deg, rgba(255, 107, 53, 0.08), transparent 34%),
        #f6f8f7;
    color: var(--ink);
}

a {
    color: inherit;
}

.container {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 264px;
    color: #fff;
    padding: 24px 18px;
    min-height: 100vh;
    position: sticky;
    top: 0;
    background:
        linear-gradient(145deg, rgba(255, 107, 53, 0.18), transparent 42%),
        linear-gradient(180deg, var(--green-dark), #102c27);
    box-shadow: 12px 0 35px rgba(20, 63, 52, 0.18);
    animation: slideIn 0.45s ease both;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    padding: 10px 8px;
    font-size: 24px;
    letter-spacing: 0;
}

.logo-img {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    object-fit: cover;
    background: #fff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
}

.sidebar a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 11px 12px;
    margin-bottom: 8px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.sidebar a:hover,
.sidebar a.active {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    transform: translateX(4px);
}

.sidebar a.active {
    box-shadow: inset 3px 0 0 var(--accent);
}

.main {
    flex: 1;
    min-width: 0;
    padding: 28px;
    animation: fadeUp 0.45s ease both;
}

.top-nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
}

.profile-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
}

.profile-box {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 52px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.profile-box:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 107, 53, 0.35);
    box-shadow: var(--shadow);
}

.profile-img,
.profile-placeholder,
.user-avatar,
.user-avatar-placeholder,
.avatar-small {
    width: 42px;
    height: 42px;
    border-radius: 50%;
}

.profile-img,
.user-avatar,
.avatar-small {
    object-fit: cover;
}

.profile-placeholder,
.user-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    font-weight: 800;
}

.profile-name,
.user-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--ink);
}

.profile-role,
.user-email {
    color: var(--muted);
    font-size: 12px;
}

.logout-btn {
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--red);
    background: var(--red-soft);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease;
}

.logout-btn:hover {
    transform: translateY(-2px);
    background: #ffd6d6;
}

.header {
    font-size: 28px;
    font-weight: 850;
    letter-spacing: 0;
}

.sub-header {
    color: var(--muted);
    margin: 6px 0 20px;
}

.card,
.settings-card,
.login-card {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(221, 230, 225, 0.9);
    border-radius: 8px;
    box-shadow: var(--shadow);
}

.card {
    padding: 24px;
    margin-top: 20px;
    animation: fadeUp 0.45s ease both;
}

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
}

.top-bar h3 {
    margin: 0;
    font-size: 20px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 9px 14px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 10px 22px rgba(255, 107, 53, 0.24);
}

.btn-primary:hover {
    background: var(--accent-dark);
}

.btn-secondary {
    background: var(--soft-strong);
    color: var(--green-dark);
}

.btn-edit,
.btn-view {
    background: #edf3ff;
    color: #3658a8;
}

.btn-delete,
.btn-danger {
    background: var(--red-soft);
    color: var(--red);
}

.btn-success,
.btn-tasks {
    background: var(--green-soft);
    color: var(--green);
}

.big-btn {
    min-height: 46px;
    padding: 12px 18px;
    font-size: 15px;
}

.filters,
.filter-form {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
}

.search-input,
.sort-select,
.form-input {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-input {
    flex: 1;
}

.sort-select {
    width: auto;
}

.search-input:focus,
.sort-select:focus,
.form-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.16);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
}

.form-group.full {
    grid-column: span 2;
}

.form-error,
.form-error ul,
.form-group ul {
    color: var(--red);
    font-size: 12px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
}

.status,
.status-pill,
.role-badge,
.dashboard-pill {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
}

.status-accepted,
.status-open,
.status-pill {
    background: var(--green-soft);
    color: var(--green);
}

.status-pending {
    background: var(--amber-soft);
    color: var(--amber);
}

.status-rejected,
.status-closed {
    background: var(--red-soft);
    color: var(--red);
}

.role-badge,
.dashboard-pill {
    background: var(--soft-strong);
    color: var(--green-dark);
}

.role-admin {
    background: var(--red-soft);
    color: var(--red);
}

.role-recruiter {
    background: #edf3ff;
    color: #3658a8;
}

.role-candidate {
    background: var(--green-soft);
    color: var(--green);
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 18px;
}

.data-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 8px 20px rgba(32, 33, 36, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    animation: fadeUp 0.45s ease both;
}

.data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(29, 107, 86, 0.3);
    box-shadow: var(--shadow-soft);
}

.data-card-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
}

.data-card-title {
    margin: 0;
    font-size: 18px;
    color: var(--ink);
}

.data-card-subtitle,
.data-card-label {
    color: var(--muted);
    font-size: 12px;
}

.data-card-subtitle {
    margin-top: 4px;
}

.data-card-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.data-card-field {
    min-width: 0;
}

.data-card-label {
    display: block;
    margin-bottom: 3px;
    font-weight: 700;
}

.data-card-value {
    color: var(--ink);
    font-size: 14px;
    overflow-wrap: anywhere;
}

.data-card-actions,
.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
}

.empty-state {
    background: var(--soft);
    border: 1px dashed var(--line);
    border-radius: 8px;
    padding: 22px;
    color: var(--muted);
    text-align: center;
}

table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px;
}

th {
    text-align: left;
    color: var(--muted);
    font-size: 13px;
}

td {
    background: #fff;
    padding: 16px;
    font-size: 14px;
}

tbody tr:hover td {
    background: var(--soft);
}

tr td:first-child {
    border-radius: 8px 0 0 8px;
}

tr td:last-child {
    border-radius: 0 8px 8px 0;
}

.profile-section {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 24px;
}

.profile-big,
.profile-placeholder-big {
    width: 80px;
    height: 80px;
    border-radius: 50%;
}

.profile-big {
    object-fit: cover;
}

.profile-placeholder-big {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--soft-strong);
    color: var(--green-dark);
    font-weight: 800;
    font-size: 20px;
}

.profile-info h2 {
    margin: 0;
}

.form-section {
    margin-bottom: 24px;
}

.form-section h4 {
    margin-bottom: 10px;
    color: var(--muted);
}

.form-actions {
    margin-top: 20px;
}

.settings-wrapper {
    width: 100%;
    min-height: 100vh;
    padding: 40px 20px;
}

.settings-card {
    width: 100%;
    padding: 28px;
}

.login-container {
    min-height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        linear-gradient(135deg, rgba(29, 107, 86, 0.2), transparent 40%),
        #f6f8f7;
}

.login-card {
    width: 360px;
    padding: 34px;
}

.login-header {
    text-align: center;
    margin-bottom: 24px;
}

.login-header h2 {
    margin: 0;
    color: var(--green-dark);
}

.login-header p {
    color: var(--muted);
    font-size: 14px;
}

.login-btn {
    width: 100%;
    margin-top: 10px;
}

.login-options {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 10px;
}

.error {
    background: var(--red-soft);
    color: var(--red);
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 15px;
}

.logged-in {
    font-size: 13px;
    margin-bottom: 10px;
}

.page-flashes {
    display: grid;
    gap: 12px;
    margin-bottom: 18px;
}

.page-flash {
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: var(--shadow-soft);
}

.page-flash-success {
    background: var(--green-soft);
    color: var(--green);
}

.page-flash-error {
    background: var(--red-soft);
    color: var(--red);
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-18px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}

@media (max-width: 900px) {
    .container {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .logo {
        grid-column: 1 / -1;
        margin-bottom: 8px;
    }

    .sidebar a {
        margin: 0;
    }

    .main {
        padding: 18px;
    }
}

@media (max-width: 700px) {
    .top-nav,
    .top-bar,
    .filters,
    .filter-form,
    .profile-wrapper {
        align-items: stretch;
        flex-direction: column;
    }

    .top-nav {
        justify-content: flex-start;
    }

    .form-grid,
    .data-card-body {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .sort-select {
        width: 100%;
    }
}
    </style>
</head>

<body>
<div class="container">
    {% if app.user %}
        <aside class="sidebar">
            <h2 class="logo">
                <img src="/images/logo.png" class="logo-img" alt="Hirely logo">
                <span>Hirely</span>
            </h2>

            <a href="#" class="{{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'active' : '' }}">
                Home
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_users_index') }}"
                   class="{{ app.request.attributes.get('_route') starts with 'app_users' ? 'active' : '' }}">
                    Users
                </a>

                <a href="{{ path('app_role_index') }}"
                   class="{{ app.request.attributes.get('_route') starts with 'app_role' ? 'active' : '' }}">
                    Roles
                </a>
            {% endif %}

            <a href="{{ path('app_joboffer_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_joboffer' ? 'active' : '' }}">
                Job Offers
            </a>

            <a href="{{ path('app_application_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_application' ? 'active' : '' }}">
                Applications
            </a>
        </aside>
    {% endif %}

    <main class="main">
        {% if app.user and (show_topbar is not defined or show_topbar != false) %}
            <div class="top-nav">
                <div class="profile-wrapper">
                    <a href="{{ path('app_users_edit', {'id': app.user.id}) }}" class="profile-box">
                        {% if app.user.profilePic %}
                            <img src="{{ asset(app.user.profilePic) }}" class="profile-img" alt="{{ app.user.firstName }} {{ app.user.lastName }}">
                        {% else %}
                            <div class="profile-placeholder">
                                {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                            </div>
                        {% endif %}

                        <div>
                            <div class="profile-name">
                                {{ app.user.firstName }} {{ app.user.lastName }}
                            </div>
                            <small class="profile-role">
                                {{ app.user.role ? app.user.role.name : 'User' }}
                            </small>
                        </div>
                    </a>

                    <a href="{{ path('app_logout') }}" class="logout-btn">
                        Logout
                    </a>
                </div>
            </div>
        {% endif %}

        <div class="page-flashes">
            {% for message in app.flashes('success') %}
                <div class="page-flash page-flash-success">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="page-flash page-flash-error">{{ message }}</div>
            {% endfor %}
        </div>

        {% block body %}{% endblock %}
    </main>
</div>
{% block javascripts %}{% endblock %}
</body>
</html>
