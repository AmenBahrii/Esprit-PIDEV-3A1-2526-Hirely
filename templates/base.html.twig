<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Hirely{% endblock %}</title>

    <style>
:root {
    --ink: #25214f;
    --muted: #8c8aa8;
    --line: rgba(120, 112, 170, 0.16);
    --surface: rgba(255, 255, 255, 0.88);
    --soft: rgba(255, 255, 255, 0.62);
    --soft-strong: #eeecff;
    --accent: #ff6b35;
    --accent-dark: #ec5a25;
    --green: #2a9352;
    --green-dark: #25214f;
    --green-soft: #dff5e6;
    --red: #d64545;
    --red-soft: #ffe7e7;
    --amber: #b7791f;
    --amber-soft: #fff1d8;
    --shadow: 0 24px 60px rgba(64, 51, 116, 0.10);
    --shadow-soft: 0 12px 30px rgba(64, 51, 116, 0.08);
}

* {
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
    margin: 0;
}

body {
    font-family: Poppins, "Segoe UI", Arial, sans-serif;
    background:
        radial-gradient(circle at top left, rgba(255, 209, 184, 0.72), transparent 24%),
        radial-gradient(circle at top right, rgba(230, 226, 255, 0.8), transparent 28%),
        radial-gradient(circle at center left, rgba(228, 220, 255, 0.72), transparent 32%),
        linear-gradient(135deg, #faf7ff 0%, #f8f8ff 45%, #fdf7f5 100%);
    color: var(--ink);
}

a {
    color: inherit;
}

.container {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 264px;
    color: #fff;
    padding: 24px 18px;
    min-height: 100vh;
    position: sticky;
    top: 0;
    background:
        linear-gradient(145deg, rgba(255, 107, 53, 0.18), transparent 42%),
        linear-gradient(180deg, var(--green-dark), #102c27);
    box-shadow: 12px 0 35px rgba(20, 63, 52, 0.18);
    animation: slideIn 0.45s ease both;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 28px;
    padding: 10px 8px;
    font-size: 24px;
    letter-spacing: 0;
}

.logo-img {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    object-fit: cover;
    background: #fff;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
}

.sidebar a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 11px 12px;
    margin-bottom: 8px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.sidebar a:hover,
.sidebar a.active {
    color: #fff;
    background: rgba(255, 255, 255, 0.14);
    transform: translateX(4px);
}

.sidebar a.active {
    box-shadow: inset 3px 0 0 var(--accent);
}

.main {
    flex: 1;
    min-width: 0;
    padding: 28px;
    animation: fadeUp 0.45s ease both;
}

.workspace-shell {
    width: 100%;
    max-width: 1420px;
    margin: 0 auto;
}

.workspace-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding: 22px 24px;
    margin-bottom: 22px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(18px);
    box-shadow: var(--shadow);
}

.workspace-topbar-copy {
    max-width: 620px;
}

.workspace-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.workspace-eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ff7f5c;
    box-shadow: 0 0 0 5px rgba(255, 127, 92, 0.12);
}

.workspace-title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
}

.workspace-subtitle {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 16px;
}

.workspace-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 14px;
    flex-wrap: wrap;
}

.workspace-select,
.workspace-profile,
.workspace-logout,
.workspace-nav-link {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.76);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-soft);
}

.workspace-select {
    min-width: 160px;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 18px;
    color: var(--green-dark);
    font: inherit;
    font-weight: 600;
}

.workspace-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    border-radius: 20px;
    text-decoration: none;
}

.workspace-profile-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.workspace-role-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 107, 53, 0.12);
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.workspace-profile-name {
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 700;
}

.workspace-logout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 18px;
    color: var(--green-dark);
    font-weight: 700;
    text-decoration: none;
}

.workspace-nav {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.workspace-nav-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    color: var(--green-dark);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.workspace-nav-link:hover {
    transform: translateY(-2px);
}

.workspace-nav-link.active {
    border-color: rgba(255, 107, 53, 0.32);
    background: linear-gradient(135deg, rgba(255, 245, 240, 0.96), rgba(255, 255, 255, 0.85));
    color: var(--green-dark);
}

.workspace-nav-link.disabled {
    opacity: 0.55;
    cursor: default;
}

.workspace-page {
    display: grid;
    gap: 26px;
}

.workspace-card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
}

.workspace-hero {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: center;
    padding: 34px;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 32px;
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.82), rgba(255, 247, 243, 0.64)),
        radial-gradient(circle at right center, rgba(255, 183, 150, 0.26), transparent 28%);
    box-shadow: var(--shadow);
}

.workspace-hero-copy {
    max-width: 780px;
}

.workspace-kicker {
    margin: 0 0 14px;
    color: var(--accent);
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.workspace-section-title {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
}

.workspace-section-copy {
    margin: 12px 0 0;
    color: #6e6b8f;
    font-size: 16px;
}

.workspace-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 18px 20px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 26px;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: var(--shadow-soft);
}

.workspace-toolbar-copy {
    display: grid;
    gap: 4px;
}

.workspace-toolbar-label {
    color: var(--accent);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.workspace-toolbar-subtitle {
    color: #787596;
    font-size: 15px;
}

.workspace-toolbar-controls {
    display: flex;
    gap: 12px;
    width: 100%;
    justify-content: flex-end;
}

.workspace-metric-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.workspace-card {
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: 28px;
    background:
        linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(255, 247, 244, 0.72)),
        radial-gradient(circle at top right, rgba(255, 211, 191, 0.32), transparent 24%);
    box-shadow: var(--shadow);
}

.workspace-card-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 18px;
}

.workspace-card-summary {
    margin: 12px 0 0;
    color: #7d7a99;
}

.workspace-meta-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.workspace-meta {
    padding: 16px 18px;
    border: 1px solid rgba(227, 223, 255, 0.82);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.78);
}

.workspace-meta-label {
    display: block;
    margin-bottom: 8px;
    color: #9b99b6;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}

.workspace-meta-value {
    color: var(--green-dark);
    font-size: 15px;
    font-weight: 700;
    overflow-wrap: anywhere;
}

.workspace-card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
}

.admin-shell {
    display: flex;
    gap: 28px;
    width: 100%;
    max-width: 1560px;
    margin: 0 auto;
}

.admin-sidebar {
    width: 270px;
    flex: 0 0 270px;
    min-height: calc(100vh - 56px);
    padding: 22px 18px;
    border-radius: 30px;
    background:
        linear-gradient(180deg, rgba(95, 48, 110, 0.96), rgba(36, 25, 93, 0.98));
    color: #fff;
    box-shadow: 0 30px 70px rgba(48, 26, 94, 0.28);
}

.admin-brand {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    padding: 10px 12px;
}

.admin-brand-mark {
    width: 48px;
    height: 48px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    font-size: 26px;
}

.admin-brand-title {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
}

.admin-brand-copy {
    color: rgba(255, 255, 255, 0.72);
    font-size: 14px;
    font-weight: 600;
}

.admin-panel {
    margin-bottom: 22px;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
}

.admin-panel-label {
    color: rgba(255, 255, 255, 0.62);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.admin-panel-title {
    margin: 10px 0 8px;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.35;
}

.admin-panel-meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    color: rgba(255, 255, 255, 0.76);
    font-size: 14px;
    font-weight: 600;
}

.admin-nav {
    display: grid;
    gap: 10px;
}

.admin-nav-link {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0 18px;
    border-radius: 18px;
    color: rgba(255, 255, 255, 0.86);
    text-decoration: none;
    font-size: 15px;
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    border: 1px solid transparent;
}

.admin-nav-link:hover {
    transform: translateX(3px);
    background: rgba(255, 255, 255, 0.08);
}

.admin-nav-link.active {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.08);
    position: relative;
}

.admin-nav-link.active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    bottom: 12px;
    width: 4px;
    border-radius: 999px;
    background: var(--accent);
}

.admin-nav-link.disabled {
    opacity: 0.5;
}

.admin-main {
    flex: 1;
    min-width: 0;
}

.admin-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    padding: 26px 24px;
    margin-bottom: 18px;
    border: 1px solid rgba(255, 255, 255, 0.76);
    border-radius: 30px;
    background: rgba(255, 255, 255, 0.76);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
}

.admin-topbar-copy {
    max-width: 620px;
}

.admin-topbar-eyebrow {
    color: var(--muted);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.admin-topbar-eyebrow::after {
    content: " • Live Workspace";
}

.admin-topbar-title {
    margin: 10px 0 0;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
}

.admin-topbar-subtitle {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 16px;
}

.admin-metrics {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
}

.admin-metric-card {
    min-height: 120px;
    padding: 22px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 26px;
    background:
        radial-gradient(circle at top right, rgba(255, 214, 198, 0.58), transparent 20%),
        rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-soft);
}

.admin-metric-label {
    color: #767692;
    font-size: 13px;
    font-weight: 700;
}

.admin-metric-value {
    margin-top: 10px;
    color: var(--green-dark);
    font-size: 32px;
    font-weight: 800;
}

.top-nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
}

.profile-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
}

.profile-box {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 52px;
    padding: 8px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: var(--shadow-soft);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.profile-box:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 107, 53, 0.35);
    box-shadow: var(--shadow);
}

.profile-img,
.profile-placeholder,
.user-avatar,
.user-avatar-placeholder,
.avatar-small {
    width: 42px;
    height: 42px;
    border-radius: 50%;
}

.profile-img,
.user-avatar,
.avatar-small {
    object-fit: cover;
}

.profile-placeholder,
.user-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: #fff;
    font-weight: 800;
}

.profile-name,
.user-name {
    font-size: 14px;
    font-weight: 800;
    color: var(--ink);
}

.profile-role,
.user-email {
    color: var(--muted);
    font-size: 12px;
}

.logout-btn {
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--red);
    background: var(--red-soft);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
    transition: transform 0.2s ease, background 0.2s ease;
}

.logout-btn:hover {
    transform: translateY(-2px);
    background: #ffd6d6;
}

.header {
    font-size: 28px;
    font-weight: 850;
    letter-spacing: 0;
}

.sub-header {
    color: var(--muted);
    margin: 6px 0 20px;
}

.card,
.settings-card,
.login-card {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(221, 230, 225, 0.9);
    border-radius: 8px;
    box-shadow: var(--shadow);
}

.card {
    padding: 24px;
    margin-top: 20px;
    animation: fadeUp 0.45s ease both;
}

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
}

.top-bar h3 {
    margin: 0;
    font-size: 20px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 38px;
    padding: 9px 14px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    font-size: 14px;
    font-weight: 750;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 10px 22px rgba(255, 107, 53, 0.24);
}

.btn-primary:hover {
    background: var(--accent-dark);
}

.btn-secondary {
    background: var(--soft-strong);
    color: var(--green-dark);
}

.btn-edit,
.btn-view {
    background: #edf3ff;
    color: #3658a8;
}

.btn-delete,
.btn-danger {
    background: var(--red-soft);
    color: var(--red);
}

.btn-success,
.btn-tasks {
    background: var(--green-soft);
    color: var(--green);
}

.big-btn {
    min-height: 46px;
    padding: 12px 18px;
    font-size: 15px;
}

.filters,
.filter-form {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
}

.search-input,
.sort-select,
.form-input {
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.search-input {
    flex: 1;
}

.sort-select {
    width: auto;
}

.search-input:focus,
.sort-select:focus,
.form-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.16);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 14px;
}

.form-group.full {
    grid-column: span 2;
}

.form-error,
.form-error ul,
.form-group ul {
    color: var(--red);
    font-size: 12px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
}

.status,
.status-pill,
.role-badge,
.dashboard-pill {
    display: inline-flex;
    align-items: center;
    min-height: 26px;
    padding: 5px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
}

.status-accepted,
.status-open,
.status-pill {
    background: var(--green-soft);
    color: var(--green);
}

.status-pending {
    background: var(--amber-soft);
    color: var(--amber);
}

.status-rejected,
.status-closed {
    background: var(--red-soft);
    color: var(--red);
}

.role-badge,
.dashboard-pill {
    background: var(--soft-strong);
    color: var(--green-dark);
}

.role-admin {
    background: var(--red-soft);
    color: var(--red);
}

.role-recruiter {
    background: #edf3ff;
    color: #3658a8;
}

.role-candidate {
    background: var(--green-soft);
    color: var(--green);
}

.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 18px;
}

.data-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 8px 20px rgba(32, 33, 36, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    animation: fadeUp 0.45s ease both;
}

.data-card:hover {
    transform: translateY(-4px);
    border-color: rgba(29, 107, 86, 0.3);
    box-shadow: var(--shadow-soft);
}

.data-card-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
}

.data-card-title {
    margin: 0;
    font-size: 18px;
    color: var(--ink);
}

.data-card-subtitle,
.data-card-label {
    color: var(--muted);
    font-size: 12px;
}

.data-card-subtitle {
    margin-top: 4px;
}

.data-card-body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.data-card-field {
    min-width: 0;
}

.data-card-label {
    display: block;
    margin-bottom: 3px;
    font-weight: 700;
}

.data-card-value {
    color: var(--ink);
    font-size: 14px;
    overflow-wrap: anywhere;
}

.data-card-actions,
.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
}

.empty-state {
    background: var(--soft);
    border: 1px dashed var(--line);
    border-radius: 8px;
    padding: 22px;
    color: var(--muted);
    text-align: center;
}

table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px;
}

th {
    text-align: left;
    color: var(--muted);
    font-size: 13px;
}

td {
    background: #fff;
    padding: 16px;
    font-size: 14px;
}

tbody tr:hover td {
    background: var(--soft);
}

tr td:first-child {
    border-radius: 8px 0 0 8px;
}

tr td:last-child {
    border-radius: 0 8px 8px 0;
}

.profile-section {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 24px;
}

.profile-big,
.profile-placeholder-big {
    width: 80px;
    height: 80px;
    border-radius: 50%;
}

.profile-big {
    object-fit: cover;
}

.profile-placeholder-big {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--soft-strong);
    color: var(--green-dark);
    font-weight: 800;
    font-size: 20px;
}

.profile-info h2 {
    margin: 0;
}

.form-section {
    margin-bottom: 24px;
}

.form-section h4 {
    margin-bottom: 10px;
    color: var(--muted);
}

.form-actions {
    margin-top: 20px;
}

.settings-wrapper {
    width: 100%;
    min-height: 100vh;
    padding: 40px 20px;
}

.settings-card {
    width: 100%;
    padding: 28px;
}

.login-container {
    min-height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        linear-gradient(135deg, rgba(29, 107, 86, 0.2), transparent 40%),
        #f6f8f7;
}

.login-card {
    width: 360px;
    padding: 34px;
}

.login-header {
    text-align: center;
    margin-bottom: 24px;
}

.login-header h2 {
    margin: 0;
    color: var(--green-dark);
}

.login-header p {
    color: var(--muted);
    font-size: 14px;
}

.login-btn {
    width: 100%;
    margin-top: 10px;
}

.login-options {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 10px;
}

.error {
    background: var(--red-soft);
    color: var(--red);
    padding: 10px;
    border-radius: 8px;
    margin-bottom: 15px;
}

.logged-in {
    font-size: 13px;
    margin-bottom: 10px;
}

.page-flashes {
    display: grid;
    gap: 12px;
    margin-bottom: 18px;
}

.page-flash {
    border-radius: 8px;
    padding: 12px 14px;
    font-size: 14px;
    font-weight: 600;
    box-shadow: var(--shadow-soft);
}

.page-flash-success {
    background: var(--green-soft);
    color: var(--green);
}

.page-flash-error {
    background: var(--red-soft);
    color: var(--red);
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-18px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
    }
}

@media (max-width: 900px) {
    .container {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
        min-height: auto;
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .logo {
        grid-column: 1 / -1;
        margin-bottom: 8px;
    }

    .sidebar a {
        margin: 0;
    }

    .main {
        padding: 18px;
    }

    .workspace-topbar,
    .workspace-hero,
    .workspace-toolbar {
        grid-template-columns: 1fr;
        flex-direction: column;
        align-items: stretch;
    }

    .workspace-controls,
    .workspace-toolbar-controls {
        justify-content: stretch;
    }

    .workspace-select,
    .workspace-logout,
    .workspace-profile {
        width: 100%;
    }

    .workspace-card-grid,
    .admin-metrics {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    .top-nav,
    .top-bar,
    .filters,
    .filter-form,
    .profile-wrapper {
        align-items: stretch;
        flex-direction: column;
    }

    .top-nav {
        justify-content: flex-start;
    }

    .form-grid,
    .data-card-body,
    .workspace-meta-grid,
    .workspace-metric-grid,
    .workspace-card-grid,
    .admin-metrics {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .sort-select {
        width: 100%;
    }
}
    </style>
</head>

<body>
{% set currentRole = app.user and app.user.role ? app.user.role.name|lower : '' %}
{% set currentRoute = app.request.attributes.get('_route') ?? '' %}
<div class="container">
    {% if app.user and currentRole not in ['candidate', 'recruiter', 'admin'] %}
        <aside class="sidebar">
            <h2 class="logo">
                <img src="/images/logo.png" class="logo-img" alt="Hirely logo">
                <span>Hirely</span>
            </h2>

            <a href="#" class="{{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'active' : '' }}">
                Home
            </a>

            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_users_index') }}"
                   class="{{ app.request.attributes.get('_route') starts with 'app_users' ? 'active' : '' }}">
                    Users
                </a>

                <a href="{{ path('app_role_index') }}"
                   class="{{ app.request.attributes.get('_route') starts with 'app_role' ? 'active' : '' }}">
                    Roles
                </a>
            {% endif %}

            <a href="{{ path('app_joboffer_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_joboffer' ? 'active' : '' }}">
                Job Offers
            </a>

            <a href="{{ path('app_application_index') }}"
               class="{{ app.request.attributes.get('_route') starts with 'app_application' ? 'active' : '' }}">
                Applications
            </a>
        </aside>
    {% endif %}

    <main class="main">
        {% if app.user and currentRole == 'admin' %}
            <div class="admin-shell">
                <aside class="admin-sidebar">
                    <div class="admin-brand">
                        <div class="admin-brand-mark">✳</div>
                        <div>
                            <h2 class="admin-brand-title">Hirely</h2>
                            <div class="admin-brand-copy">Admin Backend</div>
                        </div>
                    </div>

                    <div class="admin-panel">
                        <div class="admin-panel-label">Control Center</div>
                        <div class="admin-panel-title">Workspace ready</div>
                        <div class="admin-panel-meta">
                            <span>Role mode</span>
                            <span>Synchronized</span>
                        </div>
                    </div>

                    <nav class="admin-nav" aria-label="Admin">
                        <a href="#"
                           class="admin-nav-link {{ currentRoute in ['app_users_index', 'app_role_index', 'app_joboffer_index', 'app_application_index'] ? 'active' : '' }}">
                            Dashboard
                        </a>
                        <span class="admin-nav-link disabled">Onboarding Plans</span>
                        <a href="{{ path('app_joboffer_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_joboffer' ? 'active' : '' }}">Job Offers</a>
                        <a href="{{ path('app_application_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_application' ? 'active' : '' }}">Applications</a>
                        <a href="{{ path('app_users_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_users' ? 'active' : '' }}">Users</a>
                        <a href="{{ path('app_role_index') }}" class="admin-nav-link {{ currentRoute starts with 'app_role' ? 'active' : '' }}">Roles</a>
                    </nav>
                </aside>

                <div class="admin-main">
                    <header class="admin-topbar">
                        <div class="admin-topbar-copy">
                            <div class="admin-topbar-eyebrow">{{ block('workspace_eyebrow') }}</div>
                            <h1 class="admin-topbar-title">{{ block('workspace_title') }}</h1>
                            <p class="admin-topbar-subtitle">{{ block('workspace_subtitle') }}</p>
                        </div>

                        <div class="workspace-controls">
                            <select class="workspace-select" aria-label="Language">
                                <option selected>English</option>
                            </select>

                            <a href="{{ path('app_users_edit', {'id': app.user.id}) }}" class="workspace-profile">
                                {% if app.user.profilePic %}
                                    <img src="{{ asset(app.user.profilePic) }}" class="profile-img" alt="{{ app.user.firstName }} {{ app.user.lastName }}">
                                {% else %}
                                    <div class="profile-placeholder">
                                        {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                                    </div>
                                {% endif %}

                                <div class="workspace-profile-copy">
                                    <span class="workspace-role-badge">Admin</span>
                                    <span class="workspace-profile-name">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                                </div>
                            </a>

                            <a href="{{ path('app_logout') }}" class="workspace-logout">Logout</a>
                        </div>
                    </header>

                    <div class="page-flashes">
                        {% for message in app.flashes('success') %}
                            <div class="page-flash page-flash-success">{{ message }}</div>
                        {% endfor %}

                        {% for message in app.flashes('error') %}
                            <div class="page-flash page-flash-error">{{ message }}</div>
                        {% endfor %}
                    </div>

                    {{ block('body') }}
                </div>
            </div>
        {% elseif app.user and currentRole in ['candidate', 'recruiter'] %}
            <div class="workspace-shell">
                <header class="workspace-topbar">
                    <div class="workspace-topbar-copy">
                        <div class="workspace-eyebrow">
                            {{ block('workspace_eyebrow') }}
                        </div>
                        <h1 class="workspace-title">{{ block('workspace_title') }}</h1>
                        <p class="workspace-subtitle">{{ block('workspace_subtitle') }}</p>
                    </div>

                    <div class="workspace-controls">
                        <select class="workspace-select" aria-label="Language">
                            <option selected>English</option>
                        </select>

                        <a href="{{ path('app_users_edit', {'id': app.user.id}) }}" class="workspace-profile">
                            {% if app.user.profilePic %}
                                <img src="{{ asset(app.user.profilePic) }}" class="profile-img" alt="{{ app.user.firstName }} {{ app.user.lastName }}">
                            {% else %}
                                <div class="profile-placeholder">
                                    {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                                </div>
                            {% endif %}

                            <div class="workspace-profile-copy">
                                <span class="workspace-role-badge">{{ currentRole }}</span>
                                <span class="workspace-profile-name">{{ app.user.firstName }} {{ app.user.lastName }}</span>
                            </div>
                        </a>

                        <a href="{{ path('app_logout') }}" class="workspace-logout">Logout</a>
                    </div>
                </header>

                <nav class="workspace-nav" aria-label="Primary">
                    <a href="{{ path('app_joboffer_index') }}" class="workspace-nav-link {{ currentRoute starts with 'app_joboffer' ? 'active' : '' }}">Job Offers</a>
                    <a href="{{ path('app_application_index') }}" class="workspace-nav-link {{ currentRoute starts with 'app_application' ? 'active' : '' }}">Applications</a>
                    <span class="workspace-nav-link disabled">Onboarding Plans</span>
                </nav>

                <div class="page-flashes">
                    {% for message in app.flashes('success') %}
                        <div class="page-flash page-flash-success">{{ message }}</div>
                    {% endfor %}

                    {% for message in app.flashes('error') %}
                        <div class="page-flash page-flash-error">{{ message }}</div>
                    {% endfor %}
                </div>

                {{ block('body') }}
            </div>
        {% else %}
        {% if app.user and (show_topbar is not defined or show_topbar != false) %}
            <div class="top-nav">
                <div class="profile-wrapper">
                    <a href="{{ path('app_users_edit', {'id': app.user.id}) }}" class="profile-box">
                        {% if app.user.profilePic %}
                            <img src="{{ asset(app.user.profilePic) }}" class="profile-img" alt="{{ app.user.firstName }} {{ app.user.lastName }}">
                        {% else %}
                            <div class="profile-placeholder">
                                {{ app.user.firstName|first }}{{ app.user.lastName|first }}
                            </div>
                        {% endif %}

                        <div>
                            <div class="profile-name">
                                {{ app.user.firstName }} {{ app.user.lastName }}
                            </div>
                            <small class="profile-role">
                                {{ app.user.role ? app.user.role.name : 'User' }}
                            </small>
                        </div>
                    </a>

                    <a href="{{ path('app_logout') }}" class="logout-btn">
                        Logout
                    </a>
                </div>
            </div>
        {% endif %}

        <div class="page-flashes">
            {% for message in app.flashes('success') %}
                <div class="page-flash page-flash-success">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="page-flash page-flash-error">{{ message }}</div>
            {% endfor %}
        </div>

        {{ block('body') }}
        {% endif %}
    </main>
</div>
{% block workspace_eyebrow %}Connected View{% endblock %}
{% block workspace_title %}Hirely Workspace{% endblock %}
{% block workspace_subtitle %}Track your hiring flow with a cleaner navigation experience.{% endblock %}
{% block javascripts %}{% endblock %}
</body>
</html>
