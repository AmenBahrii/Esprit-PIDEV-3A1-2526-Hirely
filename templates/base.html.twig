<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">

    <style>
.btn {
    padding: 7px 14px;
    border-radius: 10px;
    font-size: 13px;
    border: none;
    cursor: pointer;
    transition: 0.2s;
}
html, body {
    height: 100%;
    margin: 0;
    padding: 0;
}

/* EDIT */
.btn-edit {
    background: #e9ecf5;
    color: #5a5f7a;
}

.btn-edit:hover {
    background: #dcdff0;
}
.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 23px;
    margin-bottom: 30px;
}

.logo-img {
    width: 40px;
    height: 40px;
    object-fit: cover;      /* important */
    transform: scale(1.8);
}

.sidebar a {
    display: flex;
    align-items: center;
    padding: 12px 14px;
    position: fixed
    margin-bottom: 8px;
    border-radius: 10px;
    font-size: 14px;
    color: #ddd;
    transition: 0.2s;
}

.sidebar a:hover {
    background: rgba(255,255,255,0.15);
    transform: translateX(3px);
}

.sidebar a.active {
    background: rgba(255,255,255,0.25);
    font-weight: bold;
}

.sidebar {
    width: 250px;
    background: linear-gradient(180deg, #3b0a57, #5e1b7b);
    padding: 25px;
}
/* TASKS */
.btn-tasks {
    background: #ff6b35;
    color: white;
}

.btn-tasks:hover {
    background: #e85c2a;
}

/* DELETE */
.btn-delete {
    background: #ffe3e3;
    color: #ff4d4d;
}

.btn-delete:hover {
    background: #ffc9c9;
}

        .status {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.status-accepted {
    background: #e6f9f0;
    color: #00a86b;
}

.status-pending {
    background: #fff4e6;
    color: #ff8c00;
}

.status-rejected {
    background: #ffe6e6;
    color: #ff4d4d;
}
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f6fa;
        }

        .container {
            display: flex;
        }

        /* SIDEBAR */
        .sidebar {
            width: 240px;
            background: linear-gradient(180deg, #3b0a57, #5e1b7b);
            color: white;
            height: 100vh;
            padding: 20px;
        }

        .sidebar h2 {
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: #ddd;
            padding: 10px;
            margin-bottom: 10px;
            text-decoration: none;
            border-radius: 8px;
        }

        .sidebar a.active,
        .sidebar a:hover {
            background: rgba(255,255,255,0.2);
            color: white;
        }

        /* MAIN */
        .main {
            flex: 1;
            padding: 30px;
            overflow-y: auto;     /* ONLY this scrolls */
    padding: 30px;
        }

        .header {
            font-size: 24px;
            font-weight: bold;
        }

        .sub-header {
            color: gray;
            margin-bottom: 20px;
        }

        .card {
    background: white;
    padding: 25px;
    border-radius: 16px;
    box-shadow: 0 6px 25px rgba(0,0,0,0.06);
}

        /* TABLE */
        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 10px;
        }

        th {
            text-align: left;
            color: gray;
            font-size: 14px;
        }

        td {
    background: #f9f9fc;
    padding: 20px;
    font-size: 14px;
}
tbody tr:hover td {
    background: #f1f3ff;
}

        tr td:first-child {
            border-left: 1px solid #eee;
            border-radius: 10px 0 0 10px;
        }

        tr td:last-child {
            border-right: 1px solid #eee;
            border-radius: 0 10px 10px 0;
        }

        /* BUTTONS */
        .btn {
            padding: 8px 14px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            text-decoration: none;
            font-size: 14px;
        }

        .btn-primary {
    background: #ff6b35;
    color: white;
    padding: 19px 18px;
    border-radius: 12px;
    font-weight: 600;
}

        .btn-secondary {
            background: #eaeaf3;
        }

        .btn-danger {
            background: #ffd6d6;
            color: red;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
             align-items: center;
        }
        .top-bar h3 {
    margin: 0;
}
.sidebar a.active {
    background: rgba(255,255,255,0.2);
    color: white;
    font-weight: bold;
}
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full {
    grid-column: span 2;
}

.form-input {
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #ddd;
    margin-top: 5px;
}
.top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.profile-box {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    background: white;
    padding: 8px 14px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: 0.2s;
}

.profile-box:hover {
    transform: translateY(-2px);
}

.profile-img {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    object-fit: cover;
}

.profile-placeholder {
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: #ff6b35;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
}

.profile-name {
    font-size: 14px;
    font-weight: 600;
    color: #333;
}
.card {
    padding: 25px;
    margin-top: 20px;
}
.form-input:focus {
    outline: none;
    border-color: #ff6b35;
    box-shadow: 0 0 0 2px rgba(255,107,53,0.2);
}.profile-wrapper {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
}

.logout-btn {
    font-size: 12px;
    color: #ff4d4d;
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
    transition: 0.2s;
}

.logout-btn:hover {
    background: #ffe6e6;
}
.profile-role {
    color: gray;
    font-size: 12px;
}
.login-container {
    min-height: 100vh;   /* safer than height */
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #3b0a57, #6a1b9a);
}

.login-card {
    background: white;
    padding: 40px;
    border-radius: 20px;
    width: 360px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.2);
}

.login-header {
    text-align: center;
    margin-bottom: 25px;
}

.login-header h2 {
    margin: 0;
    color: #3b0a57;
}

.login-header p {
    color: gray;
    font-size: 14px;
}

.form-group {
    margin-bottom: 15px;
}

.form-input {
    width: 100%;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid #ddd;
    outline: none;
}

.form-input:focus {
    border-color: #6a1b9a;
}

.login-btn {
    width: 100%;
    margin-top: 10px;
}

.login-options {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    margin-bottom: 10px;
}

.error {
    background: #ffe6e6;
    color: red;
    padding: 10px;
    border-radius: 10px;
    margin-bottom: 15px;
}

.logged-in {
    font-size: 13px;
    margin-bottom: 10px;
}
.table-container {
    margin-top: 15px;
}

.modern-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 10px;
}

.modern-table thead th {
    text-align: left;
    padding: 10px;
    color: #777;
    font-size: 13px;
}

.modern-table tbody tr {
    background: #f8f9fc;
    border-radius: 10px;
    transition: 0.2s;
}

.modern-table tbody tr:hover {
    background: #eef1f7;
}

.modern-table td {
    padding: 14px;
}

/* ROLE BADGES */
.role-badge {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.role-admin {
    background: #ffe5e5;
    color: #ff4d4d;
}

.role-recruiter {
    background: #e6f0ff;
    color: #3366ff;
}

.role-candidate {
    background: #e6fff2;
    color: #00b894;
}

/* STATUS */
.status-pill {
    background: #e6fff2;
    color: #00b894;
    padding: 5px 10px;
    border-radius: 15px;
    font-size: 12px;
}

/* DASHBOARD TAG */
.dashboard-pill {
    background: #f1f1f1;
    padding: 5px 10px;
    border-radius: 10px;
    font-size: 12px;
}

/* ACTIONS */
.actions .btn {
    margin-right: 5px;
}

.btn-view {
    background: #eef0ff;
    color: #4c5eff;
}

.desc {
    max-width: 350px;
}
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full {
    grid-column: span 2;
}

.form-input {
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #ddd;
}
.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full {
    grid-column: span 2;
}

.form-input {
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #ddd;
}
    </style>
</head>

<body>


<div class="container">
    {% if app.user %}
    <div class="sidebar">
        <h2 class="logo">
            <img src="/images/logo.png" class="logo-img">
            Hirely
        </h2>

    <a href="#"
       class="{{ app.request.attributes.get('_route') starts with 'app_dashboard' ? 'active' : '' }}">
        🏠Home
    </a>
    {% if is_granted('ROLE_ADMIN') %}
    
    <a href="{{ path('app_users_index') }}"
       class="{{ app.request.attributes.get('_route') starts with 'app_users' ? 'active' : '' }}">
        👤 Users
    </a>
    <a href="{{ path('app_role_index') }}" class="nav-item">
        🛡️ Roles
    </a>
{% endif %}

    <a href="{{ path('app_joboffer_index') }}"
       class="{{ app.request.attributes.get('_route') starts with 'app_joboffer' ? 'active' : '' }}">
        💼Job Offers
    </a>

    <a href="{{ path('app_application_index') }}"
       class="{{ app.request.attributes.get('_route') starts with 'app_application' ? 'active' : '' }}">
        📄Applications
    </a>
    
</div>
{% endif %}
    <div class="main">

    <!-- TOP NAV -->
    <div class="top-nav">

        <div></div> {# left empty for spacing #}

        {% if app.user %}
            <a href="{{ path('app_users_edit', {'id': app.user.id}) }}" class="profile-box">

                <div class="profile-wrapper">

    <div class="profile-box">
        {% if app.user.profilePic %}
            <img src="{{ asset(app.user.profilePic) }}" class="profile-img">
        {% else %}
            <div class="profile-placeholder">
                {{ app.user.firstName|first }}{{ app.user.lastName|first }}
            </div>
        {% endif %}

        <div>
            <div class="profile-name">
                {{ app.user.firstName }} {{ app.user.lastName }}
            </div>
            <small class="profile-role">
                {{ app.user.role ? app.user.role.name : '' }}
            </small>
        </div>
    </div>

    <a href="{{ path('app_logout') }}" class="logout-btn">
        Logout
    </a>

</div>

            </a>
        {% endif %}

    </div>

    {% block body %}{% endblock %}
</div>

</div>

</body>
</html>