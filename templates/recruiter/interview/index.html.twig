{% extends 'base.html.twig' %}

{% block title %}Interviews - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>My Interviews</h1>
                <a href="{{ path('app_application_index') }}" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Schedule Interview
                </a>
            </div>

            {% if interviews is empty %}
                <div class="alert alert-info">
                    <p>You haven't scheduled any interviews yet.</p>
                </div>
            {% else %}
                <section class="workspace-toolbar mb-3">
                    <div class="workspace-toolbar-copy">
                        <span class="workspace-toolbar-label">Search and Sort</span>
                        <span class="workspace-toolbar-subtitle">Search by candidate, job offer, interview type, status, or round and reorder the visible interviews instantly.</span>
                    </div>

                    <div class="workspace-toolbar-controls">
                        <input type="search" id="interview-search" class="search-input" placeholder="Search candidates, status, or rounds">

                        <select id="interview-sort" class="sort-select">
                            <option value="date_desc">Newest first</option>
                            <option value="date_asc">Oldest first</option>
                            <option value="candidate_asc">Candidate A to Z</option>
                            <option value="candidate_desc">Candidate Z to A</option>
                            <option value="job_asc">Job title A to Z</option>
                            <option value="status_asc">Status A to Z</option>
                            <option value="round_desc">Highest round first</option>
                            <option value="round_asc">Lowest round first</option>
                        </select>
                    </div>
                </section>

                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="interview-table">
                        <thead class="table-dark">
                            <tr>
                                <th>Candidate</th>
                                <th>Job Offer</th>
                                <th>Interview Type</th>
                                <th>Scheduled Date</th>
                                <th>Status</th>
                                <th>Round</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="interview-table-body">
                            {% for interview in interviews %}
                                <tr data-search="{{
                                    ((interview.application_id.user ? interview.application_id.user.firstName ~ ' ' ~ interview.application_id.user.lastName : 'N/A') ~ ' ' ~
                                    (interview.application_id.jobOffer ? interview.application_id.jobOffer.title : 'N/A') ~ ' ' ~
                                    (interview.interview_type_id ? interview.interview_type_id.type_name : 'N/A') ~ ' ' ~
                                    interview.status ~ ' ' ~
                                    interview.interview_round)
                                |lower }}">
                                    <td>
                                        {% if interview.application_id.user %}
                                            {{ interview.application_id.user.firstName }} {{ interview.application_id.user.lastName }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if interview.application_id.jobOffer %}
                                            {{ interview.application_id.jobOffer.title }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if interview.interview_type_id %}
                                            {{ interview.interview_type_id.type_name }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>{{ interview.scheduled_date.format('M d, Y') }}</td>
                                    <td>
                                        <span class="badge 
                                            {% if interview.status == 'scheduled' %}bg-warning
                                            {% elseif interview.status == 'completed' %}bg-success
                                            {% elseif interview.status == 'cancelled' %}bg-danger
                                            {% endif %}">
                                            {{ interview.status|capitalize }}
                                        </span>
                                    </td>
                                    <td>Round {{ interview.interview_round }}</td>
                                    <td>
                                        <a href="{{ path('app_interview_show', {'interviewId': interview.interview_id}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                        <a href="{{ path('app_interview_edit', {'interviewId': interview.interview_id}) }}" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form method="POST" action="{{ path('app_interview_delete', {'interviewId': interview.interview_id}) }}" style="display: inline;">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ interview.interview_id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this interview permanently?')">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p id="interview-empty-state" class="text-muted mt-2 d-none">No interviews match your search.</p>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('interview-search');
    const sortSelect = document.getElementById('interview-sort');
    const tbody = document.getElementById('interview-table-body');
    const emptyState = document.getElementById('interview-empty-state');

    if (!searchInput || !sortSelect || !tbody || !emptyState) {
        return;
    }

    const rows = Array.from(tbody.querySelectorAll('tr'));

    function cellText(row, index) {
        return (row.cells[index]?.textContent || '').trim();
    }

    function parseDate(text) {
        const timestamp = Date.parse(text);
        return Number.isNaN(timestamp) ? 0 : timestamp;
    }

    function parseRound(text) {
        const match = text.match(/(\d+)/);
        return match ? parseInt(match[1], 10) : 0;
    }

    function compareRows(a, b, sortKey) {
        switch (sortKey) {
            case 'date_asc':
                return parseDate(cellText(a, 3)) - parseDate(cellText(b, 3));
            case 'date_desc':
                return parseDate(cellText(b, 3)) - parseDate(cellText(a, 3));
            case 'candidate_asc':
                return cellText(a, 0).localeCompare(cellText(b, 0));
            case 'candidate_desc':
                return cellText(b, 0).localeCompare(cellText(a, 0));
            case 'job_asc':
                return cellText(a, 1).localeCompare(cellText(b, 1));
            case 'status_asc':
                return cellText(a, 4).localeCompare(cellText(b, 4));
            case 'round_asc':
                return parseRound(cellText(a, 5)) - parseRound(cellText(b, 5));
            case 'round_desc':
                return parseRound(cellText(b, 5)) - parseRound(cellText(a, 5));
            default:
                return 0;
        }
    }

    function refreshRows() {
        const query = searchInput.value.trim().toLowerCase();
        const sortKey = sortSelect.value;

        const filteredRows = rows.filter(function (row) {
            const searchable = (row.dataset.search || '').toLowerCase();
            const match = query === '' || searchable.includes(query);
            row.classList.toggle('d-none', !match);
            return match;
        });

        filteredRows.sort(function (a, b) {
            return compareRows(a, b, sortKey);
        });

        filteredRows.forEach(function (row) {
            tbody.appendChild(row);
        });

        emptyState.classList.toggle('d-none', filteredRows.length > 0);
    }

    searchInput.addEventListener('input', refreshRows);
    sortSelect.addEventListener('change', refreshRows);
    refreshRows();
});
</script>
{% endblock %}
