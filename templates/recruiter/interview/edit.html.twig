{% extends 'base.html.twig' %}

{% block title %}Edit Interview - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3>Edit Interview</h3>
                </div>
                <div class="card-body">
                    <form method="POST">
                        <div class="mb-3">
                            <label for="interview_type_id" class="form-label">Interview Type</label>
                            <select name="interview_type_id" id="interview_type_id" class="form-control">
                                <option value="">-- Select Interview Type --</option>
                                {% for type in interview_types %}
                                    <option value="{{ type.getInterview_type_id() }}" 
                                        {% if interview.getInterview_type_id() and interview.getInterview_type_id().getInterview_type_id() == type.getInterview_type_id() %}selected{% endif %}>
                                        {{ type.getType_name() }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="scheduled_date" class="form-label">Scheduled Date</label>
                                    <input type="date" name="scheduled_date" id="scheduled_date" class="form-control" 
                                        value="{{ interview.getScheduled_date().format('Y-m-d') }}">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="scheduled_time" class="form-label">Scheduled Time (Optional)</label>
                                    <input type="time" name="scheduled_time" id="scheduled_time" class="form-control"
                                        {% if interview.getScheduled_time() %}value="{{ interview.getScheduled_time().format('H:i') }}"{% endif %}>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="duration_minutes" class="form-label">Duration (minutes)</label>
                                    <input type="number" name="duration_minutes" id="duration_minutes" class="form-control" 
                                        value="{{ interview.getDuration_minutes() }}" min="15">
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label">Location (Optional)</label>
                            <input type="text" name="location" id="location" class="form-control" 
                                value="{{ interview.getLocation() ?? '' }}" placeholder="e.g., Conference Room A or Virtual">
                        </div>

                        <div class="mb-3">
                            <label for="meeting_link" class="form-label">Meeting Link (Optional)</label>
                            <input type="text" name="meeting_link" id="meeting_link" class="form-control" 
                                value="{{ interview.getMeeting_link() ?? '' }}" placeholder="e.g., https://meet.google.com/...">
                        </div>

                        <div class="mb-3">
                            <label for="notes" class="form-label">Notes (Optional)</label>
                            <textarea name="notes" id="notes" class="form-control" rows="4">{{ interview.getNotes() ?? '' }}</textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Update Interview
                            </button>
                            <a href="{{ path('app_interview_show', {'interviewId': interview.getInterview_id()}) }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
