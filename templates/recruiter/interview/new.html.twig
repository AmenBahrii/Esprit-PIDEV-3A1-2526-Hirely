{% extends 'base.html.twig' %}

{% block title %}Schedule Interview - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3>Schedule Interview</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted">Application Details</h6>
                        <p>
                            <strong>Candidate:</strong> 
                            {% if application.getUser() %}
                                {{ application.getUser().getFirstName() }} {{ application.getUser().getLastName() }}
                            {% else %}
                                N/A
                            {% endif %}
                        </p>
                        <p>
                            <strong>Job Offer:</strong> 
                            {% if application.getJobOffer() %}
                                {{ application.getJobOffer().title }}
                            {% else %}
                                N/A
                            {% endif %}
                        </p>
                    </div>

                    <hr>

                    <form method="POST">
                        <div class="mb-3">
                            <label for="interview_type_id" class="form-label">Interview Type</label>
                            <select name="interview_type_id" id="interview_type_id" class="form-control" required>
                                <option value="">-- Select Interview Type --</option>
                                {% for type in interview_types %}
                                    <option value="{{ type.getInterview_type_id() }}">{{ type.getType_name() }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="scheduled_date" class="form-label">Scheduled Date</label>
                                    <input type="date" name="scheduled_date" id="scheduled_date" class="form-control" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="scheduled_time" class="form-label">Scheduled Time (Optional)</label>
                                    <input type="time" name="scheduled_time" id="scheduled_time" class="form-control">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="duration_minutes" class="form-label">Duration (minutes)</label>
                                    <input type="number" name="duration_minutes" id="duration_minutes" class="form-control" value="60" min="15" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="interview_round" class="form-label">Interview Round</label>
                                    <input type="number" name="interview_round" id="interview_round" class="form-control" value="1" min="1" required>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label">Location (Optional)</label>
                            <input type="text" name="location" id="location" class="form-control" placeholder="e.g., Conference Room A or Virtual">
                        </div>

                        <div class="mb-3">
                            <label for="meeting_link" class="form-label">Meeting Link (Optional)</label>
                            <input type="text" name="meeting_link" id="meeting_link" class="form-control" placeholder="e.g., https://meet.google.com/...">
                        </div>

                        <div class="mb-3">
                            <label for="notes" class="form-label">Notes (Optional)</label>
                            <textarea name="notes" id="notes" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Schedule Interview
                            </button>
                            <a href="{{ path('app_interview_index') }}" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
