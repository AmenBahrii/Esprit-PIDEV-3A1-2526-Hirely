{% extends 'base.html.twig' %}

{% block title %}Recruiter Review{% endblock %}

{% block body %}

<div class="header">Hirely Dashboard</div>
<div class="sub-header">Review candidate application</div>

<div class="card">
    <div class="top-bar">
        <h3>Application Review</h3>
        <a href="{{ path('app_application_index') }}" class="btn btn-secondary">Back to Applications</a>
    </div>

    <div class="data-card" style="margin-bottom: 18px;">
        <div class="data-card-header">
            <div>
                <h4 class="data-card-title">
                    {{ application.jobOffer ? application.jobOffer.title : 'Job offer no longer exists' }}
                </h4>
                <div class="data-card-subtitle">
                    Applied on {{ application.applicationDate ? application.applicationDate|date('Y-m-d') : 'N/A' }}
                </div>
            </div>

            {% if application.currentStatus == 'Accepted' %}
                <span class="status status-accepted">Accepted</span>
            {% elseif application.currentStatus == 'pending' %}
                <span class="status status-pending">Pending</span>
            {% else %}
                <span class="status status-rejected">{{ application.currentStatus }}</span>
            {% endif %}
        </div>

        <div class="data-card-body">
            <div class="data-card-field">
                <span class="data-card-label">Candidate Email</span>
                <span class="data-card-value">{{ application.email }}</span>
            </div>
            <div class="data-card-field">
                <span class="data-card-label">Phone</span>
                <span class="data-card-value">{{ application.phone }}</span>
            </div>
            <div class="data-card-field">
                <span class="data-card-label">Expected Salary</span>
                <span class="data-card-value">{{ application.expectedSalary }}</span>
            </div>
            <div class="data-card-field">
                <span class="data-card-label">Experience</span>
                <span class="data-card-value">{{ application.experienceYears }} years</span>
            </div>
            <div class="data-card-field">
                <span class="data-card-label">Availability</span>
                <span class="data-card-value">{{ application.availabilityDate ? application.availabilityDate|date('Y-m-d') : 'N/A' }}</span>
            </div>
            <div class="data-card-field">
                <span class="data-card-label">Portfolio</span>
                <span class="data-card-value">
                    <a href="{{ application.portfolioUrl }}" target="_blank" rel="noreferrer">{{ application.portfolioUrl }}</a>
                </span>
            </div>
        </div>

        <div style="margin-top: 16px;">
            <span class="data-card-label">Resume</span>
            <div class="data-card-value">
                <a href="{{ application.resumePath }}" target="_blank" rel="noreferrer">{{ application.resumePath }}</a>
            </div>
        </div>

        <div style="margin-top: 16px;">
            <span class="data-card-label">Cover Letter</span>
            <div class="data-card-value">{{ application.coverLetter }}</div>
        </div>
    </div>

    <div class="card" style="padding: 20px; margin-top: 0;">
        <div class="top-bar">
            <h3>Decision</h3>
            <div class="actions">
                {% if application.currentStatus == 'pending' %}
                    <a class="btn btn-success" href="{{ path('app_application_accept', {'applicationId': application.applicationId}) }}">
                        Accept
                    </a>
                    <a class="btn btn-danger" href="{{ path('app_application_reject', {'applicationId': application.applicationId}) }}">
                        Reject
                    </a>
                {% else %}
                    <span class="data-card-subtitle">This application has already been processed.</span>
                {% endif %}

                <form method="post"
                      action="{{ path('app_application_delete', {'applicationId': application.applicationId}) }}"
                      onsubmit="return confirm('Are you sure you want to delete this application?');"
                      style="margin: 0;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ application.applicationId) }}">
                    <button class="btn btn-danger" type="submit">Delete</button>
                </form>
            </div>
        </div>

        {{ form_start(review_form) }}
            <div class="form-grid">
                <div class="form-group">
                    <label>Score</label>
                    {{ form_widget(review_form.score) }}
                    {{ form_errors(review_form.score) }}
                </div>

                <div class="form-group full">
                    <label>Review Note</label>
                    {{ form_widget(review_form.reviewNote) }}
                    {{ form_errors(review_form.reviewNote) }}
                </div>
            </div>

            <button class="btn btn-primary">Save Review</button>
        {{ form_end(review_form) }}
    </div>
</div>

{% endblock %}
