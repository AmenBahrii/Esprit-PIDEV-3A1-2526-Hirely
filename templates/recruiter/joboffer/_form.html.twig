<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
>

<style>
    .joboffer-form {
        display: grid;
        gap: 26px;
    }

    .joboffer-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px 20px;
        align-items: start;
    }

    .joboffer-form-group {
        min-width: 0;
    }

    .joboffer-form-group.full {
        grid-column: 1 / -1;
    }

    .joboffer-form-label,
    .location-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

    .joboffer-form-label label,
    .location-label-row label {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: var(--ink);
    }

    .joboffer-form .form-input {
        width: 100%;
        min-height: 48px;
    }

    .joboffer-form textarea.form-input {
        min-height: 124px;
        resize: vertical;
        padding-top: 12px;
    }

    .joboffer-form .form-errors,
    .joboffer-form ul {
        margin: 8px 0 0;
        padding: 0;
        list-style: none;
        color: var(--red);
        font-size: 12px;
        line-height: 1.45;
    }

    .location-input-row {
        display: flex;
        align-items: stretch;
        gap: 10px;
    }

    .location-input-row .form-input {
        flex: 1;
    }

    .map-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        min-width: 48px;
        height: 48px;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
        color: var(--accent);
        box-shadow: var(--shadow-soft);
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }

    .map-trigger:hover {
        transform: translateY(-1px);
        border-color: rgba(255, 107, 53, 0.4);
        background: #fff7f3;
    }

    .map-trigger svg {
        width: 18px;
        height: 18px;
    }

    .field-hint-inline {
        margin-top: 8px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
    }

    .joboffer-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        padding-top: 4px;
    }

    .joboffer-submit {
        min-width: 180px;
    }

    .map-modal {
        position: fixed;
        inset: 0;
        z-index: 1500;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(15, 23, 42, 0.45);
    }

    .map-modal.is-open {
        display: flex;
    }

    .map-modal-card {
        width: min(100%, 860px);
        max-height: calc(100vh - 48px);
        overflow: hidden;
        border-radius: 8px;
        background: #fff;
        border: 1px solid var(--line);
        box-shadow: var(--shadow);
        display: grid;
        grid-template-rows: auto auto auto 1fr auto;
    }

    .map-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 20px 12px;
        border-bottom: 1px solid var(--line);
    }

    .map-modal-title {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
    }

    .map-close {
        border: none;
        background: transparent;
        color: var(--muted);
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
    }

    .map-search-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
        padding: 16px 20px 12px;
    }

    .map-search-results {
        display: none;
        margin: 0 20px 12px;
        padding: 0;
        list-style: none;
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow: hidden;
        background: #fff;
    }

    .map-search-results.has-results {
        display: block;
    }

    .map-search-results button {
        width: 100%;
        text-align: left;
        border: none;
        border-bottom: 1px solid var(--line);
        background: #fff;
        padding: 12px 14px;
        cursor: pointer;
        color: var(--ink);
    }

    .map-search-results li:last-child button {
        border-bottom: none;
    }

    .map-search-results button:hover {
        background: var(--soft);
    }

    .map-status {
        padding: 0 20px 12px;
        color: var(--muted);
        font-size: 13px;
        min-height: 20px;
    }

    .map-status.is-error {
        color: var(--red);
    }

    .map-picker {
        min-height: 360px;
        height: min(52vh, 460px);
        margin: 0 20px 18px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--line);
    }

    .map-modal-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 20px 20px;
        border-top: 1px solid var(--line);
    }

    .map-selection-preview {
        color: var(--muted);
        font-size: 13px;
    }

    .map-footer-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    @media (max-width: 720px) {
        .map-modal {
            padding: 14px;
        }

        .map-modal-card {
            grid-template-rows: auto auto auto 1fr auto;
        }

        .map-search-row,
        .map-modal-footer {
            grid-template-columns: 1fr;
            display: grid;
        }

        .map-picker {
            height: 46vh;
            margin-left: 14px;
            margin-right: 14px;
        }

        .map-modal-header,
        .map-status,
        .map-search-row,
        .map-search-results,
        .map-modal-footer {
            margin-left: 0;
            margin-right: 0;
            padding-left: 14px;
            padding-right: 14px;
        }
    }

    @media (max-width: 900px) {
        .joboffer-form-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .joboffer-form-group.full {
            grid-column: auto;
        }
    }
</style>

