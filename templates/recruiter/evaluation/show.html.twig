{% extends 'base.html.twig' %}

{% block title %}Evaluation Details - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3>Evaluation Details</h3>
                        <span class="badge {% if evaluation.getIs_draft() %}bg-secondary{% else %}bg-success{% endif %}">
                            {% if evaluation.getIs_draft() %}Draft{% else %}Submitted{% endif %}
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="text-muted">Candidate Information</h6>
                        <p>
                            <strong>Name:</strong> 
                            {% if evaluation.getInterview_id().getApplication_id().getUser() %}
                                {{ evaluation.getInterview_id().getApplication_id().getUser().getFirstName() }} {{ evaluation.getInterview_id().getApplication_id().getUser().getLastName() }}
                            {% else %}
                                N/A
                            {% endif %}
                        </p>
                        <p>
                            <strong>Job Offer:</strong> 
                            {% if evaluation.getInterview_id().getApplication_id().getJobOffer() %}
                                {{ evaluation.getInterview_id().getApplication_id().getJobOffer().title }}
                            {% else %}
                                N/A
                            {% endif %}
                        </p>
                    </div>

                    <div class="alert alert-info">
                        <h5 class="alert-heading">Overall Rating</h5>
                        <h3><strong>{{ evaluation.getOverall_rating() }}/5</strong></h3>
                    </div>

                    <h5>Evaluation Scores</h5>
                    <div class="mb-4 table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Criterion</th>
                                    <th>Score</th>
                                    <th>Comment</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for score in evaluation.getEvaluation_scores() %}
                                    <tr>
                                        <td>
                                            {% if score.getCriteria_id() %}
                                                {{ score.getCriteria_id().getCriteria_name() }}
                                            {% else %}
                                                N/A
                                            {% endif %}
                                        </td>
                                        <td>
                                            <strong>{{ score.getScore() }}/5</strong>
                                        </td>
                                        <td>{{ score.getComments() ?? 'No comment' }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <h6 class="text-muted">Recommendation</h6>
                        <p>
                            <span class="badge bg-info">{{ evaluation.getRecommendation()|capitalize }}</span>
                        </p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Hire Decision</h6>
                        <p>
                            <span class="badge 
                                {% if evaluation.getHire_decision() == 'hire' %}bg-success
                                {% elseif evaluation.getHire_decision() == 'no_hire' %}bg-danger
                                {% elseif evaluation.getHire_decision() == 'maybe' %}bg-warning
                                {% else %}bg-secondary
                                {% endif %}">
                                {{ evaluation.getHire_decision()|capitalize }}
                            </span>
                        </p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Strengths</h6>
                        <p>{{ evaluation.getStrengths() }}</p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Weaknesses</h6>
                        <p>{{ evaluation.getWeaknesses() }}</p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">General Comments</h6>
                        <p>{{ evaluation.getGeneral_comments() ?? 'None' }}</p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Next Steps</h6>
                        <p>{{ evaluation.getNext_steps() ?? 'None' }}</p>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Evaluated Date</h6>
                        <p>{{ evaluation.getEvaluated_at().format('F d, Y H:i') }}</p>
                    </div>

                    <hr>

                    <div class="d-flex gap-2">
                        <a href="{{ path('app_evaluation_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>

                        {% if evaluation.getIs_draft() %}
                            <a href="{{ path('app_evaluation_edit', {'evaluationId': evaluation.getEvaluation_id()}) }}" class="btn btn-warning">
                                <i class="fas fa-edit"></i> Edit
                            </a>

                            <form method="POST" action="{{ path('app_evaluation_submit', {'evaluationId': evaluation.getEvaluation_id()}) }}" style="display: inline;">
                                <button type="submit" class="btn btn-success" onclick="return confirm('Submit this evaluation? You won\'t be able to edit it after submission.')">
                                    <i class="fas fa-check"></i> Submit Evaluation
                                </button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
