{% extends 'base.html.twig' %}

{% block title %}Edit Evaluation - Hirely{% endblock %}

{% block content %}
<div class="container my-5">
    <div class="row">
        <div class="col-lg-9">
            <!-- Header Section -->
            <div class="mb-5">
                <h1 class="display-5 fw-bold text-dark mb-2">Edit Evaluation</h1>
                <p class="text-muted lead">Update your assessment and final recommendations</p>
            </div>

            <!-- Evaluation Form Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form method="POST" novalidate>
                        
                        <!-- Evaluation Criteria Section -->
                        <div class="mb-5">
                            <h6 class="fw-bold text-dark mb-4">
                                <i class="fas fa-star text-warning me-2"></i>Evaluation Criteria
                            </h6>
                            
                            {% if criteria is empty %}
                                <p class="text-muted">No evaluation criteria available.</p>
                            {% else %}
                                <div class="row g-3">
                                    {% for c in criteria %}
                                        {% set score = null %}
                                        {% for s in evaluation.evaluation_scores %}
                                            {% if s.criteria_id.criteria_id == c.criteria_id %}
                                                {% set score = s %}
                                            {% endif %}
                                        {% endfor %}
                                        <div class="col-12">
                                            <div class="criteria-box p-3" style="background: #f8f9fa; border-radius: 8px; border-left: 4px solid #ffc107;">
                                                <label class="form-label fw-bold mb-2">{{ c.criteria_name }}</label>
                                                {% if c.description %}
                                                    <p class="text-muted small mb-3">{{ c.description }}</p>
                                                {% endif %}
                                                <select name="criteria_{{ c.criteria_id }}" class="form-select form-select-sm mb-2" style="border-radius: 6px;">
                                                    <option value="">-- Select Score --</option>
                                                    <option value="10" {% if score and score.score == 10 %}selected{% endif %}>10 - Excellent</option>
                                                    <option value="9" {% if score and score.score == 9 %}selected{% endif %}>9 - Outstanding</option>
                                                    <option value="8" {% if score and score.score == 8 %}selected{% endif %}>8 - Very Good</option>
                                                    <option value="7" {% if score and score.score == 7 %}selected{% endif %}>7 - Good</option>
                                                    <option value="6" {% if score and score.score == 6 %}selected{% endif %}>6 - Above Average</option>
                                                    <option value="5" {% if score and score.score == 5 %}selected{% endif %}>5 - Average</option>
                                                    <option value="4" {% if score and score.score == 4 %}selected{% endif %}>4 - Fair</option>
                                                    <option value="3" {% if score and score.score == 3 %}selected{% endif %}>3 - Weak</option>
                                                    <option value="2" {% if score and score.score == 2 %}selected{% endif %}>2 - Poor</option>
                                                    <option value="1" {% if score and score.score == 1 %}selected{% endif %}>1 - Very Poor</option>
                                                    <option value="0" {% if score and score.score == 0 %}selected{% endif %}>0 - No Evidence</option>
                                                </select>
                                                <input type="text" name="comment_{{ c.criteria_id }}" class="form-control form-control-sm" 
                                                    placeholder="Optional comment for this criterion"
                                                    value="{{ score ? score.comments : '' }}" style="border-radius: 6px;">
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <hr class="my-5">

                        <!-- Overall Evaluation Section -->
                        <div class="mb-5">
                            <h6 class="fw-bold text-dark mb-4">
                                <i class="fas fa-check-circle text-success me-2"></i>Overall Evaluation
                            </h6>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="recommendation" class="form-label fw-bold">Recommendation</label>
                                    <select name="recommendation" id="recommendation" class="form-select form-select-lg" style="border-radius: 8px; border: 2px solid #e9ecef;">
                                        <option value="">-- Select Recommendation --</option>
                                        <option value="strong_yes" {% if evaluation.recommendation == 'strong_yes' %}selected{% endif %}>✅ Strong Yes</option>
                                        <option value="yes" {% if evaluation.recommendation == 'yes' %}selected{% endif %}>👍 Yes</option>
                                        <option value="maybe" {% if evaluation.recommendation == 'maybe' %}selected{% endif %}>🤔 Maybe</option>
                                        <option value="no" {% if evaluation.recommendation == 'no' %}selected{% endif %}>👎 No</option>
                                        <option value="strong_no" {% if evaluation.recommendation == 'strong_no' %}selected{% endif %}>❌ Strong No</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="hire_decision" class="form-label fw-bold">Hire Decision</label>
                                    <select name="hire_decision" id="hire_decision" class="form-select form-select-lg" style="border-radius: 8px; border: 2px solid #e9ecef;">
                                        <option value="">-- Select Decision --</option>
                                        <option value="hire" {% if evaluation.hire_decision == 'hire' %}selected{% endif %}>Hire</option>
                                        <option value="no_hire" {% if evaluation.hire_decision == 'no_hire' %}selected{% endif %}>No Hire</option>
                                        <option value="maybe" {% if evaluation.hire_decision == 'maybe' %}selected{% endif %}>Maybe Later</option>
                                        <option value="pending" {% if evaluation.hire_decision == 'pending' %}selected{% endif %}>Pending More Info</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Assessment Section -->
                        <div class="mb-5">
                            <h6 class="fw-bold text-dark mb-4">
                                <i class="fas fa-pen-fancy text-info me-2"></i>Assessment
                            </h6>
                            
                            <div class="mb-3">
                                <label for="strengths" class="form-label fw-bold">Strengths</label>
                                <textarea name="strengths" id="strengths" class="form-control form-control-lg" rows="3" style="border-radius: 8px; border: 1px solid #dee2e6;">{{ evaluation.strengths }}</textarea>
                            </div>

                            <div class="mb-3">
                                <label for="weaknesses" class="form-label fw-bold">Weaknesses</label>
                                <textarea name="weaknesses" id="weaknesses" class="form-control form-control-lg" rows="3" style="border-radius: 8px; border: 1px solid #dee2e6;">{{ evaluation.weaknesses }}</textarea>
                            </div>

                            <div class="mb-3">
                                <label for="general_comments" class="form-label fw-bold">General Comments</label>
                                <textarea name="general_comments" id="general_comments" class="form-control form-control-lg" rows="3" style="border-radius: 8px; border: 1px solid #dee2e6;">{{ evaluation.general_comments ?? '' }}</textarea>
                            </div>

                            <div>
                                <label for="next_steps" class="form-label fw-bold">Next Steps</label>
                                <textarea name="next_steps" id="next_steps" class="form-control form-control-lg" rows="2" style="border-radius: 8px; border: 1px solid #dee2e6;">{{ evaluation.next_steps ?? '' }}</textarea>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-3 pt-3">
                            <button type="submit" class="btn btn-lg btn-success" style="border-radius: 8px; padding: 0.75rem 2rem;">
                                <i class="fas fa-save me-2"></i>Update Evaluation
                            </button>
                            <a href="{{ path('app_evaluation_show', {'evaluationId': evaluation.evaluation_id}) }}" class="btn btn-lg btn-outline-secondary" style="border-radius: 8px; padding: 0.75rem 2rem;">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .criteria-box {
        transition: all 0.3s ease;
    }
    
    .criteria-box:hover {
        background: #ffffff !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .form-select-lg, .form-control-lg {
        font-size: 1rem;
        padding: 0.75rem 1rem;
    }
</style>
{% endblock %}
