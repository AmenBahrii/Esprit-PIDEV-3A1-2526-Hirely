{% extends 'base.html.twig' %}

{% block title %}Evaluations - Hirely{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Interview Evaluations</h1>
            </div>

            {% if evaluations is empty %}
                <div class="alert alert-info">
                    <p>No evaluations found.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Candidate</th>
                                <th>Job Offer</th>
                                <th>Overall Rating</th>
                                <th>Recommendation</th>
                                <th>Hire Decision</th>
                                <th>Status</th>
                                <th>Evaluated Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for evaluation in evaluations %}
                                <tr>
                                    <td>
                                        {% if evaluation.getInterview_id().getApplication_id().getUser() %}
                                            {{ evaluation.getInterview_id().getApplication_id().getUser().getFirstName() }} {{ evaluation.getInterview_id().getApplication_id().getUser().getLastName() }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if evaluation.getInterview_id().getApplication_id().getJobOffer() %}
                                            {{ evaluation.getInterview_id().getApplication_id().getJobOffer().title }}
                                        {% else %}
                                            N/A
                                        {% endif %}
                                    </td>
                                    <td>
                                        <strong>{{ evaluation.getOverall_rating() }}/5</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ evaluation.getRecommendation()|capitalize }}</span>
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if evaluation.getHire_decision() == 'hire' %}bg-success
                                            {% elseif evaluation.getHire_decision() == 'no_hire' %}bg-danger
                                            {% elseif evaluation.getHire_decision() == 'maybe' %}bg-warning
                                            {% else %}bg-secondary
                                            {% endif %}">
                                            {{ evaluation.getHire_decision()|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge 
                                            {% if evaluation.getIs_draft() %}bg-secondary
                                            {% else %}bg-success
                                            {% endif %}">
                                            {% if evaluation.getIs_draft() %}Draft{% else %}Submitted{% endif %}
                                        </span>
                                    </td>
                                    <td>{{ evaluation.getEvaluated_at().format('M d, Y') }}</td>
                                    <td>
                                        <a href="{{ path('app_evaluation_show', {'evaluationId': evaluation.getEvaluation_id()}) }}" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                        {% if evaluation.getIs_draft() %}
                                            <a href="{{ path('app_evaluation_edit', {'evaluationId': evaluation.getEvaluation_id()}) }}" class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
