{{ form_start(form, {'attr': {'class': 'module-page'}}) }}
    <div class="module-form-grid">
        <div class="module-field">
            <label>First name</label>
            {{ form_widget(form.firstName, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.firstName) }}
        </div>

        <div class="module-field">
            <label>Last name</label>
            {{ form_widget(form.lastName, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.lastName) }}
        </div>

        <div class="module-field full">
            <label>Email</label>
            {{ form_widget(form.email, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="module-field full">
            <label>Password</label>
            {{ form_widget(form.plainPassword, {'attr': {'class': 'form-input', 'placeholder': 'Leave blank to keep the current password'}}) }}
            {{ form_errors(form.plainPassword) }}
        </div>

        <div class="module-field full">
            <label>Profile picture</label>
            {{ form_widget(form.profilePic, {'attr': {'class': 'form-input'}}) }}
            {{ form_errors(form.profilePic) }}
        </div>

        {% if form.role is defined %}
            <div class="module-field">
                <label>Role</label>
                {{ form_widget(form.role, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.role) }}
            </div>
        {% endif %}

        {% if form.status is defined %}
            <div class="module-field">
                <label>Status</label>
                {{ form_widget(form.status, {'attr': {'class': 'form-input'}}) }}
                {{ form_errors(form.status) }}
            </div>
        {% endif %}
    </div>

    <div class="inline-actions">
        <button type="submit" class="btn-primary topbar-logout-link">{{ button_label|default('Save user') }}</button>
    </div>
{{ form_end(form) }}
