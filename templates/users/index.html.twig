{% extends 'admin/base_admin.html.twig' %}

{% set force_sidebar = true %}
{% set topbar_title = 'Users Workspace' %}
{% set topbar_subtitle = 'Accounts, roles, and access overview' %}

{% block title %}Users{% endblock %}

{% block admin_content %}
    <section class="module-page">
        <div class="module-hero">
            <div class="module-hero-copy">
                <span class="module-eyebrow">User Module</span>
                <h1 class="module-title">Manage platform accounts</h1>
                <p class="module-subtitle">{{ ai_user_summary }}</p>
            </div>

            <div class="module-actions">
                <a href="{{ path('app_admin_users_new') }}" class="btn-primary topbar-logout-link">Add user</a>
            </div>
        </div>

        <div class="module-stats">
            <article class="module-stat">
                <span class="module-stat-label">Total users</span>
                <div class="module-stat-value">{{ users|length }}</div>
            </article>
            <article class="module-stat">
                <span class="module-stat-label">Google linked</span>
                <div class="module-stat-value">{{ google_linked_users }}</div>
            </article>
            <article class="module-stat">
                <span class="module-stat-label">Face ID enabled</span>
                <div class="module-stat-value">{{ face_enabled_users }}</div>
            </article>
            <article class="module-stat">
                <span class="module-stat-label">Active users</span>
                <div class="module-stat-value">{{ active_users }}</div>
            </article>
            <article class="module-stat">
                <span class="module-stat-label">Profile photos</span>
                <div class="module-stat-value">{{ profile_image_users }}</div>
            </article>
        </div>

        <div class="search-form-panel">
            <div class="module-card-actions" style="justify-content: space-between; align-items: end;">
                <div class="module-section-copy" style="gap: 6px;">
                    <span class="module-eyebrow">Search and Filter</span>
                    <p class="module-section-text">Find accounts quickly by name, email, role, or status without leaving the users workspace.</p>
                </div>
                <div class="inline-actions" style="width: min(100%, 860px);">
                    <input
                        type="text"
                        id="users-search"
                        class="search-input"
                        placeholder="Search user name or email"
                    >
                    <select id="users-role-filter" class="search-select">
                        <option value="">All roles</option>
                        <option value="admin">Admin</option>
                        <option value="recruiter">Recruiter</option>
                        <option value="candidate">Candidate</option>
                    </select>
                    <select id="users-status-filter" class="search-select">
                        <option value="">All statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="module-grid" id="users-grid">
            {% for user in users %}
                <article class="module-card"
                         data-user-card
                         data-search="{{ (user.firstName ~ ' ' ~ user.lastName ~ ' ' ~ user.email)|lower }}"
                         data-role="{{ user.role ? user.role.name|lower : '' }}"
                         data-status="{{ (user.status ?? 'inactive')|lower }}">
                    <div class="module-card-header">
                        <div>
                            <span class="module-eyebrow">User #{{ user.id }}</span>
                            <h2 class="module-card-title">{{ user.firstName }} {{ user.lastName }}</h2>
                        </div>
                        <span class="status-badge {{ (user.status ?? 'inactive')|lower }}">{{ (user.status ?? 'inactive')|title }}</span>
                    </div>

                    <p class="module-card-description">{{ user.email }}</p>

                    <div class="module-card-meta">
                        <div class="module-meta-item">
                            <span class="module-meta-label">Role</span>
                            <span class="module-meta-value">{{ user.role ? user.role.name|title : 'Unassigned' }}</span>
                        </div>
                        <div class="module-meta-item">
                            <span class="module-meta-label">Profile</span>
                            <span class="module-meta-value">{{ user.profilePic ? 'Linked image' : 'No image' }}</span>
                        </div>
                    </div>

                    <div class="module-card-actions">
                        <a href="{{ path('app_admin_users_show', {'id': user.id}) }}" class="btn-secondary topbar-logout-link">Open</a>
                        <a href="{{ path('app_admin_users_edit', {'id': user.id}) }}" class="btn-primary topbar-logout-link">Edit</a>
                        {% include 'users/_delete_form.html.twig' with {user: user} %}
                    </div>
                </article>
            {% else %}
                <div class="empty-state">No users found yet.</div>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const searchInput = document.getElementById('users-search');
            const roleFilter = document.getElementById('users-role-filter');
            const statusFilter = document.getElementById('users-status-filter');
            const grid = document.getElementById('users-grid');

            if (!searchInput || !roleFilter || !statusFilter || !grid) {
                return;
            }

            const cards = Array.from(grid.querySelectorAll('[data-user-card]'));

            const refresh = () => {
                const query = searchInput.value.trim().toLowerCase();
                const role = roleFilter.value.trim().toLowerCase();
                const status = statusFilter.value.trim().toLowerCase();

                cards.forEach((card) => {
                    const matchesSearch = String(card.dataset.search || '').includes(query);
                    const matchesRole = role === '' || String(card.dataset.role || '') === role;
                    const matchesStatus = status === '' || String(card.dataset.status || '') === status;

                    card.style.display = matchesSearch && matchesRole && matchesStatus ? '' : 'none';
                });
            };

            searchInput.addEventListener('input', refresh);
            roleFilter.addEventListener('change', refresh);
            statusFilter.addEventListener('change', refresh);
        })();
    </script>
{% endblock %}
