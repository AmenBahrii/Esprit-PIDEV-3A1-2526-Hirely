{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}
{% block workspace_title %}Admin Dashboard{% endblock %}
{% block workspace_subtitle %}Recruitment and onboarding workspace{% endblock %}

{% block content %}
<section class="workspace-page">
    <section class="workspace-hero">
        <div class="workspace-hero-copy">
            <p class="workspace-kicker">Admin</p>
            <h2 class="workspace-section-title">Users control center</h2>
            <p class="workspace-section-copy">Manage access, review account health, and keep the team workspace organized.</p>
        </div>

        <div class="workspace-metric-grid" style="max-width: 520px; width: 100%;">
            <div class="workspace-meta">
                <span class="workspace-meta-label">Current Role</span>
                <span class="workspace-meta-value">Admin</span>
            </div>
            <div class="workspace-meta">
                <span class="workspace-meta-label">Focus</span>
                <span class="workspace-meta-value">Platform user management</span>
            </div>
        </div>
    </section>

    <section class="admin-metrics">
        <article class="admin-metric-card">
            <div class="admin-metric-label">Users</div>
            <div class="admin-metric-value">{{ total_users }}</div>
        </article>
        <article class="admin-metric-card">
            <div class="admin-metric-label">Google Linked</div>
            <div class="admin-metric-value">{{ google_linked_users }}</div>
        </article>
        <article class="admin-metric-card">
            <div class="admin-metric-label">Face ID Enabled</div>
            <div class="admin-metric-value">{{ face_enabled_users }}</div>
        </article>
        <article class="admin-metric-card">
            <div class="admin-metric-label">Active Users</div>
            <div class="admin-metric-value">{{ active_users }}</div>
        </article>
    </section>

    <section class="workspace-card">
        <div class="workspace-card-head">
            <div>
                <span class="workspace-kicker">AI Summary</span>
                <h3 class="data-card-title">Workspace snapshot</h3>
            </div>
        </div>
        <p class="workspace-card-summary" style="margin-top: 0;">{{ ai_user_summary }}</p>
    </section>

    <section class="workspace-toolbar">
        <div class="workspace-toolbar-copy">
            <span class="workspace-toolbar-label">Filter Users</span>
            <span class="workspace-toolbar-subtitle">Search by name or email, then narrow the view by role and status. Showing the first {{ users|length }} users.</span>
        </div>

        <div class="workspace-toolbar-controls">
            <input type="text" id="userSearch" placeholder="Search user..." class="search-input">

            <select id="roleFilter" class="sort-select">
                <option value="">All roles</option>
                <option value="admin">Admin</option>
                <option value="recruiter">Recruiter</option>
                <option value="candidate">Candidate</option>
            </select>

            <select id="statusFilter" class="sort-select">
                <option value="">All status</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
            </select>

            <a href="{{ path('app_users_new') }}" class="btn btn-primary">Add user</a>
        </div>
    </section>

    <div class="workspace-page" id="userCards">
        {% for user in users %}
            <article class="workspace-card"
                     data-user-card
                     data-search="{{ (user.first_name ~ ' ' ~ user.last_name ~ ' ' ~ user.email)|lower }}"
                     data-role="{{ user.role_name|lower }}"
                     data-status="{{ user.status|lower }}">
                <div class="workspace-card-head">
                    <div class="user-cell">
                        {% if user.profile_pic %}
                            <img src="{{ asset(user.profile_pic) }}" class="avatar-small" alt="{{ user.first_name }} {{ user.last_name }}">
                        {% else %}
                            <div class="user-avatar-placeholder">
                                {{ user.first_name|first }}{{ user.last_name|first }}
                            </div>
                        {% endif %}

                        <div>
                            <span class="workspace-kicker">User</span>
                            <h3 class="data-card-title">{{ user.first_name }} {{ user.last_name }}</h3>
                            <p class="workspace-card-summary">#{{ user.id }}</p>
                        </div>
                    </div>

                    {% if user.status == 'active' %}
                        <span class="status status-accepted">Active</span>
                    {% else %}
                        <span class="status status-rejected">{{ user.status }}</span>
                    {% endif %}
                </div>

                <div class="workspace-meta-grid">
                    <div class="workspace-meta">
                        <span class="workspace-meta-label">Email</span>
                        <span class="workspace-meta-value">{{ user.email }}</span>
                    </div>
                    <div class="workspace-meta">
                        <span class="workspace-meta-label">Role</span>
                        <span class="workspace-meta-value">{{ user.role_name }}</span>
                    </div>
                </div>

                <div class="workspace-card-actions">
                    <a class="btn btn-edit" href="{{ path('app_users_edit', {'id': user.id}) }}">Edit</a>

                    <form method="post" action="{{ path('app_users_delete', {'id': user.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button class="btn btn-delete" type="submit">Delete</button>
                    </form>
                </div>
            </article>
        {% else %}
            <div class="empty-state">No users found</div>
        {% endfor %}
    </div>
</section>

<script>
const searchInput = document.getElementById('userSearch');
const roleFilter = document.getElementById('roleFilter');
const statusFilter = document.getElementById('statusFilter');
const cards = document.querySelectorAll('[data-user-card]');

function filterUsers() {
    const search = searchInput.value.toLowerCase();
    const role = roleFilter.value.toLowerCase();
    const status = statusFilter.value.toLowerCase();

    cards.forEach(card => {
        const matchSearch = card.dataset.search.includes(search);
        const matchRole = role === '' || card.dataset.role === role;
        const matchStatus = status === '' || card.dataset.status === status;

        card.style.display = matchSearch && matchRole && matchStatus ? '' : 'none';
    });
}

searchInput.addEventListener('input', filterUsers);
roleFilter.addEventListener('change', filterUsers);
statusFilter.addEventListener('change', filterUsers);
</script>
{% endblock %}
