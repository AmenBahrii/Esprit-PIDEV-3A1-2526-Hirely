{% extends "base.html.twig" %}

{% block title %}Evaluation Details - Hirely{% endblock %}

{% block content %}
    <div style="margin-bottom: 1.5rem;">
        <a href="{{ path('app_evaluations') }}" class="btn btn-secondary">← Back to Evaluations</a>
    </div>

    <h1>Evaluation Details</h1>

    <div class="card">
        <h3>Candidate & Interview Information</h3>
        <table style="margin-top: 1rem;">
            <tr>
                <td style="font-weight: 600; width: 30%;">Candidate:</td>
                <td>{{ evaluation.interview.application.candidateName }}</td>
            </tr>
            <tr>
                <td style="font-weight: 600;">Interview Date:</td>
                <td>{{ evaluation.interview.scheduleDate | date('l, F j, Y \a\t g:i A') }}</td>
            </tr>
            <tr>
                <td style="font-weight: 600;">Interview Type:</td>
                <td>{{ evaluation.interview.interviewType.name }}</td>
            </tr>
        </table>
    </div>

    <div class="card">
        <h3>Evaluation Scores</h3>
        <table style="margin-top: 1rem;">
            <thead>
                <tr>
                    <th>Criteria</th>
                    <th>Score</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody>
                {% for score in evaluation.scores %}
                    <tr>
                        <td>{{ score.criteria.name }}</td>
                        <td style="font-weight: 600;">{{ score.score }}/10</td>
                        <td>{{ score.comment | default('—') }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p style="margin-top: 1rem; font-size: 1.1rem;">
            <strong>Overall Rating:</strong> {{ evaluation.overallRating | round(2) }}/10
        </p>
    </div>

    <div class="card">
        <h3>Recommendation & Decision</h3>
        <table style="margin-top: 1rem;">
            <tr>
                <td style="font-weight: 600; width: 30%;">Recommendation:</td>
                <td>{{ evaluation.recommendation | capitalize | replace({'_': ' '}) }}</td>
            </tr>
            <tr>
                <td style="font-weight: 600;">Hire Decision:</td>
                <td>{{ evaluation.hire_decision | capitalize | replace({'_': ' '}) }}</td>
            </tr>
        </table>
    </div>

    <div class="card">
        <h3>Detailed Comments</h3>
        <div style="margin-top: 1rem;">
            <h4 style="margin-bottom: 0.5rem;">Strengths</h4>
            <p style="background: #f8f9fa; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">{{ evaluation.strengths | nl2br }}</p>
            
            <h4 style="margin-bottom: 0.5rem;">Weaknesses</h4>
            <p style="background: #f8f9fa; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">{{ evaluation.weaknesses | nl2br }}</p>
            
            <h4 style="margin-bottom: 0.5rem;">General Comments</h4>
            <p style="background: #f8f9fa; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">{{ evaluation.comments | nl2br }}</p>
            
            <h4 style="margin-bottom: 0.5rem;">Next Steps</h4>
            <p style="background: #f8f9fa; padding: 1rem; border-radius: 4px;">{{ evaluation.nextSteps | nl2br }}</p>
        </div>
    </div>

    <div class="card">
        <p style="color: #7f8c8d; font-size: 0.9rem;">
            Created: {{ evaluation.createdAt | date('M d, Y H:i') }}
            {% if evaluation.updatedAt %}
                | Updated: {{ evaluation.updatedAt | date('M d, Y H:i') }}
            {% endif %}
        </p>
    </div>
{% endblock %}
