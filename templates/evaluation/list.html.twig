{% extends "base.html.twig" %}

{% block title %}Evaluations - Hirely{% endblock %}

{% block content %}
    <h1>Evaluations</h1>

    <div class="card">
        <div style="margin-bottom: 1.5rem;">
            <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Back to Dashboard</a>
            <a href="{{ path('app_interviews') }}" class="btn" style="background-color: #27ae60;">Create Evaluation</a>
        </div>

        {% if evaluations %}
            <table>
                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Interview Date</th>
                        <th>Overall Rating</th>
                        <th>Recommendation</th>
                        <th>Hire Decision</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for evaluation in evaluations %}
                        <tr>
                            <td>{{ evaluation.candidate_name }}</td>
                            <td>{{ evaluation.schedule_date | date('M d, Y') }}</td>
                            <td>{{ evaluation.overall_rating | default('N/A') }}</td>
                            <td>{{ evaluation.recommendation | capitalize | replace({'_': ' '}) }}</td>
                            <td>{{ evaluation.hire_decision | capitalize | replace({'_': ' '}) }}</td>
                            <td>
                                <a href="{{ path('app_evaluation_show', {id: evaluation.id}) }}" class="btn" style="padding: 0.5rem 1rem; font-size: 0.9rem;">View</a>
                                <a href="{{ path('app_evaluation_edit', {id: evaluation.id}) }}" class="btn" style="padding: 0.5rem 1rem; font-size: 0.9rem; background-color: #3498db;">Edit</a>
                                <form method="POST" action="{{ path('app_evaluation_delete', {id: evaluation.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this evaluation?');">
                                    <button type="submit" class="btn" style="padding: 0.5rem 1rem; font-size: 0.9rem; background-color: #e74c3c;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p style="color: #7f8c8d;">No evaluations found.</p>
        {% endif %}
    </div>
{% endblock %}
