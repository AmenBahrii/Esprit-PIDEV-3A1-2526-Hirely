{% extends "base.html.twig" %}

{% block title %}Evaluations - Hirely{% endblock %}

{% block content %}
    <h1>Evaluations</h1>

    <div class="card">
        <div style="margin-bottom: 1.5rem; display: flex; gap: 1rem;">
            <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">← Back to Dashboard</a>
            <a href="{{ path('app_interviews') }}" class="btn" style="background: linear-gradient(135deg, #ff9500 0%, #e68a00 100%); box-shadow: 0 2px 8px rgba(255, 149, 0, 0.2);">+ Create Evaluation</a>
        </div>

        {% if evaluations %}
            <table>
                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Interview Date</th>
                        <th>Overall Rating</th>
                        <th>Recommendation</th>
                        <th>Hire Decision</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for evaluation in evaluations %}
                        <tr>
                            <td>{{ evaluation.candidate_name }}</td>
                            <td>{{ evaluation.schedule_date | date('M d, Y') }}</td>
                            <td><span style="display: inline-block; padding: 0.3rem 0.8rem; background: #fff3e0; color: #e65100; border-radius: 6px; font-weight: 600; font-size: 0.85rem;">{{ evaluation.overall_rating | default('N/A') }}/10</span></td>
                            <td>{{ evaluation.recommendation | capitalize | replace({'_': ' '}) }}</td>
                            <td>
                                <span style="display: inline-block; padding: 0.4rem 0.9rem; border-radius: 6px; font-size: 0.8rem; font-weight: 600;
                                    {% if evaluation.hire_decision == 'hire' %}background: #e8f5e9; color: #2e7d32;
                                    {% elseif evaluation.hire_decision == 'no_hire' %}background: #ffebee; color: #c62828;
                                    {% else %}background: #f3e5f5; color: #6a1b9a;
                                    {% endif %}">
                                    {{ evaluation.hire_decision | capitalize | replace({'_': ' '}) }}
                                </span>
                            </td>
                            <td style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
                                <a href="{{ path('app_evaluation_show', {id: evaluation.id}) }}" class="btn" style="padding: 0.5rem 1rem; font-size: 0.85rem; background: #ecf0f1; color: #2c3e50; box-shadow: none;">View</a>
                                <a href="{{ path('app_evaluation_edit', {id: evaluation.id}) }}" class="btn" style="padding: 0.5rem 1rem; font-size: 0.85rem; background: #3498db;">Edit</a>
                                <form method="POST" action="{{ path('app_evaluation_delete', {id: evaluation.id}) }}" style="display: inline; margin: 0;" onsubmit="return confirm('Are you sure you want to delete this evaluation?');">
                                    <button type="submit" class="btn" style="padding: 0.5rem 1rem; font-size: 0.85rem; background: #e74c3c;">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p style="color: #7f8c8d;">No evaluations found.</p>
        {% endif %}
    </div>
{% endblock %}
