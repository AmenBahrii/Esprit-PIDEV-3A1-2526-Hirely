{% extends "base.html.twig" %}

{% block title %}Application - {{ application.candidate_name }} - Hirely{% endblock %}

{% block content %}
    <h1>{{ application.candidate_name }}</h1>

    <div class="card">
        <div style="margin-bottom: 2rem;">
            <a href="{{ path('app_applications') }}" class="btn btn-secondary">Back to Applications</a>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
            <div>
                <h3 style="color: #2c3e50; margin-bottom: 1rem;">Application Details</h3>
                <div style="background: #f9f9f9; padding: 1rem; border-radius: 4px;">
                    <p style="margin-bottom: 0.75rem;">
                        <strong>Candidate Name:</strong><br>
                        {{ application.candidate_name }}
                    </p>
                    <p style="margin-bottom: 0.75rem;">
                        <strong>Job ID:</strong><br>
                        {{ application.job_id | default('Not specified') }}
                    </p>
                    <p style="margin-bottom: 0.75rem;">
                        <strong>Status:</strong><br>
                        <span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 4px; 
                            {% if application.status == 'applied' %}background-color: #3498db; color: white;
                            {% elseif application.status == 'in_progress' %}background-color: #f39c12; color: white;
                            {% elseif application.status == 'completed' %}background-color: #27ae60; color: white;
                            {% elseif application.status == 'rejected' %}background-color: #e74c3c; color: white;
                            {% elseif application.status == 'accepted' %}background-color: #27ae60; color: white;
                            {% else %}background-color: #95a5a6; color: white;
                            {% endif %}">
                            {{ application.status | capitalize | replace({'_': ' '}) }}
                        </span>
                    </p>
                    <p style="margin-bottom: 0;">
                        <strong>Applied Date:</strong><br>
                        {{ application.created_at | date('M d, Y g:i A') if application.created_at else 'N/A' }}
                    </p>
                </div>

                <div style="margin-top: 1.5rem;">
                    <a href="{{ path('app_application_edit', {id: application.id}) }}" class="btn" style="background-color: #3498db; margin-right: 0.5rem;">Edit</a>
                    <form method="POST" action="{{ path('app_application_delete', {id: application.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure?');">
                        <button type="submit" class="btn" style="background-color: #e74c3c;">Delete</button>
                    </form>
                </div>
            </div>

            <div>
                <h3 style="color: #2c3e50; margin-bottom: 1rem;">Related Interviews</h3>
                {% if interviews %}
                    <div style="background: #f9f9f9; padding: 1rem; border-radius: 4px;">
                        {% for interview in interviews %}
                            <div style="padding: 0.75rem; border-bottom: 1px solid #e0e0e0;">
                                <p style="margin-bottom: 0.5rem;">
                                    <strong>{{ interview.interview_type_name | default('Interview') }}</strong>
                                    <span style="float: right; padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.85rem;
                                        {% if interview.status == 'scheduled' %}background-color: #3498db; color: white;
                                        {% elseif interview.status == 'completed' %}background-color: #27ae60; color: white;
                                        {% elseif interview.status == 'cancelled' %}background-color: #e74c3c; color: white;
                                        {% else %}background-color: #95a5a6; color: white;
                                        {% endif %}">
                                        {{ interview.status | capitalize }}
                                    </span>
                                </p>
                                <p style="margin-bottom: 0.25rem; color: #555; font-size: 0.9rem;">
                                    Date: {{ interview.schedule_date | date('M d, Y g:i A') }}
                                </p>
                                <p style="margin-bottom: 0; color: #555; font-size: 0.9rem;">
                                    Format: {{ interview.format | capitalize }}
                                </p>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <p style="color: #7f8c8d; background: #f9f9f9; padding: 1rem; border-radius: 4px;">No interviews scheduled yet.</p>
                {% endif %}
            </div>
        </div>
    </div>
