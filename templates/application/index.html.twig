{% extends 'admin/base_admin.html.twig' %}

{% set force_sidebar = false %}
{% set topbar_title = 'Applications' %}
{% set topbar_subtitle = 'Candidate submissions and recruiter review' %}

{% block title %}Applications{% endblock %}

{% block admin_content %}
    <section class="module-page">
        <div class="module-section-head">
            <div class="module-section-copy">
                <span class="module-eyebrow">Application Module</span>
                <h1 class="module-section-title">
                    {% if viewer_context.recruiter %}
                        Review your candidate pipeline
                    {% else %}
                        Track your applications
                    {% endif %}
                </h1>
                <p class="module-section-text">
                    {% if viewer_context.recruiter %}
                        Review incoming candidate profiles, compare submissions, and continue the hiring process.
                    {% else %}
                        Follow the progress of your submissions and open each application for full details.
                    {% endif %}
                </p>
            </div>
        </div>

        <div class="search-form-panel">
            <div class="module-card-actions" style="justify-content: space-between; align-items: end;">
                <div class="module-section-copy" style="gap: 6px;">
                    <span class="module-eyebrow">Search and Sort</span>
                    <p class="module-section-text">Search applications by offer, applicant, phone, status, or review text and reorder them instantly.</p>
                </div>
                <div class="inline-actions" style="width: min(100%, 760px);">
                    <input
                        type="text"
                        id="workspace-application-search"
                        class="search-input"
                        placeholder="Search job, applicant email, phone, status, or review note"
                    >
                    <select id="workspace-application-sort" class="search-select">
                        <option value="date_desc">Newest first</option>
                        <option value="date_asc">Oldest first</option>
                        <option value="salary_desc">Highest expected salary</option>
                        <option value="salary_asc">Lowest expected salary</option>
                        <option value="experience_desc">Most experience</option>
                        <option value="experience_asc">Least experience</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="module-grid" id="workspace-application-grid">
            {% for application in applications %}
                <article
                    class="module-card"
                    data-application-card
                    data-search="{{ (application.jobOffer ? application.jobOffer.title : '') ~ ' ' ~ (application.email ?: '') ~ ' ' ~ (application.phone ?: '') ~ ' ' ~ (application.currentStatus ?: '') ~ ' ' ~ (application.reviewNote ?: '') }}"
                    data-date="{{ application.applicationDate ? application.applicationDate|date('Y-m-d') : '' }}"
                    data-salary="{{ application.expectedSalary ?: 0 }}"
                    data-experience="{{ application.experienceYears ?: 0 }}"
                >
                    <div class="module-card-header">
                        <div>
                            <span class="module-eyebrow">{{ application.jobOffer ? application.jobOffer.title : 'Application' }}</span>
                            <h2 class="module-card-title">{{ application.email ?: 'No applicant email' }}</h2>
                        </div>
                        <span class="status-badge {{ application.currentStatus|default('pending')|lower }}">
                            {{ application.currentStatus|default('Pending')|title }}
                        </span>
                    </div>

                    <p class="module-card-description">
                        {% if application.coverLetter %}
                            {{ application.coverLetter|length > 160 ? application.coverLetter|slice(0, 160) ~ '...' : application.coverLetter }}
                        {% else %}
                            No cover letter provided.
                        {% endif %}
                    </p>

                    <div class="module-card-meta">
                        <div class="module-meta-item">
                            <span class="module-meta-label">Phone</span>
                            <span class="module-meta-value">{{ application.phone ?: 'Not provided' }}</span>
                        </div>
                        <div class="module-meta-item">
                            <span class="module-meta-label">Experience</span>
                            <span class="module-meta-value">{{ application.experienceYears ?: 0 }} years</span>
                        </div>
                        <div class="module-meta-item">
                            <span class="module-meta-label">Expected salary</span>
                            <span class="module-meta-value">{{ application.expectedSalary ?: 'N/A' }}</span>
                        </div>
                        <div class="module-meta-item">
                            <span class="module-meta-label">AI score</span>
                            <span class="module-meta-value">
                                {{ application.score is not null ? application.score ~ '/100' : 'Not reviewed' }}
                            </span>
                        </div>
                    </div>

                    <div class="module-card-actions">
                        <a href="{{ path('app_workspace_application_show', {'id': application.id}) }}"
                           class="btn-primary topbar-logout-link">
                            Open
                        </a>

                        {% if viewer_context.recruiter and application.currentStatus|default('pending')|lower == 'pending' %}
                            <form method="post"
                                  action="{{ path('app_workspace_application_accept', {'id': application.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('application_accept_' ~ application.id) }}">
                                <button class="btn-secondary topbar-logout-link" type="submit">Accept</button>
                            </form>

                            <form method="post"
                                  action="{{ path('app_workspace_application_reject', {'id': application.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('application_reject_' ~ application.id) }}">
                                <button class="btn-secondary topbar-logout-link" type="submit">Reject</button>
                            </form>
                        {% endif %}

                        {% if viewer_context.candidate and application.currentStatus|default('pending')|lower == 'pending' %}
                            <form method="post"
                                  action="{{ path('app_workspace_application_delete', {'id': application.id}) }}"
                                  onsubmit="return confirm('Delete this application?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ application.id) }}">
                                <button class="btn-secondary topbar-logout-link" type="submit">Delete</button>
                            </form>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <div class="empty-state">No applications are visible in this workspace yet.</div>
            {% endfor %}
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (() => {
            const searchInput = document.getElementById('workspace-application-search');
            const sortSelect = document.getElementById('workspace-application-sort');
            const grid = document.getElementById('workspace-application-grid');

            if (!searchInput || !sortSelect || !grid) {
                return;
            }

            const cards = Array.from(grid.querySelectorAll('[data-application-card]'));

            const sortCards = (sortValue) => {
                const sorted = [...cards];

                sorted.sort((a, b) => {
                    if (sortValue === 'date_asc') {
                        return String(a.dataset.date).localeCompare(String(b.dataset.date));
                    }
                    if (sortValue === 'salary_desc') {
                        return Number(b.dataset.salary) - Number(a.dataset.salary);
                    }
                    if (sortValue === 'salary_asc') {
                        return Number(a.dataset.salary) - Number(b.dataset.salary);
                    }
                    if (sortValue === 'experience_desc') {
                        return Number(b.dataset.experience) - Number(a.dataset.experience);
                    }
                    if (sortValue === 'experience_asc') {
                        return Number(a.dataset.experience) - Number(b.dataset.experience);
                    }

                    return String(b.dataset.date).localeCompare(String(a.dataset.date));
                });

                sorted.forEach((card) => grid.appendChild(card));
            };

            const refresh = () => {
                const query = searchInput.value.trim().toLowerCase();

                cards.forEach((card) => {
                    const haystack = String(card.dataset.search || '').toLowerCase();
                    card.style.display = haystack.includes(query) ? '' : 'none';
                });

                sortCards(sortSelect.value);
            };

            searchInput.addEventListener('input', refresh);
            sortSelect.addEventListener('change', refresh);
        })();
    </script>
{% endblock %}
