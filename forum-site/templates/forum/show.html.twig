{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} | Hirely{% endblock %}

{% block body %}
    <section class="page-head compact">
        <a class="button ghost js-go-back" href="{{ path('forum_index') }}" data-go-back="true" data-fallback="{{ path('forum_index') }}">
            <span class="icon" aria-hidden="true">&#x2190;</span>
            <span>Go back</span>
        </a>
    </section>

    <section class="details-layout">
        <article class="details-main card">
            <div class="post-card-head">
                <div>
                    <span class="status-chip {{ post.status|lower }}">{{ post.status }}</span>
                    {% if post.pinned %}<span class="status-chip pinned">Pinned</span>{% endif %}
                    {% if post.locked %}<span class="status-chip locked">Locked</span>{% endif %}
                </div>
                {% if post.tag %}
                    <span class="tag-chip">{{ post.tag }}</span>
                {% endif %}
            </div>

            <h1>{{ post.title }}</h1>
            <p class="meta">
                <a class="text-link" href="{{ path('profile_show', {id: post.author.id}) }}">{{ post.author.displayName }}</a>
                • {{ post.createdAt|date('d M Y - H:i') }}
            </p>
            <div class="details-copy">{{ post.content|nl2br }}</div>

            {% if post.moderationNote and is_granted('ROLE_ADMIN') %}
                <div class="moderation-box">
                    <strong>Moderation note</strong>
                    <p>{{ post.moderationNote }}</p>
                </div>
            {% endif %}

            <div class="details-actions">
                <div class="like-control">
                    <form method="post" action="{{ path('forum_post_like', {id: post.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('like_post_' ~ post.id) }}">
                        <button class="heart-toggle {{ post.likedByCurrentUser ? 'liked' : '' }}" type="submit" aria-label="{{ post.likedByCurrentUser ? 'Unlike post' : 'Like post' }}">
                            <span class="heart-icon" aria-hidden="true">{{ post.likedByCurrentUser ? '♥' : '♡' }}</span>
                        </button>
                    </form>
                    <span class="social-count">{{ post.likeCount }} likes</span>
                </div>

                {% if app.user.id == post.author.id or is_granted('ROLE_ADMIN') %}
                    <a class="button ghost" href="{{ path('forum_post_edit', {id: post.id}) }}">
                        <span class="icon" aria-hidden="true">&#x270E;</span>
                        <span>Edit post</span>
                    </a>
                    <form method="post" action="{{ path('forum_post_delete', {id: post.id}) }}" onsubmit="return confirm('Delete this post?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_post_' ~ post.id) }}">
                        <button class="button danger" type="submit">
                            <span class="icon" aria-hidden="true">&#x1F5D1;</span>
                            <span>Delete</span>
                        </button>
                    </form>
                {% endif %}
            </div>
        </article>

        <aside class="comments-panel card">
            <div class="comments-head">
                <h2>Comments</h2>
                <form method="get" data-auto-submit="true">
                    <label class="field-with-icon">
                        <span class="icon" aria-hidden="true">&#x21C5;</span>
                        <select name="comments">
                            <option value="new" {{ comment_sort == 'new' ? 'selected' : '' }}>Newest</option>
                            <option value="old" {{ comment_sort == 'old' ? 'selected' : '' }}>Oldest</option>
                        </select>
                    </label>
                </form>
            </div>

            {% if not post.locked or is_granted('ROLE_ADMIN') %}
                {{ form_start(comment_form, {attr: {class: 'stack-form'}, action: path('forum_comment_new', {id: post.id})}) }}
                    {{ form_errors(comment_form) }}
                    {{ form_row(comment_form.content) }}
                    <button class="button primary" type="submit">
                        <span class="icon" aria-hidden="true">&#x2795;</span>
                        <span>Add comment</span>
                    </button>
                {{ form_end(comment_form) }}
            {% else %}
                <div class="flash flash-error">Comments are locked for this post.</div>
            {% endif %}

            <div class="comments-list">
                {% for comment in comments %}
                    <article class="comment-card">
                        <div class="comment-head">
                            <div>
                                <strong><a class="text-link" href="{{ path('profile_show', {id: comment.author.id}) }}">{{ comment.author.displayName }}</a></strong>
                                <span class="meta">{{ comment.createdAt|date('d M Y - H:i') }}</span>
                            </div>
                            <div class="comment-tags">
                                <span class="status-chip {{ comment.status|lower }}">{{ comment.status }}</span>
                                {% if comment.pinned %}<span class="status-chip pinned">Pinned</span>{% endif %}
                            </div>
                        </div>
                        <p>{{ comment.content|nl2br }}</p>

                        {% if comment.moderationNote and is_granted('ROLE_ADMIN') %}
                            <p class="meta">Admin note: {{ comment.moderationNote }}</p>
                        {% endif %}

                        <div class="comment-actions">
                            <div class="like-control compact">
                                <form method="post" action="{{ path('forum_comment_like', {id: comment.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('like_comment_' ~ comment.id) }}">
                                    <button class="heart-toggle comment-heart {{ comment.likedByCurrentUser ? 'liked' : '' }}" type="submit" aria-label="{{ comment.likedByCurrentUser ? 'Unlike comment' : 'Like comment' }}">
                                        <span class="heart-icon" aria-hidden="true">{{ comment.likedByCurrentUser ? '♥' : '♡' }}</span>
                                    </button>
                                </form>
                                <span class="social-count small">{{ comment.likeCount }}</span>
                            </div>

                            {% if app.user.id == comment.author.id or is_granted('ROLE_ADMIN') %}
                                <a class="text-link" href="{{ path('forum_comment_edit', {id: comment.id}) }}">
                                    <span class="icon" aria-hidden="true">&#x270E;</span>
                                    <span>Edit</span>
                                </a>
                                <form method="post" action="{{ path('forum_comment_delete', {id: comment.id}) }}" onsubmit="return confirm('Delete this comment?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                    <button class="text-link danger-link" type="submit">
                                        <span class="icon" aria-hidden="true">&#x1F5D1;</span>
                                        <span>Delete</span>
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </article>
                {% else %}
                    <div class="empty-state subtle">
                        <p>No comments yet.</p>
                    </div>
                {% endfor %}
            </div>
        </aside>
    </section>
{% endblock %}
